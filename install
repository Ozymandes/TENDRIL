#!/bin/sh
# TENDRIL installer — user-local, interactive, never runs sudo.
# Linux and macOS hosts; any POSIX sh (dash, bash 3.2 as macOS /bin/sh).
#   install                       host install (Herdr + agents live here)
#   install --client              operator install: `tendril` connects to a host
#   install [--client] --dry-run  preview every write, change nothing
#   install --doctor              read-only system check (no fixes)
#   install --upgrade             non-interactive refresh (what `tendril --upgrade`
#                                 runs): binaries, symlink, PATH block, watcher
#                                 unit; never touches config or notify.env

set -u
# --doctor and --dry-run are read-only: Python must not leave bytecode
# caches either (Apple's python3 writes them under ~/Library/Caches).
export PYTHONDONTWRITEBYTECODE=1

# resolve a symlinked installer without GNU `readlink -f`
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname -- "$SELF")/$LINK ;; esac
done
PKG_DIR=$(CDPATH='' cd -- "$(dirname -- "$SELF")" && pwd -P)
HOST_HELPER="$PKG_DIR/bin/tendril_host.py"
MODE=install
DRY_RUN=0
for arg in "$@"; do
    case $arg in
        --dry-run) DRY_RUN=1 ;;
        --doctor)  MODE=doctor ;;
        --client)  MODE=client ;;
        --upgrade) MODE=upgrade ;;
        -h|--help) sed -n '2,10p' "$PKG_DIR/install"; exit 0 ;;
        *) printf 'unknown option: %s (see --help)\n' "$arg" >&2; exit 2 ;;
    esac
done
OS=$(uname -s)          # messages only; behaviour follows capabilities

say() { printf '%s\n' "$*"; }
hr()  { say "------------------------------------------------------------"; }
row() { printf '%-14s %s\n' "$1" "$2"; }
ask() { printf '%s [%s] ' "$1" "$2" >&2; read -r ans; [ -n "$ans" ] && printf '%s' "$ans" || printf '%s' "$2"; }
confirm() { printf '%s [y/N] ' "$1"; read -r ans; [ "$ans" = "y" ] || [ "$ans" = "Y" ]; }
# confirm with the default on ENTER: keeps existing state (confirm() defaults to no)
confirm_keep() { printf '%s [Y/n] ' "$1"; read -r ans; case $ans in y | Y | "") return 0 ;; *) return 1 ;; esac; }
# value of KEY= in an env-style file: first match, unquoted; empty when absent
env_val() {
    [ -f "$1" ] || return 0
    _ev=$(sed -n "s/^$2=//p" "$1" | head -n 1)
    # strip matching surrounding quotes (what herdr-notify's loader strips too)
    case $_ev in
        '"'*'"') _ev=${_ev#'"'}; _ev=${_ev%'"'} ;;
        "'"*"'") _ev=${_ev#"'"}; _ev=${_ev%"'"} ;;
    esac
    printf '%s' "$_ev"
}
backup() { [ "$DRY_RUN" = "1" ] && return 0; [ -f "$1" ] && cp -p "$1" "$1.bak.$(date +%s)"; }
# single-quote for display in copy-paste instructions (spaces are common on macOS)
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# host aliases/names end up in ~/.ssh/config and argv: keep them boring
valid_name() { case $1 in "" | -* | *[!A-Za-z0-9._-]*) return 1 ;; esac; return 0; }
ask_name() {
    while :; do
        v=$(ask "$1" "$2")
        valid_name "$v" && { printf '%s' "$v"; return 0; }
        say "  use letters, digits, . _ - only (no leading -)" >&2
        [ -t 0 ] || return 1
    done
}
# the package manager actually present, for copy-paste hints only
pkg_hint() {
    if command -v brew >/dev/null 2>&1; then printf 'brew install %s' "$*"
    elif command -v pacman >/dev/null 2>&1; then printf 'sudo pacman -S %s' "$*"
    elif command -v apt-get >/dev/null 2>&1; then printf 'sudo apt install %s' "$*"
    elif command -v dnf >/dev/null 2>&1; then printf 'sudo dnf install %s' "$*"
    elif [ "$OS" = Darwin ]; then printf 'install Homebrew (https://brew.sh), then: brew install %s' "$*"
    else printf 'install with your package manager: %s' "$*"
    fi
}
act() {
    desc=$1; shift
    if [ "$DRY_RUN" = "1" ]; then
        say "  [dry-run] $desc"; say "            -> $*"; return 0
    fi
    say "  $desc"; "$@"
}

# ---------------- herdr config merge (shared: install and upgrade) -------
# plan|apply the managed detach/switch set only; unrelated lines and
# conflicts are never touched, every write is backed up first and rolled
# back when the installed client rejects the result.
herdr_detach() {
    python3 "$DETACH_HELPER" "$1" "$HERDR_CONF" "$CTRL_HOME_SUPPORTED"
}

herdr_backup_config() {
    [ "$DRY_RUN" = "1" ] && return 0
    if [ -f "$HERDR_CONF" ]; then
        backup "$HERDR_CONF"
        ls -t "$HERDR_CONF".bak.* 2>/dev/null | head -1
    fi
}

herdr_restore_config() {
    if [ -n "$1" ]; then
        cp -p "$1" "$HERDR_CONF"
    else
        rm -f "$HERDR_CONF"
    fi
}

# Workspace/tab switching: each proposal is decided on its own by the helper
# (exact chord conflicts after range expansion, then an isolated
# `herdr config check`); conflicting ones are skipped, never forced.
herdr_switch() {
    python3 "$DETACH_HELPER" switch "$1" "$HERDR_CONF" "$HERDR_BIN"
}

# ---------------- doctor (read-only) ----------------
doctor() {
    say "TENDRIL // SYSTEM CHECK"
    say ""
    row "Platform" "$OS $(uname -m)"
    if command -v python3 >/dev/null 2>&1; then
        row "Python" "OK ($(python3 -V 2>&1))"
    else
        row "Python" "MISSING"
    fi

    HERDR_CHECK=$("$PKG_DIR/bin/remote-agents" --detect 2>&1)
    HERDR_BIN=$(printf '%s\n' "$HERDR_CHECK" | sed -n 's/^chosen: //p')
    if [ -n "$HERDR_BIN" ] && [ -x "$HERDR_BIN" ]; then
        ST=$("$HERDR_BIN" status 2>/dev/null)
        VER=$(printf '%s\n' "$ST" | grep -m1 -oE 'version: *[0-9.]+' | grep -oE '[0-9.]+')
        PROTO=$(printf '%s\n' "$ST" | grep -m1 -oE 'private_protocol: *[0-9]+' | grep -oE '[0-9]+')
        RUNNING=$(printf '%s\n' "$ST" | grep -E 'status: *running' >/dev/null && echo yes || echo no)
        if [ "$RUNNING" = "yes" ]; then
            row "Herdr" "OK ${VER:-?} / protocol ${PROTO:-?} (server running)"
        else
            row "Herdr" "CLIENT OK ${VER:-?} — server not running"
        fi
    else
        row "Herdr" "NOT FOUND / INCOMPATIBLE"
        printf '%s\n' "$HERDR_CHECK" | sed 's/^/                /'
    fi

    TIP=$(python3 "$HOST_HELPER" tailscale-ip 2>/dev/null)
    if [ -n "$TIP" ]; then row "Tailscale" "ACTIVE ($TIP)"; else row "Tailscale" "DOWN / NOT INSTALLED"; fi

    command -v ssh  >/dev/null 2>&1 && row "SSH"  "OK"  || row "SSH"  "MISSING"
    if python3 "$HOST_HELPER" ssh-server >/dev/null 2>&1; then
        row "SSH server" "LISTENING (port 22)"
    else
        row "SSH server" "NOT LISTENING - $(sshd_hint)"
    fi
    command -v mosh >/dev/null 2>&1 && row "Mosh" "OK"  || row "Mosh" "MISSING (optional, recommended)"
    if python3 "$HOST_HELPER" remote-path check >/dev/null 2>&1; then
        row "Remote PATH" "OK (ssh/mosh sessions find remote-agents)"
    else
        row "Remote PATH" "INCOMPLETE - re-run ./install (step 3b)"
        python3 "$HOST_HELPER" remote-path check 2>/dev/null | sed 's/^/                /'
    fi

    for a in pi claude codex; do
        LABEL=$(printf '%s' "$a" | cut -c1 | tr 'a-z' 'A-Z')$(printf '%s' "$a" | cut -c2-)
        command -v "$a" >/dev/null 2>&1 && row "$LABEL" "AVAILABLE" || row "$LABEL" "not installed"
    done

    if [ -f "$HOME/.config/remote-agents/notify.env" ] \
       && grep -q '^NTFY_TOPIC=..*' "$HOME/.config/remote-agents/notify.env" 2>/dev/null; then
        row "Push" "ACTIVE"
    else
        row "Push" "NOT CONFIGURED"
    fi

    WATCH=$(python3 "$HOST_HELPER" service status 2>/dev/null)
    case $WATCH in
        running*) row "Watcher" "RUNNING ${WATCH#running }" ;;
        not\ installed*) row "Watcher" "NOT INSTALLED ${WATCH#not installed } - ./install step 5" ;;
        "")       row "Watcher" "NO SERVICE MANAGER (run herdr-notify by hand)" ;;
        no\ service*) row "Watcher" "NO SERVICE MANAGER (run herdr-notify by hand)" ;;
        *)        row "Watcher" "STOPPED ($WATCH)" ;;
    esac
    return 0
}

sshd_hint() {
    if [ "$OS" = Darwin ]; then
        printf 'enable System Settings > General > Sharing > Remote Login'
    else
        printf 'enable your sshd (e.g. systemctl enable --now sshd)'
    fi
}

[ "$MODE" = doctor ] && doctor && exit 0

BIN_DIR="$HOME/.local/bin"
CONF_DIR="$HOME/.config/remote-agents"
CLIENT_CONF_DIR="$HOME/.config/tendril"

# python3 must really run: on a fresh Mac /usr/bin/python3 is only a stub
# that offers to install the Command Line Tools.
python_ok() {
    [ -n "${PYTHON:-}" ] && "$PYTHON" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1
}
python_missing() {
    say "  MISSING: python3 >= 3.9 is required (the installer never installs packages)."
    if [ "$OS" = Darwin ]; then
        say "  macOS: run  xcode-select --install  (Command Line Tools ship python3),"
        say "         or:  $(pkg_hint python)"
    else
        say "  e.g.:  $(pkg_hint python3)"
    fi
    exit 1
}
path_hint() {
    case ":$PATH:" in
        *":$BIN_DIR:"*) ;;
        *) say "  note: $BIN_DIR is not on your PATH. Add to your shell profile:"
           say "        export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac
}

# ---------------- client mode: this machine operates a remote host ----------------
client_install() {
    hr; say "TENDRIL // CLIENT SETUP"; say "this machine attaches to a TENDRIL host over SSH (Mosh when available)"; hr
    [ "$DRY_RUN" = "1" ] && say "(dry-run: nothing will be written)"; say ""
    say "1) Dependency check"
    if command -v ssh >/dev/null 2>&1; then say "  ssh     : ok"; else
        say "  MISSING: ssh is required ($(pkg_hint openssh))"; exit 1; fi
    if command -v mosh >/dev/null 2>&1; then say "  mosh    : ok (preferred; SSH is the fallback)"; else
        say "  mosh    : not found - SSH only. Optional: $(pkg_hint mosh)"; fi
    say ""
    say "2) Host"
    say "  The SSH alias from ~/.ssh/config that reaches your TENDRIL host."
    CUR=""
    [ -r "$CLIENT_CONF_DIR/alias" ] && IFS= read -r CUR < "$CLIENT_CONF_DIR/alias"
    CALIAS=$(ask_name "SSH alias of the TENDRIL host" "${TENDRIL_ALIAS:-$CUR}") || {
        say "  no valid alias given"; exit 1; }
    say ""
    say "3) Install files"
    NAME=tendril
    if [ -L "$BIN_DIR/tendril" ] && [ "$(readlink "$BIN_DIR/tendril")" = "remote-agents" ]; then
        NAME=tendril-remote          # this machine is also a host: keep its console
        say "  $BIN_DIR/tendril is this machine's host console; the client is $NAME"
    elif [ -e "$BIN_DIR/tendril" ] && ! grep -q 'TENDRIL client launcher' "$BIN_DIR/tendril" 2>/dev/null; then
        NAME=tendril-remote
        say "  kept existing $BIN_DIR/tendril (not ours); the client is $NAME"
    fi
    act "create $BIN_DIR and $CLIENT_CONF_DIR" mkdir -p "$BIN_DIR" "$CLIENT_CONF_DIR" || exit 1
    if [ "$DRY_RUN" = "1" ]; then
        say "  [dry-run] install $BIN_DIR/$NAME (phone/tendril with a #!/bin/sh shebang)"
        say "  [dry-run] write $CLIENT_CONF_DIR/alias: $CALIAS"
    else
        TMP=$(mktemp "$BIN_DIR/.tendril-client.XXXXXX") || exit 1
        { printf '#!/bin/sh\n'; sed '1d' "$PKG_DIR/phone/tendril"; } > "$TMP" \
            && chmod 755 "$TMP" && mv -f "$TMP" "$BIN_DIR/$NAME" || { rm -f "$TMP"; exit 1; }
        say "  installed $BIN_DIR/$NAME"
        printf '%s\n' "$CALIAS" > "$CLIENT_CONF_DIR/alias" && chmod 600 "$CLIENT_CONF_DIR/alias"
        say "  default host: $CALIAS  ($CLIENT_CONF_DIR/alias; TENDRIL_ALIAS overrides)"
    fi
    path_hint
    say ""
    say "4) Key check"
    if [ "$DRY_RUN" = "1" ]; then
        say "  [dry-run] ssh -o BatchMode=yes $CALIAS true"
    elif ssh -o ConnectTimeout=5 -o BatchMode=yes "$CALIAS" true 2>/dev/null; then
        say "  key login to $CALIAS: ok"
    else
        say "  key login to $CALIAS failed. One-time setup:"
        say "    ssh-keygen -t ed25519            # if you have no key yet"
        say "    ssh-copy-id $CALIAS"
        say "  and make sure ~/.ssh/config has a 'Host $CALIAS' entry (docs/MACOS.md)."
    fi
    say ""
    hr
    say "Done.  $NAME                  open the TENDRIL console on $CALIAS"
    say "       $NAME attach w15       jump straight into a workspace"
    say "       $NAME <alias>          another host;  $NAME ssh <alias> skips Mosh"
    hr
    exit 0
}
[ "$MODE" = client ] && client_install

# ---------------- upgrade: the non-interactive refresh --------------------
# What `tendril --upgrade` runs after a fast-forward in the source checkout:
# reinstall the binaries and entrypoint symlink, add the PATH block only
# when missing, apply the idempotent Herdr-binding merge, refresh the
# watcher unit, and record install provenance. Never asks a question and
# never writes config or notify.env — bin/tendril_upgrade.py asserts both
# stay byte-identical across this run and aborts loudly otherwise.
upgrade_install() {
    hr; say "TENDRIL // UPGRADE (non-interactive refresh)"; hr
    PYTHON=$(command -v python3 || true)
    python_ok || python_missing
    act "create $BIN_DIR and $CONF_DIR" mkdir -p "$BIN_DIR" "$CONF_DIR" || exit 1

    say "1) Binaries"
    # is the installed watcher binary stale? decide BEFORE the copy overwrites it
    BIN_CHANGED=1
    if [ -f "$BIN_DIR/herdr-notify" ] \
       && cmp -s "$BIN_DIR/herdr-notify" "$PKG_DIR/bin/herdr-notify"; then
        BIN_CHANGED=0
    fi
    for f in remote-agents herdr-notify tendril_link.py tendril_host.py herdr-bindings.py tendril_upgrade.py; do
        [ -f "$BIN_DIR/$f" ] && backup "$BIN_DIR/$f"
        act "install $BIN_DIR/$f" install -m 755 "$PKG_DIR/bin/$f" "$BIN_DIR/$f"
    done
    if [ -e "$BIN_DIR/tendril" ] && [ ! -L "$BIN_DIR/tendril" ]; then
        say "  kept existing $BIN_DIR/tendril (not ours) - run remote-agents instead"
    else
        act "link $BIN_DIR/tendril -> remote-agents" ln -sfn remote-agents "$BIN_DIR/tendril"
    fi
    say ""

    say "2) Remote session PATH (only when missing)"
    if [ "$DRY_RUN" = "1" ]; then
        say "  [dry-run] remote-path check, then apply only when incomplete"
    elif python3 "$HOST_HELPER" remote-path check >/dev/null 2>&1; then
        say "  ok - SSH and Mosh sessions find remote-agents"
    else
        python3 "$HOST_HELPER" remote-path apply
    fi
    say ""

    say "3) Config and notifications"
    say "  untouched by design - config and notify.env must survive this run byte-identical"
    say ""

    say "4) Notification watcher"
    if [ "$DRY_RUN" = "1" ]; then
        python3 "$HOST_HELPER" service refresh --pkg "$PKG_DIR" --dry-run
    elif [ "$BIN_CHANGED" = 1 ]; then
        python3 "$HOST_HELPER" service refresh --pkg "$PKG_DIR" --python "$PYTHON" --bin-changed
    else
        python3 "$HOST_HELPER" service refresh --pkg "$PKG_DIR" --python "$PYTHON"
    fi
    say ""

    say "5) Herdr keybindings (idempotent merge; user lines untouched)"
    HERDR_CONF="$HOME/.config/herdr/config.toml"
    DETACH_HELPER="$PKG_DIR/bin/herdr-bindings.py"
    HERDR_CHECK=$("$PKG_DIR/bin/remote-agents" --detect 2>&1) || true
    HERDR_BIN=$(printf '%s\n' "$HERDR_CHECK" | sed -n 's/^chosen: //p')
    if [ -z "$HERDR_BIN" ]; then
        say "  herdr client not found - keybindings left untouched"
    else
        CTRL_HOME_SUPPORTED=0
        if python3 "$DETACH_HELPER" supports "$HERDR_BIN" ctrl+home; then
            CTRL_HOME_SUPPORTED=1
        fi
        PLAN=$(herdr_detach plan)
        ADDED=$(printf '%s\n' "$PLAN" | sed -n 's/^ADDED=//p')
        REMOVED=$(printf '%s\n' "$PLAN" | sed -n 's/^REMOVED=//p')
        if [ -n "$ADDED" ] || [ "$REMOVED" != "" ]; then
            say "  managed detach set: adds ${ADDED:-none}; removes ${REMOVED:-none}"
            if [ "$DRY_RUN" = "1" ]; then
                say "  [dry-run] apply the managed detach set, then herdr config check"
            else
                BAK=$(herdr_backup_config)
                herdr_detach apply
                if "$HERDR_BIN" config check >/dev/null 2>&1; then
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1 \
                        && say "  applied + reloaded live (no server restart)"
                else
                    say "  config check FAILED - restoring previous config"
                    herdr_restore_config "$BAK"
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1
                fi
            fi
        else
            say "  detach bindings already complete - nothing to do"
        fi
        PLAN=$(herdr_switch plan)
        ADDS=$(printf '%s\n' "$PLAN" | sed -n 's/^ADD=[^|]*|\([^|]*\)|.*/\1/p')
        if [ -n "$ADDS" ]; then
            printf '%s\n' "$ADDS" | sed 's/^/  add switching binding: /'
            if [ "$DRY_RUN" = "1" ]; then
                say "  [dry-run] append the bindings above; herdr config check; reload-config"
            else
                "$HERDR_BIN" config check >/dev/null 2>&1; BASE_RC=$?
                BAK=$(herdr_backup_config)
                if RESULT=$(herdr_switch apply) \
                   && { [ "$BASE_RC" != 0 ] || "$HERDR_BIN" config check >/dev/null 2>&1; }; then
                    printf '%s\n' "$RESULT" | sed -n 's/^ADD=[^|]*|\([^|]*\)|.*/  added    \1/p'
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1 \
                        && say "  applied + reloaded live (no server restart)"
                else
                    say "  config check FAILED - restoring previous config"
                    herdr_restore_config "$BAK"
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1
                fi
            fi
        else
            say "  switching bindings already complete - nothing to do"
        fi
    fi
    say ""

    say "6) Install provenance"
    if [ "$DRY_RUN" = "1" ]; then
        say "  [dry-run] record $CONF_DIR/install.json"
    elif "$PYTHON" "$PKG_DIR/bin/tendril_upgrade.py" record-provenance --pkg "$PKG_DIR/bin"; then
        :
    else
        say "  note: provenance not recorded (non-fatal; the file enables tendril --upgrade)"
    fi
    say ""
    hr
    say "Upgrade done. Health check:  tendril --upgrade"
    hr
    return 0
}
[ "$MODE" = upgrade ] && { upgrade_install; exit $?; }

hr; say "TENDRIL // INSTALLER"; say "a thin mobile control plane for persistent AI agents"; hr
[ "$DRY_RUN" = "1" ] && say "(dry-run: nothing will be written)"; say ""

# ---------------- 1. dependencies ----------------
say "1) Dependency check"
PYTHON=$(command -v python3 || true)
python_ok || python_missing
say "  python3 : ok ($PYTHON, $("$PYTHON" -V 2>&1))"
say "  host    : $OS $(uname -m)"
say "  herdr   : probing candidates (protocol-checked)..."
HERDR_CHECK=$("$PKG_DIR/bin/remote-agents" --detect 2>&1) || true
printf '%s\n' "$HERDR_CHECK" | sed 's/^/    /'
HERDR_BIN=$(printf '%s\n' "$HERDR_CHECK" | sed -n 's/^chosen: //p')
if [ -z "$HERDR_BIN" ]; then
    say "  MISSING: no protocol-compatible herdr client found."
    say "  Install Herdr 0.9.3 or newer for your user (Linux or macOS), e.g.:"
    say "    curl -fsSL https://herdr.dev/install.sh | sh     # -> ~/.local/bin/herdr"
    command -v brew >/dev/null 2>&1 && say "    or: brew install herdr"
    say "  then re-run this installer."
    exit 1
fi
for tool in ssh tailscale mosh; do
    if command -v "$tool" >/dev/null 2>&1 \
       || { [ "$tool" = tailscale ] && python3 "$HOST_HELPER" tailscale-ip >/dev/null 2>&1; }; then
        say "  $tool    : ok"
    else
        say "  $tool    : NOT FOUND (optional; mobile access needs ssh+mosh."
        say "            install it yourself, e.g.: $(pkg_hint "$tool"))"
    fi
done
for agent in pi claude codex; do
    command -v "$agent" >/dev/null 2>&1 \
        && say "  agent   : $agent found" \
        || say "  agent   : $agent not installed (skipped in menus)"
done
say ""

# ---------------- 2. questions ----------------
say "2) Configuration"
DEFAULT_ROOTS="$HOME/Projects:$HOME/src:$HOME/dev:$HOME/code"
ROOTS=$(ask "Project roots to scan (colon-separated)" "$DEFAULT_ROOTS")
TSHOST=$(ask_name "Tailscale hostname of this machine" "$(python3 "$HOST_HELPER" hostname)") || exit 1
ALIAS=$(ask_name "SSH alias the phone will use" "$TSHOST") || exit 1
say ""

# ---------------- 3. write config + bins ----------------
say "3) Install files"
act "create $CONF_DIR" mkdir -p "$CONF_DIR" "$BIN_DIR" || exit 1
CONFIG="$CONF_DIR/config"
if [ -f "$CONFIG" ]; then backup "$CONFIG"; say "  backed up existing config"; fi
CONF_BODY=$(printf 'TAILSCALE_HOST=%s\nSSH_ALIAS=%s\nPROJECT_ROOTS=%s\nHERDR_BIN=\nREMOTE_AGENTS_BIN=%s/%s\nNOTIFY_BIN=%s/%s\n' \
    "$TSHOST" "$ALIAS" "$ROOTS" "$BIN_DIR" remote-agents "$BIN_DIR" herdr-notify)
if [ "$DRY_RUN" = "1" ]; then
    say "  [dry-run] write $CONFIG:"; printf '      %s\n' "$CONF_BODY"
else
    printf '%s\n' "$CONF_BODY" > "$CONFIG"
    chmod 600 "$CONFIG"
fi
for f in remote-agents herdr-notify tendril_link.py tendril_host.py herdr-bindings.py tendril_upgrade.py; do
    [ -f "$BIN_DIR/$f" ] && backup "$BIN_DIR/$f"
    act "install $BIN_DIR/$f" install -m 755 "$PKG_DIR/bin/$f" "$BIN_DIR/$f"
done
# `tendril` is the official command: same program, one executable
if [ -e "$BIN_DIR/tendril" ] && [ ! -L "$BIN_DIR/tendril" ]; then
    say "  kept existing $BIN_DIR/tendril (not ours) - run remote-agents instead"
else
    act "link $BIN_DIR/tendril -> remote-agents" ln -sfn remote-agents "$BIN_DIR/tendril"
fi
path_hint
say ""

# ---------------- 3b. remote session PATH ----------------
# Phones run `remote-agents` (and Mosh runs `mosh-server`) in a
# non-interactive shell that may not read the profile that puts
# ~/.local/bin / Homebrew on PATH - the default on macOS.
say "3b) Remote session PATH (what SSH/Mosh commands can find)"
if [ "$DRY_RUN" = "1" ]; then
    say "  [dry-run] python3 $HOST_HELPER remote-path check (after install)"
elif python3 "$HOST_HELPER" remote-path check >/dev/null 2>&1; then
    say "  ok - SSH and Mosh sessions find remote-agents"
else
    python3 "$HOST_HELPER" remote-path check | sed 's/^/  /'
    say "  A small managed block (marked '# >>> tendril remote PATH') prepends"
    say "  ~/.local/bin and Homebrew's bin to PATH; the files are backed up first:"
    python3 "$HOST_HELPER" remote-path plan | sed 's/^ *\[dry-run\] /    /'
    if confirm "Add the managed PATH block?"; then
        python3 "$HOST_HELPER" remote-path apply
    else
        say "  skipped - phones can set REMOTE_AGENTS_BIN=$BIN_DIR/remote-agents instead"
    fi
fi
say ""

# ---------------- 4. notifications (optional) ----------------
# An existing configuration (non-empty NTFY_TOPIC) is PRESERVED by default:
# a plain `git pull && ./install` update must never rotate the topic or
# invalidate subscribed phones. Rotation is always explicit and separately
# confirmed. notify.env is left byte-for-byte untouched unless the user
# chooses a new topic (or the file has no usable topic at all).
say "4) Push notifications (ntfy -> Android / iPhone), optional"
NOTIFY="$CONF_DIR/notify.env"
CUR_URL=$(env_val "$NOTIFY" NTFY_URL)
CUR_TOKEN=$(env_val "$NOTIFY" NTFY_TOKEN)
CUR_TOPIC=$(env_val "$NOTIFY" NTFY_TOPIC)
new_topic() { python3 -c 'import secrets; print("tendril-" + secrets.token_urlsafe(12))'; }
write_notify() {  # $1: topic; carries over any existing NTFY_URL / NTFY_TOKEN
    if [ "$DRY_RUN" = "1" ]; then
        say "  [dry-run] write $NOTIFY (chmod 600) with NTFY_URL/NTFY_TOPIC"
    else
        backup "$NOTIFY"
        umask 177
        printf 'NTFY_URL=%s\nNTFY_TOPIC=%s\nNTFY_TOKEN=%s\n' \
            "${CUR_URL:-https://ntfy.sh}" "$1" "$CUR_TOKEN" > "$NOTIFY"
        chmod 600 "$NOTIFY"
        umask 022
    fi
}
show_subscribe() {
    say ""
    say "  Your private topic name:  $1"
    say "  On Android: install the ntfy app -> Subscribe to topic -> enter exactly:"
    say "      $1"
    say "  (a random topic is obscurity, not access control - see docs/SECURITY.md)"
}
restart_watcher_if_running() {
    # the watcher reads notify.env once at startup, so only a CHANGED config
    # can require a restart; keeping the file never touches the service
    [ "$DRY_RUN" = "1" ] && return 0
    WSTAT=$(python3 "$HOST_HELPER" service status 2>/dev/null)
    case $WSTAT in
        running*)
            if python3 "$HOST_HELPER" service restart >/dev/null 2>&1; then
                say "  watcher restarted (now pushing to the new topic)"
            else
                say "  note: run 'tendril service restart' to pick up the new topic"
            fi ;;
    esac
}
if [ -n "$CUR_TOPIC" ]; then
    say ""
    say "  Existing ntfy configuration found:"
    say "    topic: $CUR_TOPIC"
    if confirm_keep "Keep existing notification configuration?"; then
        say "  kept - notify.env unchanged; subscribed phones keep working"
    elif confirm "Rotate notification topic? Existing subscribers will need to resubscribe."; then
        TOPIC=$(new_topic)
        write_notify "$TOPIC"
        show_subscribe "$TOPIC"
        restart_watcher_if_running
    else
        say "  skipped - existing notification configuration left in place"
    fi
elif confirm "Configure ntfy push now?"; then
    TOPIC=$(new_topic)
    write_notify "$TOPIC"
    show_subscribe "$TOPIC"
else
    say "  skipped - create $CONF_DIR/notify.env later (see config/notify.env.example),"
    say "  then: tendril service restart"
fi
say ""

# ---------------- 5. notification watcher (optional) ----------------
# systemd user unit on Linux, launchd LaunchAgent on macOS - whichever
# service manager this host actually has.
WATCH=$(python3 "$HOST_HELPER" service status 2>/dev/null); WATCH_RC=$?
WATCH_MGR=$(printf '%s' "$WATCH" | sed -n 's/.*(\(.*\))$/\1/p')
say "5) Notification watcher (${WATCH_MGR:-no service manager})"
if [ "$WATCH_RC" = "3" ] || [ -z "$WATCH_MGR" ]; then
    say "  no launchd or user systemd session detected - skipped."
    say "  run it by hand when needed:  herdr-notify"
else
    [ -n "$WATCH" ] && say "  current: $WATCH"
    if confirm "Install and start the herdr-notify watcher ($WATCH_MGR, user-level)?"; then
        if [ "$DRY_RUN" = "1" ]; then
            python3 "$HOST_HELPER" service install --pkg "$PKG_DIR" --python "$PYTHON" --dry-run
        else
            python3 "$HOST_HELPER" service install --pkg "$PKG_DIR" --python "$PYTHON"
        fi
        say "  manage it later with:  tendril service status|restart|stop|logs"
    else
        say "  skipped - enable later by re-running ./install (step 5)"
    fi
fi
say ""

# ---------------- 6. herdr keybindings (detach + switching) ----------------
say "6) Herdr keybindings"
say "     Alt+D         recommended detach (phone: tap ALT then D)"
say "     Ctrl+Home     optional native detach (only when this Herdr CLI validates it)"
say "                   remote-agents bridges Ctrl+Home to Alt+D on TTY attaches"
say "                   by default (SSH/Mosh too; no phone env forwarding)"
say "                   host opt-out: TENDRIL_DETACH_BRIDGE=0"
say "     Prefix+D      universal fallback (prefix is Ctrl+B by default)"
say "     Ctrl+B 1..9   digit shortcuts: Herdr switches tabs by default; TENDRIL"
say "     Alt+1..9      proposes workspaces where those keys are free - the"
say "     Ctrl+1..9     result below shows what yours actually do"
say "     Ctrl+B n / p  next / previous tab (phone-safe)"
say "     Alt+←/→       next / previous tab (desktop modifier encoding)"
say "     Alt+Up        left unbound so Pi can edit steering messages"
# Ask the installed client to parse Ctrl+Home in an isolated config. This
# catches versions that do not know that key name without touching live config.
HERDR_CONF="$HOME/.config/herdr/config.toml"
DETACH_HELPER="$PKG_DIR/bin/herdr-bindings.py"
CTRL_HOME_SUPPORTED=0
if python3 "$DETACH_HELPER" supports "$HERDR_BIN" ctrl+home; then
    CTRL_HOME_SUPPORTED=1
    say "  Ctrl+Home key syntax verified by $HERDR_BIN config check"
else
    say "  note: $HERDR_BIN config check rejects ctrl+home; keeping legacy ctrl+] only when already configured"
    say "        Alt+D and Prefix+D remain when conflict-free; use Alt+D on the phone"
fi

# plan|apply the managed detach set without disturbing unrelated bindings
# (herdr_detach / herdr_backup_config / herdr_restore_config / herdr_switch
# are defined with the other helpers at the top so upgrade mode reuses them)

if [ ! -f "$HERDR_CONF" ]; then
    say "  no $HERDR_CONF yet; a minimal config will be proposed without replacing Herdr defaults"
fi
PLAN=$(herdr_detach plan)
    CONFLICT=$(printf '%s\n' "$PLAN" | sed -n 's/^CONFLICT=//p')
    ADDED=$(printf '%s\n' "$PLAN" | sed -n 's/^ADDED=//p')
    REMOVED=$(printf '%s\n' "$PLAN" | sed -n 's/^REMOVED=//p')
    LINE=$(printf '%s\n' "$PLAN" | sed -n 's/^LINE=//p')
    [ -n "$CONFLICT" ] && say "  note: chord conflict(s) ($CONFLICT) - conflicting bindings are left untouched"
    if [ -z "$ADDED" ] && [ -z "$REMOVED" ]; then
        say "  detach bindings already complete - nothing to do"
    else
        say "  proposed change in $HERDR_CONF (adds: ${ADDED:-none}; removes: ${REMOVED:-none}):"
        say "      $LINE"
        say "  every other binding in your config is left exactly as it is."
        if confirm "Apply this keybinding change?"; then
            BAK=$(herdr_backup_config)
            if [ "$DRY_RUN" = "1" ]; then
                say "  [dry-run] write the line above; then herdr config check + reload-config"
            else
                herdr_detach apply
                if "$HERDR_BIN" config check >/dev/null 2>&1; then
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1 \
                        && say "  applied + reloaded live (no server restart)"
                else
                    say "  config check FAILED - restoring previous config"
                    herdr_restore_config "$BAK"
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1
                fi
            fi
        else
            say "  skipped - your bindings are unchanged"
        fi
    fi
    PLAN=$(herdr_switch plan)
    ADDS=$(printf '%s\n' "$PLAN" | sed -n 's/^ADD=[^|]*|\([^|]*\)|.*/\1/p')
    SKIPS=$(printf '%s\n' "$PLAN" | sed -n 's/^SKIP=[^|]*|\([^|]*\)|\(.*\)/\1: \2/p')
    if [ -n "$SKIPS" ]; then
        say "  switching bindings left alone:"
        printf '%s\n' "$SKIPS" | grep -E ': (already|multi-line)' | sed 's/^/    KEPT     /'
        printf '%s\n' "$SKIPS" | grep -vE ': (already|multi-line)' | sed 's/^/    SKIPPED  /'
    fi
    if [ -z "$ADDS" ]; then
        say "  no switching bindings to add"
    else
        say "  proposed switching bindings (each validated on its own):"
        printf '%s\n' "$ADDS" | sed 's/^/    ADD      /'
        say "  every existing binding is left exactly as it is."
        if confirm "Apply these switching bindings?"; then
            if [ "$DRY_RUN" = "1" ]; then
                say "  [dry-run] append the bindings above; herdr config check; reload-config"
            else
                "$HERDR_BIN" config check >/dev/null 2>&1; BASE_RC=$?
                BAK=$(herdr_backup_config)
                if RESULT=$(herdr_switch apply) \
                   && { [ "$BASE_RC" != 0 ] || "$HERDR_BIN" config check >/dev/null 2>&1; }; then
                    PLAN=$RESULT
                    printf '%s\n' "$RESULT" | sed -n 's/^ADD=[^|]*|\([^|]*\)|.*/    ADDED    \1/p'
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1 \
                        && say "  applied + reloaded live (no server restart)"
                else
                    say "  config check FAILED - restoring previous config"
                    printf '%s\n' "$RESULT" | sed -n 's/^REFUSED=/    herdr: /p'
                    herdr_restore_config "$BAK"
                    "$HERDR_BIN" server reload-config >/dev/null 2>&1
                    PLAN=$(herdr_switch digits)
                fi
            fi
        else
            say "  skipped - your switching bindings are unchanged"
            PLAN=$(herdr_switch digits)
        fi
    fi
    say "  digit shortcuts in your Herdr config now:"
    printf '%s\n' "$PLAN" | sed -n 's/^DIGITS=//p' | while IFS='|' read -r keys does; do
        printf '    %-13s %s\n' "$keys" "$does"
    done
say ""

# ---------------- 7. personalized Android setup ----------------
hr; say "TENDRIL // ANDROID SETUP (for this host)"; hr
say "Run inside Termux on the phone:"
say ""
say "  pkg update && pkg install openssh mosh"
say "  ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N '' -C termux"
say ""
say "  cat > ~/.ssh/config <<'EOF'"
say "  Host $ALIAS"
say "      HostName $TSHOST"
say "      User $USER"
say "      IdentityFile ~/.ssh/id_ed25519"
say "      IdentitiesOnly yes"
say "      ServerAliveInterval 30"
say "      ServerAliveCountMax 3"
say "  EOF"
say ""
say "  ssh-copy-id $ALIAS && ssh $ALIAS    # must log in without a password"
say "  set -e"
say "  mkdir -p ~/bin ~/tendril-launchers"
say "  scp $(shq "$ALIAS:$PKG_DIR/phone/tendril") ~/tendril-launchers/tendril"
say "  scp $(shq "$ALIAS:$PKG_DIR/phone/agent") ~/tendril-launchers/agent"
say "  rm -f ~/bin/tendril ~/bin/agent"
say "  mv ~/tendril-launchers/tendril ~/bin/tendril"
say "  mv ~/tendril-launchers/agent ~/bin/agent"
say "  chmod 700 ~/bin/tendril ~/bin/agent && rmdir ~/tendril-launchers"
say "  echo 'export PATH=\$HOME/bin:\$PATH' >> ~/.bashrc"
say "  echo 'export TENDRIL_ALIAS=$ALIAS' >> ~/.bashrc && source ~/.bashrc"
say ""
say "  hash -r && command -v tendril && command -v agent"
say "  tendril              # TENDRIL console"
say ""
say "  (the phone generates its own key; private keys are never copied)"
say ""
say "iPhone (Blink Shell): docs/IOS_BLINK.md - same host alias, same commands."
say "Mac / desktop client:  run ./install --client on that machine (docs/MACOS.md)."
say ""
say "Install provenance (what `tendril --upgrade` reads):"
if [ "$DRY_RUN" = "1" ]; then
    say "  [dry-run] record $CONF_DIR/install.json (source, commit, version, phone hashes)"
elif "$PYTHON" "$PKG_DIR/bin/tendril_upgrade.py" record-provenance --pkg "$PKG_DIR/bin"; then
    :
else
    say "  note: provenance not recorded (non-fatal; it only enables tendril --upgrade)"
fi
say ""
hr
say "Done. Host console:  tendril (= $BIN_DIR/remote-agents)   |   doctor:  $0 --doctor"
say "Daily use from the phone:  tendril          watcher:  tendril service status"
hr
