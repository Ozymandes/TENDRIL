# herdr-notify push transport — copy this file to notify.env and fill in.
#   cp notify.env.example notify.env && chmod 600 notify.env
#
# Topic name MUST be long + random (unguessable): anyone who knows the
# topic can send to your phone. Subscribe once in the ntfy Android app.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=change-me-long-random-unguessable
# Optional bearer token (ntfy access token / self-hosted auth):
NTFY_TOKEN=

# Deep link: URL opened when a notification is tapped on the phone.
# Placeholders: {host} {workspace_id} {label} {label_uri} {payload_b64} {uri}
#   {payload_b64} — canonical tendril-link payload (host + workspace id +
#                   label ONLY; no keys, tokens or commands)
#   {label_uri}   — label percent-encoded (comma-safe in ntfy Actions)
#   {uri}         — human-inspectable tendril://host/<h>/workspace/<w> URI
# Unknown placeholders render empty; a workspace that vanished from the
# snapshot pushes without Click/Actions headers. Example (whatever your
# phone-side opener is — Termux url-opener, ssh alias, Shortcuts...):
#   NTFY_CLICK_TEMPLATE=https://phone.example/tendril?payload={payload_b64}
NTFY_CLICK_TEMPLATE=
# Also attach a "view, Attach, <url>, clear=true" button next to the click
# URL ("1" = yes, default; "0" = no Actions header):
NTFY_ACTIONS=1
# "Agent still working" nudge after this many minutes in one working stint
# (fires once per stint; 0 disables):
NTFY_WORKING_NUDGE_MINUTES=45
# Optional body detail from a LOCAL command of your choice; leave empty to
# disable (default — no LLM, no API keys, no network beyond the ntfy POST).
# It receives one JSON object on stdin ({workspace_id,label,agent,status,
# elapsed_s,cwd,host}) and may print one short line (<=200 chars) which is
# appended to the body as " — <detail>". Any failure is silently ignored.
NTFY_SUMMARIZER_BIN=
