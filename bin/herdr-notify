#!/usr/bin/env python3
"""herdr-notify — Herdr agent state -> ntfy operator alerts (Android, iOS).

Polls `herdr api snapshot` (same explicit 0.9.1 client as remote-agents)
and pushes short, deterministic alerts composed only from snapshot state:
agent kind, time in the current status, home-collapsed cwd, workspace
label. Classes: input required (high), task finished (default), and a
once-per-stint "still working" nudge (min). Optional deep-link plumbing
renders an ntfy Click URL (plus an Attach action button) from canonical
tendril-link payloads so a tap can open the right workspace on the phone.
The click target is the EMITTING agent's own pane (from the snapshot
entry that produced the event) — never the workspace's currently focused
tab, which is why taps used to land on the wrong session.
Zero LLM/API cost by default: no external services, no API keys, and no
network traffic beyond the ntfy POST itself. Baselines on start and after
any Herdr outage so restarts never cause notification storms. Credentials
live in ~/.config/remote-agents/notify.env (chmod 600).
"""
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
from urllib.parse import quote

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import tendril_link  # canonical deep-link payloads; lives next to this file

# ---------- portable configuration + Herdr client detection ----------
CONFIG_SEARCH = [
    os.environ.get("REMOTE_AGENTS_CONFIG"),
    os.path.expanduser("~/.config/remote-agents/config"),
]


def load_config():
    for path in CONFIG_SEARCH:
        if path and os.path.isfile(path):
            cfg = {}
            with open(path) as f:
                for ln in f:
                    ln = ln.strip()
                    if ln and not ln.startswith("#") and "=" in ln:
                        k, v = ln.split("=", 1)
                        cfg[k.strip()] = v.strip().strip('"').strip("'")
            return cfg
    return {}


CONFIG = load_config()


def _herdr_candidates():
    out = []
    override = CONFIG.get("HERDR_BIN") or os.environ.get("HERDR_BIN")
    if override:
        out.append(os.path.expanduser(override))
    found = shutil.which("herdr")
    if found:
        out.append(found)
    # install.sh (~/.local/bin) and Homebrew locations: launchd/systemd PATHs omit them
    for d in ("~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"):
        p = os.path.join(os.path.expanduser(d), "herdr")
        if os.path.isfile(p):
            out.append(p)
    mise = os.path.expanduser("~/.local/share/mise/installs/herdr")
    latest = os.path.join(mise, "latest", "herdr")
    if os.path.isfile(latest):
        out.append(latest)
    if os.path.isdir(mise):
        versions = []
        for name in os.listdir(mise):
            p = os.path.join(mise, name, "herdr")
            if os.path.isfile(p):
                versions.append((name, p))
        versions.sort(key=lambda t: [int(x) if x.isdigit() else 0
                                     for x in t[0].split(".")], reverse=True)
        out += [p for _, p in versions]
    seen, uniq = set(), []
    for cand in out:
        real = os.path.realpath(cand)
        if real not in seen:
            seen.add(real)
            uniq.append(cand)
    return uniq


HERDR_VERDICTS = []


def herdr_probe(path):
    try:
        v = subprocess.run([path, "--version"], capture_output=True,
                           text=True, timeout=6)
        version = (v.stdout or v.stderr).strip() or "(no version output)"
    except subprocess.TimeoutExpired:
        return False, "no answer to --version (timeout)"
    except OSError as e:
        return False, f"not runnable: {e}"
    try:
        s = subprocess.run([path, "status"], capture_output=True,
                           text=True, timeout=8)
        txt = (s.stdout or "") + (s.stderr or "")
    except subprocess.TimeoutExpired:
        return False, f"{version}; status timed out"
    except OSError as e:
        return False, f"{version}; status failed: {e}"
    running = re.search(r"status:\s*running", txt)
    compatible = (re.search(r"endpoint_compatible:\s*yes", txt)
                  or re.search(r"private_protocol_compatible:\s*yes", txt))
    if running and compatible:
        return True, f"{version} (protocol-compatible with running server)"
    if running:
        return False, f"{version} (INCOMPATIBLE with running server)"
    return True, f"{version} (no running server detected)"


def detect_herdr():
    picked = None
    for cand in _herdr_candidates():
        ok, detail = herdr_probe(cand)
        HERDR_VERDICTS.append((cand, ok, detail))
        if ok:
            picked = cand
            break
    return picked


HERDR = detect_herdr()
ENV_FILE = (os.environ.get("NOTIFY_ENV")
            or os.path.expanduser("~/.config/remote-agents/notify.env"))
POLL_SECONDS = 8
MIN_REPEAT = 90  # min seconds between pushes for the same pane
NUDGE_DEFAULT_MINUTES = 45  # "still working" nudge threshold (0 disables)
MAX_TITLE_LABEL = 60        # title label cap (… suffix past this)
MAX_CWD_CHARS = 28          # keep short cwds whole, else last two components

# Herdr semantics (official docs): `idle` and `done` BOTH mean the agent is
# ready for input; screen-detected agents (e.g. Pi) settle to `idle` after a
# turn, integration-tracked agents may report `done`. `blocked` = approval or
# question UI. Herdr exposes no distinct "error" state.
NEEDS_INPUT = "needs_input"
DONE = "done"
NUDGE = "nudge"

# class -> (body verb after <KIND>, ntfy Priority, ntfy Tags emoji shortcode)
CLASS_STYLE = {
    NEEDS_INPUT: ("needs input", "high", "rotating_light"),
    DONE: ("finished", "default", "white_check_mark"),
    NUDGE: ("still working", "min", "hourglass"),
}


def classify(prev_st, new_st):
    """Meaningful transition -> alert class (NEEDS_INPUT/DONE); None silent."""
    if new_st == "blocked":
        return NEEDS_INPUT
    if prev_st == "working" and new_st in ("idle", "done"):
        return DONE
    return None


# ---------- deterministic alert composition (pure, unit-testable) ----------

def human_elapsed(seconds):
    """Compact human duration: 45s / 18m / 1h02m (minutes zero-padded)."""
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def short_cwd(path):
    """~/-collapsed cwd, whole if <=28 chars, else '…/<last-two-components>'.
    Empty/missing -> "" (the body simply omits the cwd segment)."""
    if not path:
        return ""
    path = str(path)
    home = os.path.expanduser("~")
    if home and home != "/":
        if path == home:
            return "~"
        if path.startswith(home + "/"):
            path = "~" + path[len(home):]
    if len(path) <= MAX_CWD_CHARS:
        return path
    parts = [p for p in path.split("/") if p]
    if not parts:  # only possible for paths that already fit the cap
        return path
    return "…/" + "/".join(parts[-2:])


def compose(kind, label, cls, status_since, cwd, now=None):
    """Deterministic (title, body, priority, tags) for one alert class.

    Title: 'TENDRIL · <label>'. Body: '<KIND> <verb> · <elapsed>[ · <cwd>]' —
    built ONLY from the passed snapshot fields, never agent output.
    """
    if now is None:
        now = time.time()
    verb, priority, tags = CLASS_STYLE[cls]
    kind = str(kind).strip().upper() or "AGENT"
    clean = tendril_link.clean_label(label) or "workspace"
    if len(clean) > MAX_TITLE_LABEL:
        clean = clean[:MAX_TITLE_LABEL] + "…"
    title = f"TENDRIL · {clean}"
    body = f"{kind} {verb} · {human_elapsed(now - status_since)}"
    short = short_cwd(cwd)
    if short:
        body += f" · {short}"
    return title, body, priority, tags


def render_template(template, fields):
    """Total placeholder substitution for click URL templates: {name} ->
    fields[name] or "" for unknown names. Pure string ops, never raises."""
    return re.sub(r"\{([A-Za-z0-9_]+)\}",
                  lambda m: str(fields.get(m.group(1), "")), template or "")


def link_fields(host, workspace_id, label, pane_id=None):
    """tendril-link wire forms for a workspace — narrowed to the emitting
    agent's pane when one is known — plus {label_uri}; None when there is
    no linkable workspace (vanished workspace, invalid ids). A malformed
    pane id falls back to the workspace-only link so the tap still lands
    on the right workspace."""
    if not host or not workspace_id:
        return None
    fields = None
    for pane in (pane_id, None):
        try:
            fields = tendril_link.describe(host, workspace_id, label, pane)
            break
        except (tendril_link.LinkError, TypeError, ValueError):
            continue
    if fields is None:
        return None
    fields = {k: (v or "") for k, v in fields.items()}
    fields["label_uri"] = quote(fields["label"], safe="")
    fields["pane_id"] = pane_id or ""
    return fields


def click_headers(cfg, fields):
    """(Click URL, Actions header) for this push; (None, None) when disabled.
    ntfy short format (docs.ntfy.sh): view, <label>, <url>[, clear=true]."""
    template = str(cfg.get("NTFY_CLICK_TEMPLATE") or "").strip()
    if not template or not fields:
        return None, None
    url = render_template(template, fields)
    if not url:
        return None, None
    actions = None
    if str(cfg.get("NTFY_ACTIONS") or "1").strip() != "0":
        actions = f"view, Attach, {url}, clear=true"
    return url, actions


def nudge_minutes(cfg):
    """NTFY_WORKING_NUDGE_MINUTES as int; default 45; 0 disables; junk -> 45."""
    raw = str(cfg.get("NTFY_WORKING_NUDGE_MINUTES") or "").strip()
    if not raw:
        return NUDGE_DEFAULT_MINUTES
    try:
        return int(raw)
    except ValueError:
        return NUDGE_DEFAULT_MINUTES


def summarize(cfg, info):
    """Optional local summarizer plugin (OFF unless NTFY_SUMMARIZER_BIN is an
    executable). Feeds one JSON object on stdin, takes <=200 chars of stdout,
    cleaned to a single line. ANY failure -> "" (silently omitted)."""
    binary = str(cfg.get("NTFY_SUMMARIZER_BIN") or "").strip()
    if not binary:
        return ""
    path = os.path.expanduser(binary)
    if not os.path.isfile(path) or not os.access(path, os.X_OK):
        return ""
    try:
        p = subprocess.run([path], input=json.dumps(info).encode("utf-8"),
                           capture_output=True, timeout=8)
        if p.returncode != 0:
            return ""
        text = p.stdout.decode("utf-8", "replace")[:200]
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    return tendril_link.clean_label(text) or ""


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


def sd_notify(state):
    """Best-effort systemd watchdog ping (no-op outside a NotifyAccess unit)."""
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        try:
            s.connect(addr)
            s.send(state.encode("utf-8"))
        finally:
            s.close()
    except OSError:
        pass  # watchdog loss must never take the watcher down


def load_env():
    cfg = {}
    try:
        mode = os.stat(ENV_FILE).st_mode & 0o777
        if mode != 0o600:
            log(f"WARN {ENV_FILE} is mode {oct(mode)}; run: chmod 600 {ENV_FILE}")
        with open(ENV_FILE) as f:
            for ln in f:
                ln = ln.strip()
                if ln and not ln.startswith("#") and "=" in ln:
                    k, v = ln.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    except OSError as e:
        log(f"WARN cannot read {ENV_FILE}: {e}")
    return cfg


def configured(cfg):
    return bool(cfg.get("NTFY_URL")) and bool(cfg.get("NTFY_TOPIC"))


def _utf8(value):
    """ntfy accepts UTF-8 header values but http.client only encodes latin-1,
    so hand it pre-encoded bytes (workspace labels may be any Unicode)."""
    return value.encode("utf-8") if isinstance(value, str) else value


def send(cfg, title, body, priority, tags, click=None, actions=None):
    url = cfg["NTFY_URL"].rstrip("/") + "/" + cfg["NTFY_TOPIC"]
    req = urllib.request.Request(url, data=body.encode("utf-8"), method="POST")
    req.add_header("Title", _utf8(title))
    req.add_header("Priority", priority)
    if tags:
        req.add_header("Tags", tags)
    if click:
        req.add_header("Click", _utf8(click))
    if actions:
        req.add_header("Actions", _utf8(actions))
    token = cfg.get("NTFY_TOKEN", "")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(req, timeout=10) as resp:
        resp.read()


def snapshot():
    try:
        p = subprocess.run([HERDR, "api", "snapshot"], capture_output=True,
                           text=True, timeout=8)
        if p.returncode != 0:
            return None
        return json.loads(p.stdout)["result"]["snapshot"]
    except (subprocess.TimeoutExpired, json.JSONDecodeError, KeyError,
            TypeError, OSError):
        return None


def pane_context(agent, workspaces):
    """(kind, workspace_id, raw_label, title_label) for one snapshot agent."""
    ws_id = agent.get("workspace_id") or ""
    label = workspaces.get(ws_id) if ws_id else None
    kind = str(agent.get("agent") or "agent").strip().upper() or "AGENT"
    return kind, ws_id, label, label or ws_id or "workspace"


def push(state, pid, agent, cls, workspaces, cfg, allow_push, now,
         alert_since=None):
    """Compose and send one alert for pid. Honors config + repeat window;
    last_push only advances on a successful send so failures retry.
    alert_since: start of the stint the alert describes — for transitions
    that is the PREVIOUS status's start ("worked 22m, now done"), for the
    nudge it is the current working stint (defaults to state's value)."""
    st, status_since, last_push = state[pid]
    if alert_since is None:
        alert_since = status_since
    if not (allow_push and configured(cfg)):
        return
    if now - last_push < MIN_REPEAT:
        log(f"PUSH suppressed (repeat window) {pid}")
        return
    kind, ws_id, label, title_label = pane_context(agent, workspaces)
    host = tendril_link.host_identity(CONFIG)
    cwd = agent.get("cwd")
    pane_id = agent.get("pane_id") or ""
    title, body, priority, tags = compose(kind, title_label, cls,
                                          alert_since, cwd, now=now)
    # vanished workspace -> no click/actions rather than a garbage payload;
    # the click target is this emitting agent's pane, never the focused tab
    fields = (link_fields(host, ws_id, label, pane_id)
              if ws_id and ws_id in workspaces else None)
    click, actions = click_headers(cfg, fields)
    detail = summarize(cfg, {"workspace_id": ws_id, "label": title_label,
                             "agent": kind, "status": st,
                             "elapsed_s": int(now - alert_since),
                             "cwd": cwd or "", "host": host})
    if detail:
        body += f" — {detail}"
    try:
        send(cfg, title, body, priority, tags, click=click, actions=actions)
        state[pid] = (st, status_since, now)
        log(f"PUSH {title}: {body}")
    except Exception as e:  # keep old ts so next poll retries
        log(f"WARN push failed for {title}: {e}")


def poll(state, cfg, allow_push):
    """One poll cycle. Returns True on success, False when snapshot failed.

    State is pane_id -> (status, status_since, last_push). The still-working
    nudge fires once per working stint: it is eligible only while last_push
    predates the current stint (no push can otherwise happen DURING a working
    stint, so last_push < status_since iff the nudge has not fired yet).
    """
    snap = snapshot()
    if snap is None:
        return False
    workspaces = {}
    for w in snap.get("workspaces", []):
        if w.get("workspace_id"):
            workspaces[w["workspace_id"]] = w.get("label")
    now = time.time()
    seen = set()
    for a in snap.get("agents", []):
        pid = a.get("pane_id")
        st = a.get("agent_status")
        if not pid or not st:
            continue
        seen.add(pid)
        prev = state.get(pid)
        if prev is None:
            state[pid] = (st, now, 0.0)  # baseline: never push on first sighting
            continue
        prev_st, status_since, last_push = prev
        kind, _, _, title_label = pane_context(a, workspaces)
        if st == prev_st:
            held = now - status_since
            minutes = nudge_minutes(cfg)
            if (st == "working" and minutes > 0 and held >= minutes * 60
                    and last_push < status_since
                    and allow_push and configured(cfg)):
                log(f"NUDGE {title_label} // {kind}: working for "
                    f"{human_elapsed(held)}")
                push(state, pid, a, NUDGE, workspaces, cfg, allow_push, now)
            continue
        cls = classify(prev_st, st)
        state[pid] = (st, now, last_push)
        log(f"TRANSITION {title_label} // {kind}: {prev_st} -> {st}"
            + ("" if cls else " (silent)"))
        if cls is None:
            continue
        push(state, pid, a, cls, workspaces, cfg, allow_push, now,
             alert_since=status_since)
    for pid in list(state):
        if pid not in seen:
            del state[pid]  # pane/agent gone; silent by design
    return True


def watch():
    cfg = load_env()
    if not configured(cfg):
        log(f"push NOT CONFIGURED - transitions will only be logged. "
            f"Create {ENV_FILE} (see notify.env.example).")
    state = {}
    gap = False  # first failed poll must not hit an unbound local
    while True:
        sd_notify("WATCHDOG=1")  # feed systemd watchdog every cycle
        if poll(state, cfg, allow_push=True):
            gap = False
        else:
            if not gap:
                log("WARN herdr snapshot unreachable; will re-baseline on recovery")
            gap = True
            state.clear()  # re-baseline after outage: no stale notification storm
        time.sleep(POLL_SECONDS)


def demo_workspace():
    """Workspace for --test click rendering: first live one, else a demo."""
    snap = snapshot()
    if snap:
        for w in snap.get("workspaces", []):
            if w.get("workspace_id"):
                return w["workspace_id"], w.get("label")
    return "w0", "test"


def test():
    cfg = load_env()
    if not configured(cfg):
        print(f"push NOT CONFIGURED. Create {ENV_FILE} like:")
        print(f"  NTFY_URL=https://ntfy.sh")
        print(f"  NTFY_TOPIC=<long-random-unguessable-name>")
        print(f"  NTFY_TOKEN=<optional bearer token>")
        print(f"then: chmod 600 {ENV_FILE} && tendril service restart")
        return 1
    click = actions = None
    template = str(cfg.get("NTFY_CLICK_TEMPLATE") or "").strip()
    if template:
        host = tendril_link.host_identity(CONFIG)
        ws_id, label = demo_workspace()
        fields = link_fields(host, ws_id, label)
        if fields:
            click, actions = click_headers(cfg, fields)
            print(f"click: {click}")
            if actions:
                print(f"actions: {actions}")
        else:
            print("click: not rendered (no linkable workspace)")
    try:
        send(cfg, f"{os.uname().nodename} // remote-agents", "Test notification",
             "default", "bell", click=click, actions=actions)
    except Exception as e:
        print(f"test push FAILED: {e}")
        return 1
    print("test push sent - check the phone.")
    return 0


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == "--test":
            return test()
        if sys.argv[1] == "--once":
            cfg = load_env()
            ok = poll({}, cfg, allow_push=False)
            print("poll OK (baseline logged)" if ok else "snapshot FAILED")
            return 0 if ok else 1
        print(f"usage: {sys.argv[0]} [--test|--once]")
        return 2
    watch()
    return 0


if __name__ == "__main__":
    sys.exit(main())
