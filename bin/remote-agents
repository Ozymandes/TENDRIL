#!/usr/bin/env python3
"""remote-agents — TENDRIL host console: mobile ops for Herdr workspaces.

One call to `herdr api snapshot` powers the whole menu. No config files,
no daemon, no tmux. Built for narrow Android screens (Termux + Mosh/SSH).
"""
import contextlib
import difflib
import getpass
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import select
import shlex
import shutil
import subprocess
import sys
import time
import unicodedata

# ---------- portable configuration ----------
CONFIG_SEARCH = [
    os.environ.get("REMOTE_AGENTS_CONFIG"),
    os.path.expanduser("~/.config/remote-agents/config"),
]


def load_config():
    for path in CONFIG_SEARCH:
        if path and os.path.isfile(path):
            cfg = {}
            with open(path) as f:
                for ln in f:
                    ln = ln.strip()
                    if ln and not ln.startswith("#") and "=" in ln:
                        k, v = ln.split("=", 1)
                        cfg[k.strip()] = v.strip().strip('"').strip("'")
            return cfg
    return {}


CONFIG = load_config()


def _root_list(key, defaults):
    raw = CONFIG.get(key, "").strip()
    if raw:
        return [os.path.expanduser(x.strip()) for x in raw.split(":") if x.strip()]
    return [os.path.expanduser(d) for d in defaults]


PROJECT_ROOTS = _root_list("PROJECT_ROOTS",
                           ["~/Projects", "~/src", "~/dev", "~/code", "~"])
NOTIFY_BIN = os.path.expanduser(CONFIG.get("NOTIFY_BIN")
                                or "~/.local/bin/herdr-notify")

# ---------- canonical deep links (tendril-link, installed next to us) ----------
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import tendril_link          # payload/uri codec for session addresses
except ImportError:              # stale install: the selector keeps working
    tendril_link = None
try:
    import tendril_host          # the few host facts/lifecycle verbs per OS
except ImportError:
    tendril_host = None
try:
    import tendril_upgrade       # --version / --upgrade (thin dispatch below)
except ImportError:
    tendril_upgrade = None

# Canonical host identity (binding contract): config TENDRIL_HOST -> legacy
# TAILSCALE_HOST (lowercased) -> short hostname, HOST_RE-gated, sanitized —
# the single name every deep link, notification and pairing code uses.
if tendril_link is not None and hasattr(tendril_link, "host_identity"):
    HOST_LABEL = tendril_link.host_identity(CONFIG)
else:  # stale install without the resolver: the pre-contract behavior
    HOST_LABEL = CONFIG.get("TAILSCALE_HOST") or (
        tendril_host.short_hostname() if tendril_host else os.uname().nodename)

NOTIFY_ENV = (os.environ.get("NOTIFY_ENV")
              or os.path.expanduser("~/.config/remote-agents/notify.env"))


# ---------- Herdr client detection (protocol-verified, newest-compatible) ----------
HERDR_DIRS = ("~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin")


def _herdr_candidates():
    out = []
    override = CONFIG.get("HERDR_BIN") or os.environ.get("HERDR_BIN")
    if override:
        out.append(os.path.expanduser(override))
    found = shutil.which("herdr")
    if found:
        out.append(found)
    # install.sh (~/.local/bin) and Homebrew locations: SSH/launchd PATHs omit them
    for d in HERDR_DIRS:
        p = os.path.join(os.path.expanduser(d), "herdr")
        if os.path.isfile(p):
            out.append(p)
    mise = os.path.expanduser("~/.local/share/mise/installs/herdr")
    latest = os.path.join(mise, "latest", "herdr")
    if os.path.isfile(latest):
        out.append(latest)
    if os.path.isdir(mise):
        versions = []
        for name in os.listdir(mise):
            p = os.path.join(mise, name, "herdr")
            if os.path.isfile(p):
                versions.append((name, p))
        versions.sort(key=lambda t: [int(x) if x.isdigit() else 0
                                     for x in t[0].split(".")], reverse=True)
        out += [p for _, p in versions]
    seen, uniq = set(), []
    for cand in out:
        real = os.path.realpath(cand)
        if real not in seen:
            seen.add(real)
            uniq.append(cand)
    return uniq


HERDR_VERDICTS = []


def herdr_probe(path):
    """(compatible, detail): client must match the running server's protocol."""
    try:
        v = subprocess.run([path, "--version"], capture_output=True,
                           text=True, timeout=6)
        version = (v.stdout or v.stderr).strip() or "(no version output)"
    except subprocess.TimeoutExpired:
        return False, "no answer to --version (timeout)"
    except OSError as e:
        return False, f"not runnable: {e}"
    try:
        s = subprocess.run([path, "status"], capture_output=True,
                           text=True, timeout=8)
        txt = (s.stdout or "") + (s.stderr or "")
    except subprocess.TimeoutExpired:
        return False, f"{version}; status timed out"
    except OSError as e:
        return False, f"{version}; status failed: {e}"
    running = re.search(r"status:\s*running", txt)
    compatible = (re.search(r"endpoint_compatible:\s*yes", txt)
                  or re.search(r"private_protocol_compatible:\s*yes", txt))
    if running and compatible:
        return True, f"{version} (protocol-compatible with running server)"
    if running:
        return False, f"{version} (INCOMPATIBLE with running server)"
    return True, f"{version} (no running server detected)"


def detect_herdr():
    """First verified-protocol-compatible candidate wins."""
    picked = None
    for cand in _herdr_candidates():
        ok, detail = herdr_probe(cand)
        HERDR_VERDICTS.append((cand, ok, detail))
        if ok:
            picked = cand
            break
    return picked


HERDR = detect_herdr()
SESSION = "default"
CACHE_DIR = os.path.expanduser("~/.cache/remote-agents")
EXTRA_PATH = ":".join([
    os.path.expanduser("~/.local/bin"),
    os.path.expanduser("~/.local/share/mise/shims"),
    os.path.expanduser("~/.local/share/mise/installs/pi/latest/pi"),
    os.path.expanduser("~/.local/share/mise/installs/claude/latest"),
    os.path.expanduser("~/.local/share/mise/installs/codex/latest/bin"),
    "/opt/homebrew/bin",           # Homebrew (Apple Silicon / Intel): agents
    "/usr/local/bin",              # installed there are absent from SSH PATH
])
os.environ["PATH"] = os.environ.get("PATH", "") + ":" + EXTRA_PATH

RANK = {"working": 0, "blocked": 1, "done": 2, "idle": 3, "unknown": 4}
ICON = {"working": "\u25cf", "blocked": "\u25c6", "done": "\u2713",
        "idle": "\u25cb", "unknown": "\u25cb"}
SHORT = {"pi": "PI", "claude": "CL", "codex": "CX", "gemini": "GE",
         "cursor": "CU", "opencode": "OC", "copilot": "CP"}

# ---------- terminal capability model (deliberately small) ----------
def terminal_name(env=None):
    """'termux' | 'blink' | generic terminal family name.

    TERMUX_VERSION only arrives when the user forwards it (ssh SendEnv /
    AcceptEnv): stock OpenSSH sends just TERM and LC_*, and mosh only its
    colour count and locale. Everything else is opt-in: users who want terminal-aware hints set
    TENDRIL_TERMINAL=blink (Blink Shell) — Blink sends no distinguishing
    env over SSH. Unknown values pass through as-is so future clients
    need no code change."""
    if env is None:
        env = os.environ
    if env.get("TERMUX_VERSION"):
        return "termux"                        # self-identified; wins
    custom = (env.get("TENDRIL_TERMINAL") or "").strip().lower()
    if re.match(r"^[a-z0-9_-]{1,24}$", custom):
        return custom
    return "generic"


def pick_palette(colorterm):
    """(lime, teal, gray, red): truecolor where the terminal advertises it
    (COLORTERM), else the nearest 256-colour approximations. mosh < 1.4
    silently drops 38;2;r;g;b sequences (Ubuntu 22.04 ships 1.3.2), which
    rendered the whole phone UI monochrome; the 256-colour entries survive
    every transport. COLORTERM proves the terminal, not the transport: a
    COLORTERM forwarded into mosh < 1.4 still loses 38;2. Desktop terminals
    need no special case: Apple Terminal sets no COLORTERM (256 colours);
    iTerm2, Ghostty, WezTerm and kitty advertise truecolor."""
    if (colorterm or "").lower() in ("truecolor", "24bit"):
        return ("\033[38;2;203;253;117m", "\033[38;2;47;179;196m",
                "\033[38;2;112;128;136m", "\033[38;2;232;92;111m")
    return ("\033[38;5;191m", "\033[38;5;73m",           # #d7ff87 ~ #CBFD75
            "\033[38;5;244m", "\033[38;5;203m")         # #808080 ~ #708088, #ff5f5f ~ #E85C6F


def color_enabled(isatty, no_color, term):
    """Colour on real ttys only: NO_COLOR disables, so does TERM=dumb."""
    return isatty and no_color is None and term != "dumb"


C_RESET = "\033[0m"
C_WHITE = "\033[97m"
_PALETTE = pick_palette(os.environ.get("COLORTERM"))
C_LIME, C_TEAL, C_GRAY, C_RED = _PALETTE
COLOR = color_enabled(sys.stdout.isatty(), os.environ.get("NO_COLOR"),
                      os.environ.get("TERM", ""))
if not COLOR:
    C_RESET = C_LIME = C_TEAL = C_GRAY = C_WHITE = C_RED = ""


# ---------------- masthead (Unicode quadrant blocks, 2x2 per cell) ----------------
_MASTHEAD = (
    # (min columns, lines, slogan (row, col, text))
    # generated by assets/masthead/build_masthead.py --embed
    (50, (  # full
        "     ▀",
        "   ▗▖▀▗▖",
        " ▄ █▌█▐█ ▄  ▀▀█▛▀▗█▀▀▀▘▜▙▄ █▌█▛▀▀█▖▀▀▀▀█▌█▌██",
        "█▘▟▀ █ ▀▙▝█   █▌ ▐█▄▄▄ █▛█▙█▌█▌  █▌▄▄▄▄▛▘█▌██",
        "▀▐▌▗▟ ▙▖▐▌▀   █▌ ▐█    █▌ ▀█▌█▌  █▌█▌▝█▙ █▌██",
        "  ▀▐▌▀▐▌▀     ▀▘ ▝▀▀▀▀ ▀▘  ▀▘▀▀▀▀▀ ▀▘  ▀▘▀▘▀▀▀▀▀▀▘",
        "   ▝▘▀▝▘",
        "     ▀",
    ), (7, 14, 'T H E   E D G E   I S   Y O U R S')),
    (44, (  # compact
        "    ▄",
        "  ▄▌▄▐▄   ▄▄▄▄ ▄▄▄▄▗▄ ▗▄▗▄▄▄▖▗▄▄▄▄▗▄▗▄",
        "▟▘█▘█▝█▝▙  ▐█ ▐█   ▗██▐█▐▌ ▐█   ▐█▐█▐█",
        "▌▛▗▛▄▜▖▜▐  ▐█ ▐█▀▀▘▐█▝▜█▐▌ ▐█▐█▜█ ▐█▐█",
        " ▀ ▌▄▐ ▀   ▝▀ ▝▀▀▀▘▝▀ ▝▀▝▀▀▀▘▝▀ ▝▀▝▀▝▀▀▀▀▘",
        "    ▄",
    ), (6, 11, 'T H E  E D G E  I S  Y O U R S')),
)
_SLOGAN = "THE EDGE IS YOURS"


def masthead(width, body):
    """Masthead + slogan lines plus the blank separator row, centred over a
    box `width` wide that sits above `body` screen lines. The menu always
    wins: the mark steps down a tier, then to a caption (+ slogan), then
    disappears if it would push the selector or prompt off screen."""
    if not COLOR:
        return []
    rows = shutil.get_terminal_size(fallback=(52, 24)).lines
    for min_cols, art, (srow, scol, slogan) in _MASTHEAD:
        height = max(len(art), srow + 1)
        if width >= min_cols and height + 1 + body + 1 <= rows:
            lines = [re.sub(r"(\S+)", lambda m: C_LIME + m.group(1) + C_RESET, ln)
                     for ln in art] + [""] * (height - len(art))
            used = len(art[srow]) if srow < len(art) else 0
            lines[srow] += " " * (scol - used) + C_GRAY + slogan + C_RESET
            pad = " " * ((width - max(max(map(len, art)), scol + len(slogan))) // 2)
            return [pad + ln if ln else ln for ln in lines] + [""]
    tracked = "   ".join(" ".join(w) for w in _SLOGAN.split())
    slogan = tracked if len(tracked) <= width else _SLOGAN
    head = [" " * ((width - 7) // 2) + f"{C_LIME}TENDRIL{C_RESET}",
            " " * ((width - len(slogan)) // 2) + f"{C_GRAY}{slogan}{C_RESET}"]
    for keep in (2, 1):
        if keep + 1 + body + 1 <= rows:
            return head[:keep] + [""]
    return []


def run(args, timeout=6):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", "not found"


def find_key(obj, key):
    """Depth-first search for the first value of `key` in nested JSON."""
    if isinstance(obj, dict):
        if key in obj and isinstance(obj[key], (str, int)):
            return obj[key]
        for v in obj.values():
            r = find_key(v, key)
            if r is not None:
                return r
    elif isinstance(obj, list):
        for v in obj:
            r = find_key(v, key)
            if r is not None:
                return r
    return None


def snapshot():
    rc, out, _ = run([HERDR, "api", "snapshot"], 8)
    if rc != 0:
        return None
    try:
        return json.loads(out)["result"]["snapshot"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None


def collect():
    snap = snapshot()
    if snap is None:
        return None
    pane_cwd = {}
    for p in snap.get("panes", []):
        if p.get("pane_id") and p.get("cwd"):
            pane_cwd[p["pane_id"]] = p["cwd"]
    by_ws = {}
    for a in snap.get("agents", []):
        by_ws.setdefault(a.get("workspace_id"), []).append(a)
    rows = []
    for w in snap.get("workspaces", []):
        wid = w.get("workspace_id")
        ags = by_ws.get(wid, [])
        path = ""
        active_panes = [p for p in snap.get("panes", [])
                        if p.get("tab_id") == w.get("active_tab_id")]
        active_panes.sort(key=lambda p: not p.get("focused", False))
        for p in active_panes:
            path = p.get("foreground_cwd") or p.get("cwd") or ""
            if path:
                break
        if not path:
            for a in ags:
                path = a.get("foreground_cwd") or a.get("cwd") or ""
                if path:
                    break
        best = min((RANK.get(a.get("agent_status"), 4) for a in ags), default=4)
        rows.append({
            "id": wid,
            "label": w.get("label") or wid,
            "number": w.get("number", 99),
            "focused": bool(w.get("focused")),
            "agents": ags,
            "path": path,
            "rank": best,
        })
    rows.sort(key=lambda r: (r["rank"], not r["focused"], r["number"]))
    return rows


def short_path(path):
    if not path:
        return ""
    home = os.path.expanduser("~")
    if path.startswith(home):
        path = "~" + path[len(home):]
    return path


def trunc(s, n):
    return s if len(s) <= n else s[: max(1, n - 1)] + "\u2026"


def box_width():
    cols = shutil.get_terminal_size(fallback=(52, 24)).columns
    return max(34, min(cols, 56))


def line(w, ch="\u2500"):
    return ch * w


def tailscale_cli():
    """PATH first, then the macOS app bundle's CLI."""
    if tendril_host:
        return tendril_host.tailscale_cli() or "tailscale"
    return "tailscale"


def tailscale_parts():
    rc, out, _ = run([tailscale_cli(), "ip", "-4"], 4)
    if rc == 0 and out.strip():
        return "ACTIVE", out.strip().splitlines()[0]
    return "DOWN", ""


def chip_parts(row, max_plain=40):
    """Return (plain, colored) chip strings of identical visible width."""
    if not row["agents"]:
        p = "\u25cb SHELL"
        return p, f"{C_GRAY}{p}{C_RESET}"
    plain = colored = ""
    shown = 0
    for a in row["agents"]:
        st = a.get("agent_status", "unknown")
        kind = SHORT.get(a.get("agent", "?"), (a.get("agent") or "?")[:2].upper())
        sym = ICON.get(st, "\u25cb")
        piece = sym + kind + " "
        if len(plain) + len(piece) + 3 > max_plain:
            break
        col = {"working": C_TEAL, "blocked": C_LIME, "done": C_LIME}.get(st, C_GRAY)
        plain += piece
        colored += f"{col}{sym}{kind}{C_RESET} "
        shown += 1
    rest = len(row["agents"]) - shown
    if rest > 0:
        plain += f"+{rest} "
        colored += f"{C_GRAY}+{rest}{C_RESET} "
    return plain.rstrip(), colored.rstrip()


def render(rows, note="", selected=None):
    w = box_width()
    inner = w - 2

    def fit(s, n):
        return s if len(s) <= n else s[: max(1, n - 1)] + "\u2026"

    def pad(plain, colored):
        return colored + " " * max(0, inner - len(plain))

    def foot_lines(items):
        cur, grouped = "", []
        for it in items:
            cand = (cur + "   " + it) if cur else it
            if len(cand) > inner - 2 and cur:
                grouped.append(cur)
                cur = it
            else:
                cur = cand
        if cur:
            grouped.append(cur)
        return grouped
    feet = foot_lines(["N New", "I Info", "? Help", "R Refresh", "Q Quit"])

    compact = len(rows) > 6
    # Paths yield when needed to keep the menu and prompt on screen, or when
    # dropping them buys the brand a tier: the compact mark, else the
    # TENDRIL + slogan caption, else the one-line caption. Paths never push
    # the whole brand off screen (a keyboard-open phone with 7+ workspaces).
    term_rows = shutil.get_terminal_size(fallback=(52, 24)).lines
    est = 4 + len(feet) + 2
    with_paths = est + sum(1 + (1 if r["path"] else 0) + (0 if compact else 1)
                           for r in rows)
    without = est + sum(1 + (0 if compact else 1) for r in rows)
    if note:
        with_paths += 1
        without += 1
    # brand heights incl. the blank separator: compact mark, caption, title
    brand = next((h for h in (7 + 1, 2 + 1, 1 + 1)
                  if h + without + 1 <= term_rows), 0) if COLOR else 0
    show_paths = with_paths + 1 <= term_rows and (
        brand + with_paths + 1 <= term_rows)

    lines = []
    edge = f"{C_LIME}\u250c{line(inner)}\u2510{C_RESET}"
    sep = f"{C_LIME}\u251c{line(inner)}\u2524{C_RESET}"
    bot = f"{C_LIME}\u2514{line(inner)}\u2518{C_RESET}"
    lines.append(edge)
    suffix = " // REMOTE AGENTS"
    if len(HOST_LABEL) + len(suffix) + 1 <= inner:
        t = f" {HOST_LABEL}{suffix}"
    else:                                       # prompt-polluted label: clamp
        t = " " + fit(HOST_LABEL, inner - len(suffix) - 1) + suffix
    lines.append(f"{C_LIME}\u2502{C_RESET}" + pad(t, f"{C_WHITE}{t}{C_RESET}") + f"{C_LIME}\u2502{C_RESET}")
    status, ip = tailscale_parts()
    tl_full = f" tailnet: {status} {ip}".rstrip()
    tl_plain = fit(tl_full, inner)
    scol = C_TEAL if status == "ACTIVE" else C_RED
    if len(tl_full) <= inner:
        tl_col = f" {C_GRAY}tailnet:{C_RESET} {scol}{status}{C_RESET}" \
            + (f" {C_GRAY}{ip}{C_RESET}" if ip else "")
    else:
        tl_col = C_GRAY + tl_plain + C_RESET
    lines.append(f"{C_LIME}\u2502{C_RESET}" + pad(tl_plain, tl_col) + f"{C_LIME}\u2502{C_RESET}")
    lines.append(sep)
    for i, r in enumerate(rows):
        budget = inner - 6
        lbl_plain = fit(r["label"] + (" *" if r["focused"] else ""), budget - 9)
        is_selected = selected == i
        if is_selected:
            head_plain = f">{i + 1:>2} {lbl_plain}"
            head_col = f"{C_WHITE}>{i + 1:>2}{C_RESET} {C_WHITE}{lbl_plain}{C_RESET}"
        else:
            head_plain = f"{i + 1:>2}  {lbl_plain}"
            head_col = f"{C_WHITE}{i + 1:>2}{C_RESET}  {C_LIME}{lbl_plain}{C_RESET}"
        chip_plain, chip_col = chip_parts(r, budget - len(head_plain) - 1)
        while len(lbl_plain) + 1 + len(chip_plain) > budget and len(lbl_plain) > 4:
            lbl_plain = fit(lbl_plain, len(lbl_plain) - 2)
            if is_selected:
                head_plain = f">{i + 1:>2} {lbl_plain}"
                head_col = f"{C_WHITE}>{i + 1:>2}{C_RESET} {C_WHITE}{lbl_plain}{C_RESET}"
            else:
                head_plain = f"{i + 1:>2}  {lbl_plain}"
                head_col = f"{C_WHITE}{i + 1:>2}{C_RESET}  {C_LIME}{lbl_plain}{C_RESET}"
            chip_plain, chip_col = chip_parts(r, budget - len(head_plain) - 1)
        gap = max(1, inner - 2 - len(head_plain) - len(chip_plain))
        lines.append(f"{C_LIME}\u2502{C_RESET} "
                     + head_col + " " * gap + chip_col
                     + f" {C_LIME}\u2502{C_RESET}")
        if r["path"] and show_paths:
            p_plain = "    " + fit(short_path(r["path"]), inner - 6)
            p_col = f" {C_GRAY}{p_plain[1:]}{C_RESET}"
            lines.append(f"{C_LIME}\u2502{C_RESET}" + pad(p_plain, f" {C_GRAY}{p_plain[1:]}{C_RESET}") + f"{C_LIME}\u2502{C_RESET}")
        if not compact:
            lines.append(f"{C_LIME}\u2502{C_RESET}{' ' * inner}{C_LIME}\u2502{C_RESET}")
    lines.append(sep)
    for ln_ in feet:
        lines.append(f"{C_LIME}\u2502{C_RESET}"
                     + pad(" " + ln_, f" {C_WHITE}{ln_}{C_RESET}")
                     + f"{C_LIME}\u2502{C_RESET}")
    lines.append(bot)
    if note:
        lines.append(f"{C_GRAY}{fit(note, w)}{C_RESET}")
    print("\033[H\033[2J" + "\n".join(masthead(w, len(lines)) + lines), flush=True)


def save_last(row):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(os.path.join(CACHE_DIR, "last"), "w") as f:
            f.write(row["id"] + "\n" + row["label"])
    except OSError:
        pass


def load_last(rows):
    try:
        with open(os.path.join(CACHE_DIR, "last")) as f:
            wid, label = f.read().splitlines()[:2]
    except (OSError, ValueError):
        return None
    for r in rows:
        if r["id"] == wid:
            return r
    return None


def _bridge_enabled():
    """Enable the Ctrl+Home bridge by default for host TTY attachments.

    TENDRIL_DETACH_BRIDGE=1 explicitly enables it; =0 (or false/no/off/empty)
    opts out and restores the direct `herdr session attach` path."""
    raw = os.environ.get("TENDRIL_DETACH_BRIDGE")
    if raw is not None:
        return raw.strip().lower() not in ("", "0", "false", "no", "off")
    return True


def attach(row, pane=None):
    """One-shot attach (selector, `attach <token>`). pane=None focuses
    the workspace -- the historical semantics, unchanged. With a live
    pane entry the focus is exact (workspace -> tab -> pane, verified)
    and a failed verification attaches nothing, returning False."""
    save_last(row)
    if pane is not None:
        if not _focus_pane(pane):
            return False
    else:
        run([HERDR, "workspace", "focus", row["id"]], 6)
    if os.environ.get("HERDR_ENV") == "1":
        input(f"already inside Herdr — workspace '{row['label']}' focused. Enter...")
        return True
    if _bridge_enabled():
        print(f"{C_GRAY}attaching {row['label']} \u2014 detach: Ctrl+Home \u00b7 Alt+D \u00b7 Ctrl+B d - menu returns here{C_RESET}",
              flush=True)
        _attach_session()
    else:
        print(f"{C_GRAY}attaching {row['label']} \u2014 detach: Alt+D \u00b7 Ctrl+B then D fallback - menu returns here{C_RESET}",
              flush=True)
        subprocess.run([HERDR, "session", "attach", SESSION], check=False)
    return True


# ---------- Ctrl+Home detach bridge (default-on TENDRIL convenience) ----------
# Termux encodes Ctrl+Home as `ESC [ 1 ; 5 H` (termux-app KeyHandler.getCode +
# transformForModifiers: KEYMOD_CTRL -> xterm modifier 5). Herdr's key grammar
# has no Home key in any modifier combination, so `herdr session attach` runs
# behind a transparent PTY bridge that rewrites exactly those six bytes to the
# Alt+D detach (`ESC d`) Herdr already binds. Every other byte — including
# plain Home (`ESC [ H`) — is forwarded unchanged. Herdr's config is untouched;
# Alt+D and Ctrl+B d keep working. The host TTY bridge is enabled by default;
# TENDRIL_DETACH_BRIDGE=0 turns it off.
_CTRL_HOME = b"\x1b[1;5H"
_ALT_D = b"\x1bd"


def _detach_translate(data):
    """(tail, out): rewrite Ctrl+Home to the detach; hold a trailing byte
    run that could still complete Ctrl+Home; forward all else unchanged."""
    out = bytearray()
    while True:
        i = data.find(_CTRL_HOME)
        if i < 0:
            break
        out += data[:i]
        out += _ALT_D
        data = data[i + len(_CTRL_HOME):]
    hold = 0
    for k in range(min(len(data), len(_CTRL_HOME) - 1), 0, -1):
        if _CTRL_HOME.startswith(data[-k:]):
            hold = k
            break
    cut = len(data) - hold
    out += data[:cut]
    return data[cut:], bytes(out)


def _write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def _attach_session():
    """Run `herdr session attach` behind the Ctrl+Home bridge (tty only)."""
    import fcntl
    import pty
    import select
    import signal
    import termios
    import tty
    if not sys.stdin.isatty():    # no tty (pipes/tests): plain passthrough
        subprocess.run([HERDR, "session", "attach", SESSION], check=False)
        return
    pid, master = pty.fork()
    if pid == 0:                  # child: Herdr owns the bridge pty
        try:
            os.execvp(HERDR, [HERDR, "session", "attach", SESSION])
        finally:
            os._exit(127)
    fd = sys.stdin.fileno()
    out_fd = sys.stdout.fileno()
    old = termios.tcgetattr(fd)

    def resize(*_):
        try:
            ws = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, ws)
        except OSError:
            pass

    def _stop(*_):                # TERM/HUP: exit through finally (restore tty)
        sys.exit(1)

    old_winch = signal.signal(signal.SIGWINCH, resize)
    old_term = signal.signal(signal.SIGTERM, _stop)
    old_hup = signal.signal(signal.SIGHUP, _stop)
    resize()
    tty.setraw(fd)
    tail = b""
    reaped = False
    try:
        while True:
            r, _, _ = select.select([fd, master], [], [], 1.0)
            if not r and tail:    # a cancelled combo must not hold bytes forever
                _write_all(master, tail)
                tail = b""
            if fd in r:
                data = os.read(fd, 4096)
                if not data:
                    break
                tail, out = _detach_translate(tail + data)
                if out:
                    _write_all(master, out)
            if master in r:
                try:
                    data = os.read(master, 4096)
                except OSError:   # EIO: child exited
                    break
                if not data:
                    break
                _write_all(out_fd, data)
            done, _ = os.waitpid(pid, os.WNOHANG)
            if done == pid:
                reaped = True
                break
    finally:
        if tail:                      # flush a held partial sequence
            try:
                _write_all(master, tail)
            except OSError:
                pass
        signal.signal(signal.SIGWINCH, old_winch)
        signal.signal(signal.SIGTERM, old_term)
        signal.signal(signal.SIGHUP, old_hup)
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        try:                          # drain Herdr's last output
            while True:
                r, _, _ = select.select([master], [], [], 0.2)
                if not r:
                    break
                data = os.read(master, 4096)
                if not data:
                    break
                _write_all(out_fd, data)
        except OSError:
            pass
        try:
            os.close(master)
        except OSError:
            pass
        if not reaped:
            try:
                os.waitpid(pid, 0)
            except ChildProcessError:
                pass


def ws_create(cwd, label=None, focus=True):
    args = [HERDR, "workspace", "create", "--cwd", cwd]
    if label is not None:
        args.extend(["--label", label])
    args.append("--focus" if focus else "--no-focus")
    rc, out, err = run(args, 12)
    if rc != 0:
        return None, (err or out or "create failed")
    try:
        return json.loads(out), None
    except json.JSONDecodeError:
        return {}, None


def start_agent(name, kind, pane_id):
    print(f"{C_GRAY}starting {kind} \u2014 waiting for readiness...{C_RESET}", flush=True)
    rc, out, err = run([HERDR, "agent", "start", name, "--kind", kind,
                        "--pane", pane_id, "--timeout", "30000"], 45)
    return rc == 0, (err or out)


def choose(prompt, options):
    for i, o in enumerate(options, 1):
        print(f"  {C_WHITE}{i}{C_RESET}) {o}")
    raw = input(prompt).strip()
    if raw.isdigit() and 1 <= int(raw) <= len(options):
        return options[int(raw) - 1]
    return None


def ask_dir():
    opts = list(dict.fromkeys(PROJECT_ROOTS + [os.path.expanduser("~")]))
    opts.append("custom path")
    pick = choose("dir> ", opts)
    if pick is None:
        return None
    if pick == "custom path":
        pick = input("path> ").strip()
        pick = os.path.expanduser(pick)
        if not pick.startswith("/") and not pick.startswith("~"):
            return None
    if not os.path.isdir(pick):
        print(f"{C_RED}no such directory: {pick}{C_RESET}")
        return None
    return pick


def ask_agent():
    kinds = [k for k in ("pi", "claude", "codex") if shutil.which(k)]
    opts = ["shell only"] + [f"{k} (agent)" for k in kinds]
    pick = choose("launch> ", opts)
    if pick is None:
        return None
    if pick == "shell only":
        return "shell"
    return pick.split(" ")[0]


def confirm(text):
    ans = input(f"{C_WHITE}{text}{C_RESET} {C_GRAY}[Enter=go, n=cancel]{C_RESET} ").strip()
    return ans != "n"


def _created_workspace_label(data, cwd):
    result = data.get("result", data) if isinstance(data, dict) else {}
    workspace = result.get("workspace", {}) if isinstance(result, dict) else {}
    label = workspace.get("label") if isinstance(workspace, dict) else None
    if label:
        return str(label)
    return os.path.basename(os.path.normpath(cwd)) or "workspace"


def agent_name_for_workspace(label, cwd, unique_key=None):
    """Make a valid, workspace-unique Herdr agent name from its label."""
    source = label or os.path.basename(os.path.normpath(cwd)) or "workspace"
    ascii_name = unicodedata.normalize("NFKD", source).encode("ascii", "ignore").decode()
    name = re.sub(r"[^a-zA-Z0-9_-]+", "-", ascii_name).strip("-_").lower()
    if not name:
        name = "workspace"
    if not name[0].isalpha():
        name = "workspace-" + name
    if unique_key is not None:
        suffix = hashlib.sha256(str(unique_key).encode("utf-8")).hexdigest()[:12]
        name = (name[:19].rstrip("-_") or "workspace") + "-" + suffix
    return name[:32].rstrip("-_") or "workspace"


def current_ws_dir(rows, selected=None):
    """Usable create-default cwd: the selected workspace's path, else the
    focused one. None when neither has a directory that still exists."""
    order = []
    if selected is not None and 0 <= selected < len(rows):
        order.append(rows[selected])
    for r in rows:
        if r.get("focused") and r not in order:
            order.append(r)
    for r in order:
        path = r.get("path")
        if path and os.path.isdir(path):
            return path
    return None


def new_workspace(rows=None, selected=None):
    """Open a shell immediately; Herdr derives the workspace name from cwd."""
    if rows is None:
        rows = collect() or []
    d = current_ws_dir(rows, selected)
    if not d:
        try:
            d = os.getcwd()
        except OSError:
            d = os.path.expanduser("~")
    # No --label or agent command: retain native directory-based naming and
    # launch the user's normal shell, without any wizard or confirmation.
    data, err = ws_create(d)
    if data is None:
        print(f"{C_RED}{err}{C_RESET}")
        return None
    wid = find_key(data, "workspace_id")
    for r in (collect() or []):
        if r["id"] == wid:
            attach(r)
            return wid
    print(f"{C_GRAY}shell workspace created; it will appear in the menu{C_RESET}")
    return wid


def quick_shell(rows=None, selected=None):
    if rows is None:
        rows = collect() or []
    d = current_ws_dir(rows, selected) or os.path.expanduser("~")
    name = "shell-" + time.strftime("%H%M%S")
    data, err = ws_create(d, name)
    if data is None:
        print(f"{C_RED}{err}{C_RESET}")
        return None
    wid = find_key(data, "workspace_id")
    for r in (collect() or []):
        if r["id"] == wid:
            attach(r)
            return wid
    print(f"{C_GRAY}shell workspace created{C_RESET}")
    return wid


def project_launcher():
    roots = [r for r in PROJECT_ROOTS
             if r != os.path.expanduser("~") and os.path.isdir(r)]
    rows = collect() or []
    entries = []
    for root in roots:
        try:
            names = sorted(os.listdir(root), key=lambda n: -os.path.getmtime(
                os.path.join(root, n)))
        except OSError:
            continue
        for n in names:
            p = os.path.join(root, n)
            if os.path.isdir(p) and not n.startswith("."):
                entries.append((n, p))
                if len(entries) >= 9:
                    break
        if len(entries) >= 9:
            break
    if not entries:
        print(f"{C_RED}no project directories found{C_RESET}")
        return
    cwdset = [r["path"].rstrip("/") for r in rows if r["path"]]
    for i, (n, p) in enumerate(entries, 1):
        exists = any(r["label"] == n or r["path"].rstrip("/") == p for r in rows) \
            or p in cwdset or any(c.startswith(p + "/") for c in cwdset)
        tag = f"  {C_TEAL}existing{C_RESET}" if exists else ""
        print(f"  {C_WHITE}{i}{C_RESET}) {C_LIME}{n}{C_RESET} "
              f"{C_GRAY}{short_path(p)}{C_RESET}{tag}")
    raw = input("project> ").strip()
    if not (raw.isdigit() and 1 <= int(raw) <= len(entries)):
        return
    n, p = entries[int(raw) - 1]
    for r in rows:
        if r["label"] == n or r["path"].rstrip("/") == p \
                or r["path"].rstrip("/").startswith(p + "/"):
            print(f"{C_GRAY}matching workspace exists \u2014 attaching{C_RESET}")
            attach(r)
            return r["id"]
    kind = ask_agent()
    if kind is None:
        return
    if not confirm(f"create '{n}' @ {short_path(p)} + {kind}?"):
        return
    data, err = ws_create(p, n)
    if data is None:
        print(f"{C_RED}{err}{C_RESET}")
        return
    wid = find_key(data, "workspace_id")
    pane = find_key(data, "pane_id")
    if kind != "shell":
        if not pane and wid:
            snap = snapshot()
            for pan in (snap or {}).get("panes", []):
                if pan.get("workspace_id") == wid and pan.get("pane_id"):
                    pane = pan["pane_id"]
                    break
        if not pane:
            print(f"{C_RED}could not locate new pane; start {kind} manually{C_RESET}")
            return None
        ok, msg = start_agent(agent_name_for_workspace(n, p, wid or pane),
                              kind, pane)
        if not ok:
            print(f"{C_RED}agent start: {trunc(msg.strip() or 'failed', 60)}{C_RESET}")
            return None
    for r in (collect() or []):
        if r["id"] == wid:
            attach(r)
            return wid
    return wid


@contextlib.contextmanager
def raw_terminal(fd):
    """Put a terminal into raw mode and always restore its exact settings."""
    import termios
    import tty

    original = termios.tcgetattr(fd)
    try:
        tty.setraw(fd, termios.TCSANOW)
        yield
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, original)


def _read_byte(fd, timeout=None):
    if timeout is not None:
        try:
            ready, _, _ = select.select([fd], [], [], timeout)
        except InterruptedError:
            return b""
        if not ready:
            return b""
    try:
        return os.read(fd, 1)
    except OSError:
        return b""


def read_key(fd, escape_timeout=0.2):
    """Read one key, decoding CSI/SS3 arrows without blocking on bare Escape."""
    first = _read_byte(fd)
    if not first:
        return None
    if first == bytes([27]):
        introducer = _read_byte(fd, escape_timeout)
        if not introducer:
            return "escape"
        if introducer not in (b"[", b"O"):
            return "escape"
        for _ in range(16):
            byte = _read_byte(fd, escape_timeout)
            if not byte:
                return "escape"
            if 0x40 <= byte[0] <= 0x7e:
                final = chr(byte[0])
                return {"A": "up", "B": "down", "C": "right",
                        "D": "left"}.get(final, "escape")
        return "escape"
    if first in (bytes([13]), bytes([10])):
        return "enter"
    if first in (bytes([127]), bytes([8])):
        return "backspace"
    if first == bytes([3]):
        raise KeyboardInterrupt
    if first == bytes([4]):
        return None
    try:
        return first.decode("ascii")
    except UnicodeDecodeError:
        return "unknown"


def read_menu_action(tty_mode, fd=None):
    """Return (kind, value); non-TTY users retain the original line prompt."""
    if not tty_mode:
        return "line", input("> ").strip()
    with raw_terminal(fd):
        return _read_tty_action(fd)


def _read_tty_action(fd):
    prompt = "↑/↓ · number + Enter · key> "
    sys.stdout.write(C_GRAY + prompt + C_RESET)
    sys.stdout.flush()
    text = ""
    while True:
        key = read_key(fd)
        if key is None:
            return "eof", ""
        if key in ("up", "down"):
            return "navigate", key
        if key == "enter":
            return ("line", text.strip()) if text.strip() else ("enter", "")
        if key == "backspace":
            if text:
                text = text[:-1]
                sys.stdout.write(chr(13) + C_GRAY + prompt + text + chr(27) + "[K" + C_RESET)
                sys.stdout.flush()
            continue
        if key == "?" or (isinstance(key, str) and len(key) == 1
                           and key.lower() in ("n", "i", "r", "q")):
            return "line", key
        if isinstance(key, str) and len(key) == 1 and key.isprintable():
            text += key
            sys.stdout.write(key)
            sys.stdout.flush()


def selection_index(rows, preferred_id=None, previous_index=None):
    """Keep the selected workspace stable; fall back to focus, then row position."""
    if not rows:
        return None
    if preferred_id is not None:
        for index, row in enumerate(rows):
            if row.get("id") == preferred_id:
                return index
    for index, row in enumerate(rows):
        if row.get("focused"):
            return index
    if previous_index is not None:
        return max(0, min(previous_index, len(rows) - 1))
    return 0


def move_selection(rows, selected, delta):
    if not rows:
        return None
    if selected is None:
        return selection_index(rows)
    return max(0, min(selected + delta, len(rows) - 1))


def wait_for_key():
    if not sys.stdin.isatty():
        input()
        return
    fd = sys.stdin.fileno()
    with raw_terminal(fd):
        read_key(fd)


_DIGIT_WORDS = {"switch tab": "jump to tab", "switch workspace": "jump to workspace",
                "focus agent": "focus agent"}


def digit_rows(text=None):
    """What digit chords really do in this user's Herdr config (the help
    must not promise workspace jumps that a user binding overrides).
    Falls back to Herdr's documented defaults without the helper."""
    path = os.environ.get("HERDR_CONFIG_PATH") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
        "herdr", "config.toml")
    helper = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                          "herdr-bindings.py")
    try:
        if text is None:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        loader = importlib.machinery.SourceFileLoader("herdr_bindings", helper)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        pairs = mod.describe_digits(text)
    except FileNotFoundError:
        pairs = [("Ctrl+B 1..9", "switch tab")] if os.path.isfile(helper) else []
    except Exception:
        pairs = []
    if not pairs:
        return [("Ctrl+B 1..9", "jump (see Herdr config)")]
    return [(keys, _DIGIT_WORDS.get(does, does)) for keys, does in pairs
            if does != "unbound"]


def help_screen():
    """Mobile key reference. Bindings mirror ~/.config/herdr/config.toml."""
    w = max(34, min(shutil.get_terminal_size(fallback=(48, 24)).columns, 48))
    inner = w - 2

    def fit(s, n):
        return s if len(s) <= n else s[: max(1, n - 1)] + "\u2026"

    rows = [
        ("N", "new shell in cwd"),
        ("I", "host/workspace info"),
        ("?", "show this help"),
        ("R", "refresh workspaces"),
        ("Q", "quit selector"),
        ("number + Enter", "attach workspace"),
        ("up/down + Enter", "select and attach"),
        ("Alt+D", "detach to selector"),
        ("Ctrl+B d", "detach fallback"),
        ("Ctrl+Home", "detach (host bridge)"),
    ] + digit_rows() + [
        ("Ctrl+B w", "workspace picker"),
        ("Ctrl+B n/p", "next / previous tab"),
        ("Alt+\u2190/\u2192", "previous / next tab"),
        ("Alt+\u2193", "next workspace (desktop)"),
        ("Alt+Enter", "split pane horizontal"),
        ("Alt+Shift+Enter", "split pane vertical"),
        ("Alt+Esc", "close pane"),
        ("Ctrl+B c", "new tab"),
        ("Ctrl+B shift+T", "rename tab"),
        ("Ctrl+B shift+X", "close tab"),
        ("Ctrl+B ?", "native Herdr help"),
    ]
    kcol = 18
    dbudget = inner - 4 - kcol
    if terminal_name() == "blink":           # no on-screen Home key there:
        rows = [r for r in rows if r[0] != "Ctrl+Home"]   # unproducible combo
    out = [f"{C_LIME}\u250c{line(inner)}\u2510{C_RESET}"]
    t = " HERDR // MOBILE KEYS"
    out.append(f"{C_LIME}\u2502{C_RESET}"
               + f"{C_WHITE}{fit(t, inner)}{C_RESET}"
               + " " * max(0, inner - len(t))
               + f"{C_LIME}\u2502{C_RESET}")
    out.append(f"{C_LIME}\u251c{line(inner)}\u2524{C_RESET}")
    for key, desc in rows:
        kfit = fit(key, kcol).ljust(kcol)
        dfit = fit(desc, dbudget)
        body = f" {C_LIME}{kfit}{C_RESET}{C_GRAY}{dfit}{C_RESET}"
        padn = max(0, inner - 2 - len(kfit) - len(dfit))
        out.append(f"{C_LIME}\u2502{C_RESET}" + body + " " * padn
                   + f" {C_LIME}\u2502{C_RESET}")
    out.append(f"{C_LIME}\u251c{line(inner)}\u2524{C_RESET}")
    notes = ["Menu letters: no Enter needed.",
             "Alt+arrows: desktop only.",
             "Alt+Up: reserved for Pi.",
             "Phone: Ctrl+B; ALT+digit.",
             "Alt+D or Ctrl+B then D detaches.",
             "Detach keeps workspaces and agents."]
    if terminal_name() == "blink":       # no on-screen Home key in Blink:
        notes[0:0] = ["Blink: no Home key on screen;",   # unproducible combo
                      "detach = tap ALT then D;",
                      "TENDRIL_TERMINAL=blink selects",
                      "these hints."]
    else:
        notes[1:1] = ["Ctrl+Home bridge: default on.",
                      "Mac: Fn+Ctrl+Left = Ctrl+Home.",   # stock Terminal/iTerm2
                      "No Home key? Ctrl+B then D.",      # send neither combo
                      "Disable on host with:",
                      "TENDRIL_DETACH_BRIDGE=0",
                      "(false/no/off/empty also disable)."]
    for note in notes:
        nfit = fit(note, inner - 2)
        out.append(f"{C_LIME}\u2502{C_RESET} {C_GRAY}{nfit}{C_RESET}"
                   + " " * max(0, inner - 1 - len(nfit))
                   + f"{C_LIME}\u2502{C_RESET}")
    out.append(f"{C_LIME}\u2514{line(inner)}\u2518{C_RESET}")
    # Keep the complete reference readable with the phone keyboard open.
    # Reserve three header rows, a bottom border, and one prompt row.
    page_size = max(1, shutil.get_terminal_size(fallback=(48, 24)).lines - 5)
    body = out[3:-1]
    for start in range(0, len(body), page_size):
        page = out[:3] + body[start:start + page_size] + out[-1:]
        print("\033[H\033[2J" + "\n".join(page), flush=True)
        action = "for more" if start + page_size < len(body) else "to return"
        print(f"{C_GRAY}press any key {action}...{C_RESET}", end="", flush=True)
        wait_for_key()


def info():
    host = tendril_host.short_hostname() if tendril_host else os.uname().nodename
    status, ip = tailscale_parts()
    ts = ip if status == "ACTIVE" else "down"
    if tendril_host:
        up = tendril_host.format_uptime(tendril_host.uptime_seconds(run))
        load = tendril_host.load_average()
        mem = tendril_host.memory_mb(run)
        bat = tendril_host.battery(run)
    else:
        up, load, mem, bat = "?", ("?", "?", "?"), None, ""
    disk = run(["df", "-h", "/"], 3)[1].splitlines()[-1:] or [""]
    disk = disk[0].split()
    rows = collect() or []
    nws = len(rows)
    counts = {}
    for r in rows:
        for a in r["agents"]:
            counts[a.get("agent", "?")] = counts.get(a.get("agent", "?"), 0) + 1
    agents = " ".join(f"{k}:{v}" for k, v in sorted(counts.items())) or "none"
    memtxt = f"{mem[0]}/{mem[1]}M free" if mem else "n/a"
    print(f"{C_LIME}{host}{C_RESET}  {C_GRAY}tailscale{C_RESET} {C_TEAL}{ts}{C_RESET}"
          f"  {C_GRAY}battery {bat or 'n/a'}{C_RESET}")
    print(f"{C_GRAY}up {up}{C_RESET}")
    print(f"{C_GRAY}load {load[0]} {load[1]} {load[2]}   "
          f"mem {memtxt}   "
          f"disk {disk[2] if len(disk) > 2 else '?'} used{C_RESET}")
    print(f"{C_GRAY}herdr {nws} workspaces   agents {agents}{C_RESET}")
    env_ok = os.path.isfile(os.path.expanduser("~/.config/remote-agents/notify.env"))
    push = f"{C_TEAL}ACTIVE{C_RESET}" if env_ok else f"{C_GRAY}NOT CONFIGURED{C_RESET}"
    svc = tendril_host.backend(run) if tendril_host else None
    running = bool(svc) and svc.status() == "running"
    watch = f"{C_TEAL}RUNNING{C_RESET}" if running else f"{C_GRAY}STOPPED{C_RESET}"
    print(f"{C_GRAY}Push       {push}{C_RESET}   {C_GRAY}Watcher    {watch}{C_RESET}")
    print(f"{C_GRAY}press any key to continue...{C_RESET}", end="", flush=True)
    wait_for_key()


def workspace_number(raw, count):
    if not raw or not raw.isdigit():
        return None
    try:
        number = int(raw)
    except ValueError:
        return None
    return number - 1 if 1 <= number <= count else None


def menu_loop(rows, tty_mode=False, fd=None, note="", preferred_id=None):
    """The selector loop — the one loop every entry path ends in (the bare
    selector, and `enter` after its attach detaches). note is shown once
    above the footer (the enter verb's stale notice); preferred_id
    preselects a workspace row (enter's parent workspace after a stale
    pane). Returns 0 when the user quits."""
    selected = selection_index(rows, preferred_id)
    while True:
        render(rows, note, selected)
        note = ""
        try:
            kind, raw = read_menu_action(tty_mode, fd)
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if kind == "eof":
            print()
            return 0
        if kind == "navigate":
            if not rows:
                note = "no workspaces to select"
            else:
                selected = move_selection(rows, selected,
                                          -1 if raw == "up" else 1)
            continue

        previous_id = rows[selected]["id"] if selected is not None else None
        previous_index = selected
        preferred_id = previous_id
        if kind == "enter":
            if selected is None:
                note = "no workspaces to attach"
            else:
                attach(rows[selected])
        elif raw == "":
            # Preserve the line-oriented no-op for piped/non-TTY input.
            continue
        elif raw.isdigit():
            index = workspace_number(raw, len(rows))
            if index is None:
                note = "no workspaces to attach" if not rows else f"no workspace {raw}"
            else:
                preferred_id = rows[index]["id"]
                attach(rows[index])
        elif raw.lower() == "q":
            return 0
        elif raw.lower() == "r":
            pass
        elif raw.lower() == "n":
            preferred_id = new_workspace(rows, selected) or preferred_id
        elif raw.lower() == "i":
            info()
        elif raw == "?":
            help_screen()
        else:
            note = f"unknown: {raw}"

        refreshed = collect()
        if refreshed is not None:
            rows = refreshed
            selected = selection_index(rows, preferred_id, previous_index)


# ---------- direct addressing: attach/enter/resolve/focus/link <token> ----------
# A TENDRIL session is addressable without the selector. The canonical token
# is the herdr workspace_id ("w15"); pane ids ("w15:p1") address that exact
# pane, pure digits the workspace number, and an exact case-sensitive label
# as the last resort. The subcommands are the machine interface (phone
# shortcuts, deep links, notification taps): non-interactive, safe over SSH.
PANE_RE = re.compile(r"^[A-Za-z0-9]+:[A-Za-z0-9]+$")
MAX_TOKEN = 129                             # beyond this the token is junk
SUBCOMMANDS = ("attach", "enter", "resolve", "focus", "link")
_RANK_NAME = {rank: name for name, rank in RANK.items()}
STALE_NOTE = "That agent session has ended — choose another."


def _pane_lookup(token):
    """Live snapshot entry for a pane-shaped token, else None (stale).
    One extra `herdr api snapshot`: collect() keeps only workspace rows,
    and exact focus needs the pane's tab_id/workspace_id."""
    if not PANE_RE.match(token):
        return None
    snap = snapshot()
    if not snap:
        return None
    for p in snap.get("panes", []):
        if p.get("pane_id") == token:
            return p
    return None


def _focus_pane(pane):
    """Exact focus: workspace -> tab -> pane, then VERIFY against the
    snapshot's focused_pane_id. `herdr agent focus <pane_id>` is the CLI's
    exact-pane focus (agent commands accept the pane hosting the agent);
    panes without a recognized agent rely on the preceding tab focus
    landing on the tab's own pane. False when verification cannot confirm
    the pane is focused — the caller must treat it as stale and never
    attach blind."""
    pane_id = pane.get("pane_id") or ""
    tab_id = pane.get("tab_id") or ""
    ws_id = pane.get("workspace_id") or pane_id.split(":", 1)[0]
    run([HERDR, "workspace", "focus", ws_id], 6)
    if tab_id:
        run([HERDR, "tab", "focus", tab_id], 6)
    run([HERDR, "agent", "focus", pane_id], 6)
    snap = snapshot()
    return bool(snap) and snap.get("focused_pane_id") == pane_id


def _selector_after(rows, note="", preferred_id=None):
    """The selector loop, in this process — the single entry every attach
    path falls back to. No re-exec, no recursion, no double selector."""
    tty_mode = sys.stdin.isatty()
    fd = sys.stdin.fileno() if tty_mode else None
    return menu_loop(rows, tty_mode, fd, note=note, preferred_id=preferred_id)


def _stale_pane_selector(rows, token):
    """A stale (vanished or unverifiable) pane must never attach — not even
    to its parent workspace's focused tab, which may be a different agent.
    Open the selector in-process with a one-line notice, the parent
    workspace preselected when it still exists."""
    parent = token.split(":", 1)[0] if PANE_RE.match(token) else token
    fresh = collect()
    if fresh is None:
        fresh = rows
    preselect = parent if any(r["id"] == parent for r in fresh) else None
    return _selector_after(fresh, note=STALE_NOTE, preferred_id=preselect)


def resolve_token(rows, token):
    """(row, None) or (None, ("unknown"|"ambiguous", matching rows)).

    Pure over `rows` — no I/O. Token order: exact workspace_id (canonical,
    case-sensitive), pane id -> parent workspace, pure digits -> workspace
    number, then an exact unique label. Empty/oversized tokens and unknown
    (possibly stale) ids come back as ("unknown", []); a label shared by
    several workspaces as ("ambiguous", hits)."""
    token = token or ""
    if not token or len(token) > MAX_TOKEN:
        return None, ("unknown", [])
    for r in rows:
        if r["id"] == token:
            return r, None
    if PANE_RE.match(token):                # "w15:p1" -> workspace "w15"
        parent = token.split(":", 1)[0]
        for r in rows:
            if r["id"] == parent:
                return r, None
    if token.isascii() and token.isdigit():
        hits = [r for r in rows if r.get("number") == int(token)]
        if len(hits) == 1:
            return hits[0], None
        if len(hits) > 1:
            return None, ("ambiguous", hits)
    hits = [r for r in rows if r.get("label") == token]
    if len(hits) == 1:
        return hits[0], None
    if len(hits) > 1:
        return None, ("ambiguous", hits)
    return None, ("unknown", [])


def _reachable_rows():
    """(rows, 0) or (None, 1) — the shared 'can we talk to Herdr?' gate."""
    if not HERDR:
        print(f"{C_RED}no compatible herdr client found{C_RESET}")
        for cand, ok, detail in HERDR_VERDICTS:
            print(f"  [{'ok' if ok else 'REJECT'}] {cand}: {detail}")
        return None, 1
    rows = collect()
    if rows is None:
        print(f"{C_RED}cannot reach the Herdr server.{C_RESET} "
              f"{C_GRAY}Is it running? Try: herdr status{C_RESET}")
        return None, 1
    return rows, 0


def _close_rows(rows, token):
    """Up to 5 near-miss rows (matched on id or label) for unknown tokens."""
    names = {}
    for r in rows:
        names.setdefault(r["id"], r)
        names.setdefault(r["label"], r)
    near = difflib.get_close_matches(token, list(names), n=5, cutoff=0.5)
    if not near:
        low = token.lower()
        near = [n for n in names if low in n.lower()][:5]
    return [names[n] for n in near]


def _resolve_session(rows, token):
    """(row, 0) or (None, exit-code), with a diagnostic on stderr."""
    row, failure = resolve_token(rows, token)
    if row is not None:
        return row, 0
    kind, hits = failure
    if kind == "ambiguous":
        print(f"{C_RED}'{token}' matches several sessions:{C_RESET}", file=sys.stderr)
        for r in hits[:5]:
            print(f"  {r['id']}  {r['label']}", file=sys.stderr)
        return None, 3
    print(f"{C_RED}no session matches '{token}' on {HOST_LABEL} "
          f"(stale id? the workspace may be gone){C_RESET}", file=sys.stderr)
    for r in _close_rows(rows, token):
        print(f"{C_GRAY}  closest: {r['id']}  {r['label']}{C_RESET}", file=sys.stderr)
    return None, 2


def _session_link(row, pane=None):
    """tendril_link.describe() for a row -- narrowed to the exact pane
    when one is given -- or None with a diagnostic."""
    if tendril_link is None:
        print(f"{C_RED}tendril_link missing next to remote-agents - re-run install{C_RESET}",
              file=sys.stderr)
        return None
    try:
        return tendril_link.describe(HOST_LABEL, row["id"], row["label"],
                                     pane)
    except tendril_link.LinkError as exc:
        print(f"{C_RED}link error: {exc}{C_RESET}", file=sys.stderr)
        return None


def _herdr_running():
    '"running" when `herdr status` says so, "unknown" otherwise (best effort).'
    rc, out, err = run([HERDR, "status"], 6)
    if rc == 0 and re.search(r"status:\s*running", (out or "") + (err or "")):
        return "running"
    return "unknown"


def session_json(row, pane=None):
    """One-line canonical JSON for resolve/focus: everything a notification
    or deep-link consumer needs. link/payload_b64 come from tendril_link.
    With a live pane entry (pane-id tokens), pane_id/tab_id name the exact
    pane and agent is THAT pane's agent, not the workspace's first."""
    link = _session_link(row, pane.get("pane_id") if pane else None)
    if link is None:
        return None
    doc = {
        "host": HOST_LABEL,
        "workspace_id": row["id"],
        "label": row["label"],
        "number": row["number"],
        "cwd": row["path"] or "",
        "agent": (row["agents"][0].get("agent") or "") if row["agents"] else "",
        "agent_status": _RANK_NAME.get(row.get("rank", 4), "unknown"),
        "agents": [{"agent": a.get("agent") or "",
                    "agent_status": a.get("agent_status") or "unknown",
                    "pane_id": a.get("pane_id") or ""} for a in row["agents"]],
        "focused": bool(row.get("focused")),
        "link": link["uri"],
        "payload_b64": link["payload_b64"],
        "herdr_status": _herdr_running(),
    }
    if pane is not None:
        doc["pane_id"] = pane.get("pane_id") or ""
        doc["tab_id"] = pane.get("tab_id") or ""
        doc["agent"] = pane.get("agent") or ""
    return json.dumps(doc, separators=(",", ":"))


def _stale_pane_not_found(rows, token):
    """The existing not-found path for a stale pane id: diagnostic + closest
    live ids on stderr, non-zero exit (TEST LINK reports SESSION NOT FOUND)."""
    print(f"{C_RED}no session matches '{token}' on {HOST_LABEL} "
          f"(stale id? the agent session may have ended){C_RESET}", file=sys.stderr)
    for r in _close_rows(rows, token):
        print(f"{C_GRAY}  closest: {r['id']}  {r['label']}{C_RESET}", file=sys.stderr)
    return 2


def _enter_session(rows, token):
    """enter <token> -- the notification entry lifecycle: resolve, exact
    focus (verified), the same Ctrl+Home-bridged attach the selector uses,
    then -- when the user detaches -- the normal selector loop in this same
    process. A stale pane attaches nothing: the selector opens with a
    one-line notice, the parent workspace preselected when it still exists."""
    if PANE_RE.match(token):
        pane = _pane_lookup(token)
        row = None
        if pane is not None:
            parent = pane.get("workspace_id") or token.split(":", 1)[0]
            row, _ = resolve_token(rows, parent)
        if pane is None or row is None:
            return _stale_pane_selector(rows, token)
        if not attach(row, pane=pane):      # focus not verifiable: stale
            return _stale_pane_selector(rows, token)
    else:
        row, code = _resolve_session(rows, token)
        if row is None:
            return code
        attach(row)                         # workspace semantics, unchanged
    fresh = collect()
    if fresh is None:
        fresh = rows
    return _selector_after(fresh, preferred_id=row["id"])


def _run_subcommand(cmd, token):
    """attach/enter/resolve/focus/link: never interactive (enter falls into
    the selector only after its attach detaches), safe over plain SSH.
    Exit codes: 0 ok, 1 Herdr unreachable, 2 unknown/stale token, 3 ambiguous.
    Pane ids are exact: the pane must exist (else the not-found path) and
    focus verifies against the snapshot before anything attaches."""
    rows, code = _reachable_rows()
    if rows is None:
        return code
    if cmd == "enter":
        return _enter_session(rows, token)
    pane = None
    if cmd in ("attach", "resolve", "focus") and PANE_RE.match(token):
        pane = _pane_lookup(token)
        if pane is None:
            return _stale_pane_not_found(rows, token)
    row, code = _resolve_session(rows, token)
    if row is None:
        return code
    if cmd == "attach":
        print(f"{C_GRAY}found session '{row['label']}' ({row['id']}){C_RESET}", flush=True)
        attach(row, pane=pane)
        return 0
    if cmd == "link":
        link = _session_link(row)
        if link is None:
            return 2
        print(link["uri"])
        return 0
    doc = session_json(row, pane=pane)      # resolve and focus print the same body
    if doc is None:
        return 2
    if cmd == "focus":                      # headless hook: focus only, no session attach
        if pane is not None:
            if not _focus_pane(pane):
                print(f"{C_RED}could not verify focus for '{token}' "
                      f"-- treat it as stale{C_RESET}", file=sys.stderr)
                return 2
        else:
            run([HERDR, "workspace", "focus", row["id"]], 6)
    print(doc)
    return 0


SERVICE_VERBS = ("status", "start", "stop", "restart", "logs")


def _service(args):
    """`tendril service <verb>`: the notification watcher, on whichever
    service manager this host has (launchd LaunchAgent / systemd user unit)."""
    if len(args) != 1 or args[0] not in SERVICE_VERBS:
        print("usage: remote-agents service " + "|".join(SERVICE_VERBS),
              file=sys.stderr)
        return 2
    if tendril_host is None:
        print("tendril_host.py is missing next to remote-agents; re-run ./install",
              file=sys.stderr)
        return 1
    return tendril_host.main(["service", args[0]])


def _pair_ssh_target():
    """Where the phone dials: config SSH_TARGET -> the Tailscale MagicDNS
    FQDN when answerable -> config SSH_ALIAS -> the host identity itself
    (binding contract; display-only in the Link app, dialled by the block
    `--pair` prints)."""
    target = (CONFIG.get("SSH_TARGET") or "").strip()
    if target:
        return target
    if tendril_host is not None:
        try:
            fqdn = tendril_host.tailscale_identity()[1]
        except Exception:                       # never let pairing crash on it
            fqdn = ""
        if fqdn:
            return fqdn
    return (CONFIG.get("SSH_ALIAS") or "").strip() \
        or (tendril_link.host_identity(CONFIG)
            if tendril_link is not None and hasattr(tendril_link, "host_identity")
            else HOST_LABEL)


def _pair_source_dir():
    """The checkout the launchers are copied from: install.json provenance
    first, then the checkout this command runs from (realpath), but only
    when it actually contains phone/tendril. None when nothing is provable."""
    try:
        with open(os.path.expanduser(
                "~/.config/remote-agents/install.json"), encoding="utf-8") as f:
            src = (json.load(f) or {}).get("source_dir")
        if src and os.path.isfile(os.path.join(src, "phone", "tendril")):
            return src
    except (OSError, ValueError):
        pass
    repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    if os.path.isfile(os.path.join(repo, "phone", "tendril")):
        return repo
    return None


def _notify_subscribe_url():
    """ntfy server/topic from notify.env, joined for a subscribe URL —
    printed so the phone can subscribe; never encoded into any payload."""
    url = topic = ""
    try:
        with open(NOTIFY_ENV, encoding="utf-8") as f:
            for ln in f:
                ln = ln.strip()
                if ln.startswith("NTFY_URL="):
                    url = ln.split("=", 1)[1].strip().strip('"').strip("'")
                elif ln.startswith("NTFY_TOPIC="):
                    topic = ln.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return f"{url}/{topic}" if url and topic else ""


def _pair_print(code, host, target, user):
    """The human block: identity summary, code, optional QR (only when
    qrencode is on PATH; never a dependency), the ntfy subscribe URL, and
    a paste-ready Termux setup with every value filled in."""
    reach = f"{user}@{target}"
    transport = "Tailscale + Mosh" if shutil.which("mosh") else "Tailscale + SSH"
    print(f"{C_LIME}TENDRIL // PHONE PAIRING{C_RESET}")
    print(f"{C_GRAY}  Host     {C_RESET}{host}")
    print(f"{C_GRAY}  Reach    {C_RESET}{reach}  ({transport})")
    print(f"{C_GRAY}  Pairing  {C_RESET}{code}")
    qrencode = shutil.which("qrencode")
    if qrencode:
        try:
            qr = subprocess.run([qrencode, "-t", "ansiutf8", code],
                                capture_output=True, text=True, timeout=15)
            if qr.returncode == 0 and qr.stdout:
                print(qr.stdout.rstrip("\n"))
        except (OSError, subprocess.TimeoutExpired):
            pass                            # QR is garnish, never load-bearing
    subscribe = _notify_subscribe_url()
    if subscribe:
        print(f"{C_GRAY}  ntfy: subscribe to {C_RESET}{subscribe}")
    else:
        print(f"{C_GRAY}  ntfy: not configured ({NOTIFY_ENV}); "
              f"push setup: re-run ./install{C_RESET}")
    src = _pair_source_dir()
    print("")
    print("Termux setup (paste into Termux):")
    lines = [
        "pkg install -y openssh mosh",
        "[ -f ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519",
        f"ssh-copy-id {reach}",
        "mkdir -p ~/bin ~/.config/tendril",
    ]
    if src:
        lines += [
            f"scp {shlex.quote(f'{reach}:{src}/phone/tendril')} ~/bin/tendril",
            f"scp {shlex.quote(f'{reach}:{src}/phone/termux-url-opener')} ~/bin/termux-url-opener",
        ]
    else:
        lines += [
            "# no recorded source checkout: copy phone/tendril and",
            "# phone/termux-url-opener from your TENDRIL checkout to ~/bin/ first",
        ]
    lines += [
        "chmod 700 ~/bin/tendril ~/bin/termux-url-opener",
        f"printf '%s\\n' '{reach}' > ~/.config/tendril/alias",
        "hash -r && tendril",
    ]
    for ln in lines:
        print(f"  {ln}")
    if subscribe:
        print("")
        print(f"Then subscribe the ntfy app to: {subscribe}")
    return 0


def _pair(args):
    """`tendril --pair`: the phone pairing code for the TENDRIL Link app,
    plus the setup block. Deliberately flags-only like --upgrade — no bare
    `pair` word: a single word is a session-token position and a workspace
    may legitimately be labeled "pair". All payload values are validated;
    on any invalid value: one clear error, no code."""
    rest = [a for a in args if a != "--pair"]
    code_only = "--code" in rest
    rest = [a for a in rest if a != "--code"]
    if rest or args.count("--pair") != 1:
        print("usage: tendril --pair [--code]", file=sys.stderr)
        return 2
    if tendril_link is None or not hasattr(tendril_link, "pairing_code"):
        print("tendril_link.py is missing or stale next to remote-agents; "
              "re-run ./install", file=sys.stderr)
        return 1
    host = tendril_link.host_identity(CONFIG)
    target = _pair_ssh_target()
    try:
        user = getpass.getuser() or ""
    except Exception:
        user = ""
    try:
        code = tendril_link.pairing_code(host, target, user)
    except tendril_link.LinkError as exc:
        print(f"cannot pair: {exc}", file=sys.stderr)
        return 1
    if code_only:
        print(code)
        return 0
    return _pair_print(code, host, target, user)


HELP = """\
TENDRIL host console (remote-agents) — a thin mobile control plane for
persistent AI agents.

  tendril                     the workspace selector (the console)
  tendril attach|enter|resolve|focus|link <token>
                              direct addressing: workspace id (w15), pane id
                              (w15:p1), workspace number, or exact label
  tendril service status|start|stop|restart|logs
                              the notification watcher, on launchd or systemd
  tendril --pair [--code]
                              the phone pairing code for the TENDRIL Link
                              app (scan or paste), the ntfy subscribe URL
                              and a paste-ready Termux setup block; --code
                              prints only the code (for scripting)
  tendril --upgrade [--verbose]
                              self-update: fetch + fast-forward the recorded
                              source checkout, then ./install --upgrade
                              (binaries, symlink, PATH block, watcher unit;
                              config and notify.env stay byte-identical)
  tendril --version           the installed version and commit
  tendril --help              this help

Upgrade and pair are flags-only on purpose: a bare word is a session-token
position and a workspace may legitimately be labeled "upgrade" or "pair".
Also:
  --detect                    herdr client detection detail
"""


def _upgrade(args):
    """`tendril --upgrade`: self-update from the recorded source checkout.
    Deliberately flags-only — no bare `upgrade` word: a single word is a
    session-token position and a workspace may legitimately be labeled
    "upgrade"; --upgrade cannot collide."""
    verbose = "--verbose" in args
    extra = [a for a in args if a not in ("--upgrade", "--verbose")]
    if extra or args.count("--upgrade") != 1:
        print("usage: tendril --upgrade [--verbose]", file=sys.stderr)
        return 2
    if tendril_upgrade is None:
        print("tendril_upgrade.py is missing next to remote-agents; re-run ./install",
              file=sys.stderr)
        return 1
    return tendril_upgrade.upgrade_main(verbose=verbose)


def main():
    if "--detect" in sys.argv:
        for cand, ok, detail in HERDR_VERDICTS:
            tag = "SELECTED" if cand == HERDR else ("REJECT" if not ok else "skip  ")
            print(f"[{tag}] {cand}\n        {detail}")
        print("chosen:", HERDR or "NONE")
        return 0
    args = sys.argv[1:]
    if "--version" in args:
        if tendril_upgrade is not None:
            print(tendril_upgrade.version_line())
        else:
            print("tendril (unknown - tendril_upgrade.py missing; re-run ./install)")
        return 0
    if "--help" in args or "-h" in args:
        print(HELP, end="")
        return 0
    if "--upgrade" in args:
        return _upgrade(args)
    if "--pair" in args:
        return _pair(args)
    if args[:1] == ["service"]:
        return _service(args[1:])
    if len(args) == 2 and args[0] in SUBCOMMANDS:
        return _run_subcommand(args[0], args[1])
    if args:
        print("usage: remote-agents [attach|enter|resolve|focus|link] <session-token>",
              file=sys.stderr)
        print("       <session-token>: workspace id (w15), pane id (w15:p1),",
              file=sys.stderr)
        print("       workspace number or exact label; no args opens the selector",
              file=sys.stderr)
        print("       enter: exact focus + attach, then the selector (notification taps)",
              file=sys.stderr)
        print("       remote-agents service status|start|stop|restart|logs",
              file=sys.stderr)
        print("       remote-agents --pair [--code] | --upgrade [--verbose] "
              "| --version | --help",
              file=sys.stderr)
        return 2
    rows, code = _reachable_rows()
    if rows is None:
        return code
    tty_mode = sys.stdin.isatty()
    fd = sys.stdin.fileno() if tty_mode else None
    return menu_loop(rows, tty_mode, fd)


if __name__ == "__main__":
    sys.exit(main())
