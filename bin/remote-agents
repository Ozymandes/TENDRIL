#!/usr/bin/env python3
"""remote-agents — TENDRIL host console: mobile ops for Herdr workspaces.

One call to `herdr api snapshot` powers the whole menu. No config files,
no daemon, no tmux. Built for narrow Android screens (Termux + Mosh/SSH).
"""
import contextlib
import difflib
import getpass
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import select
import shutil
import subprocess
import sys
import time
import unicodedata

# ---------- RC2 perf: launch trace ---------------------------------------
# phone/tendril writes the SAME file name on the device, so both wall-clock
# epoch_ms logs interleave into one merged timeline (docs/LATENCY.md).
# ZERO cost when off: one env lookup + one stat at import, then an early
# return per stage. Stages only — never hostnames, tokens or prompt text.
_TRACE_ON = (os.environ.get("TENDRIL_TRACE") == "1"
             or os.path.isfile(os.path.expanduser(
                 "~/.config/remote-agents/trace")))


def _trace(stage):
    """Append `<epoch_ms> <stage>` to ~/.cache/tendril/launch.log (0600)."""
    if not _TRACE_ON:
        return
    try:
        d = os.path.expanduser("~/.cache/tendril")
        os.makedirs(d, exist_ok=True)
        fd = os.open(os.path.join(d, "launch.log"),
                     os.O_WRONLY | os.O_CREAT | os.O_APPEND
                     | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, ("%d %s\n" % (int(time.time() * 1000), stage))
                    .encode())
        finally:
            os.close(fd)
    except OSError:
        pass


_trace("process-start")          # before the heavy imports below

# ---------- portable configuration ----------
CONFIG_SEARCH = [
    os.environ.get("REMOTE_AGENTS_CONFIG"),
    os.path.expanduser("~/.config/remote-agents/config"),
]


def load_config():
    for path in CONFIG_SEARCH:
        if path and os.path.isfile(path):
            cfg = {}
            with open(path) as f:
                for ln in f:
                    ln = ln.strip()
                    if ln and not ln.startswith("#") and "=" in ln:
                        k, v = ln.split("=", 1)
                        cfg[k.strip()] = v.strip().strip('"').strip("'")
            return cfg
    return {}


CONFIG = load_config()


def _root_list(key, defaults):
    raw = CONFIG.get(key, "").strip()
    if raw:
        return [os.path.expanduser(x.strip()) for x in raw.split(":") if x.strip()]
    return [os.path.expanduser(d) for d in defaults]


PROJECT_ROOTS = _root_list("PROJECT_ROOTS",
                           ["~/Projects", "~/src", "~/dev", "~/code", "~"])
NOTIFY_BIN = os.path.expanduser(CONFIG.get("NOTIFY_BIN")
                                or "~/.local/bin/herdr-notify")

# ---------- canonical deep links (tendril-link, installed next to us) ----------
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import tendril_link          # payload/uri codec for session addresses
except ImportError:              # stale install: the selector keeps working
    tendril_link = None
try:
    import tendril_host          # the few host facts/lifecycle verbs per OS
except ImportError:
    tendril_host = None
try:
    import tendril_upgrade       # --version / --upgrade (thin dispatch below)
except ImportError:
    tendril_upgrade = None
try:
    import tendril_phone         # --phone-* / --link-stage (thin dispatch below)
except ImportError:
    tendril_phone = None
try:
    import tendril_telemetry     # schema v2 per-agent telemetry (read-only)
except ImportError:              # stale install: v2 shape, no telemetry
    tendril_telemetry = None
try:
    import tendril_herdr         # the ONE §7.4 herdr binary resolver
except ImportError:              # stale install: the selector keeps working
    tendril_herdr = None
try:
    import tendril_enroll        # v0.2.1 one-shot phone enrollment (pairing v3)
except ImportError:
    tendril_enroll = None
try:
    import tendril_qr            # v0.2.1 built-in pairing QR (no qrencode needed)
except ImportError:
    tendril_qr = None

# Canonical host identity (binding contract): config TENDRIL_HOST -> legacy
# TAILSCALE_HOST (lowercased) -> short hostname, HOST_RE-gated, sanitized —
# the single name every deep link, notification and pairing code uses.
if tendril_link is not None and hasattr(tendril_link, "host_identity"):
    HOST_LABEL = tendril_link.host_identity(CONFIG)
else:  # stale install without the resolver: the pre-contract behavior
    HOST_LABEL = CONFIG.get("TAILSCALE_HOST") or (
        tendril_host.short_hostname() if tendril_host else os.uname().nodename)

NOTIFY_ENV = (os.environ.get("NOTIFY_ENV")
              or os.path.expanduser("~/.config/remote-agents/notify.env"))


# ---------- Herdr client resolution (ONE resolver, LINK-CONTRACT §7.4) ----------
# Resolution order: recorded config HERDR_BIN → $HERDR_BIN → protocol-verified
# newest-compatible detection (PATH, ~/.local/bin, mise, asdf, brew, /usr).
# "First on PATH wins" is gone: that is how a stale /usr/bin/herdr ended up
# driving a newer mise server. Services get the recorded path via the
# installer-written service.env (see systemd/*.service + ./install).
HERDR_DIRS = ("~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin")

if tendril_herdr is not None:
    try:
        _HERDR_RESOLVED = tendril_herdr.resolve(config=CONFIG,
                                                env=os.environ)
    except Exception:              # the selector must never die on resolve
        _HERDR_RESOLVED = {"bin": None, "provenance": "missing",
                           "version": None, "verdicts": [], "stale": False,
                           "realpath": None}
    HERDR = _HERDR_RESOLVED["bin"]
    HERDR_VERDICTS = _HERDR_RESOLVED["verdicts"]
    HERDR_PROVENANCE = _HERDR_RESOLVED["provenance"]  # recorded|detected|missing
    HERDR_CLIENT_VERSION = _HERDR_RESOLVED["version"]  # resolved binary's own
    # §7.4: a recorded value existed but was superseded (vanished path, or
    # a newer running server) — health shows tendril degraded + hint.
    HERDR_STALE = bool(_HERDR_RESOLVED.get("stale"))
else:                            # stale install without the resolver module
    def _stale_herdr():          # recorded → PATH → fixed dirs, first runnable
        for cand in (CONFIG.get("HERDR_BIN"), os.environ.get("HERDR_BIN")):
            cand = os.path.expanduser(cand or "")
            if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
                return cand
        found = shutil.which("herdr")
        if found:
            return found
        for d in HERDR_DIRS:
            p = os.path.join(os.path.expanduser(d), "herdr")
            if os.path.isfile(p) and os.access(p, os.X_OK):
                return p
        return None
    HERDR = _stale_herdr()
    HERDR_VERDICTS = []
    HERDR_PROVENANCE = "recorded" if CONFIG.get("HERDR_BIN") else (
        "detected" if HERDR else "missing")
    HERDR_CLIENT_VERSION = None
    HERDR_STALE = HERDR_PROVENANCE == "detected" and bool(CONFIG.get("HERDR_BIN"))
_trace("resolve-done")           # the §7.4 herdr resolver finished
SESSION = "default"
CACHE_DIR = os.path.expanduser("~/.cache/remote-agents")
EXTRA_PATH = ":".join([
    os.path.expanduser("~/.local/bin"),
    os.path.expanduser("~/.local/share/mise/shims"),
    os.path.expanduser("~/.local/share/mise/installs/pi/latest/pi"),
    os.path.expanduser("~/.local/share/mise/installs/claude/latest"),
    os.path.expanduser("~/.local/share/mise/installs/codex/latest/bin"),
    "/opt/homebrew/bin",           # Homebrew (Apple Silicon / Intel): agents
    "/usr/local/bin",              # installed there are absent from SSH PATH
])
os.environ["PATH"] = os.environ.get("PATH", "") + ":" + EXTRA_PATH

RANK = {"working": 0, "blocked": 1, "done": 2, "idle": 3, "unknown": 4}
ICON = {"working": "\u25cf", "blocked": "\u25c6", "done": "\u2713",
        "idle": "\u25cb", "unknown": "\u25cb"}
SHORT = {"pi": "PI", "claude": "CL", "codex": "CX", "gemini": "GE",
         "cursor": "CU", "opencode": "OC", "copilot": "CP"}

# ---------- terminal capability model (deliberately small) ----------
def terminal_name(env=None):
    """'termux' | 'blink' | generic terminal family name.

    TERMUX_VERSION only arrives when the user forwards it (ssh SendEnv /
    AcceptEnv): stock OpenSSH sends just TERM and LC_*, and mosh only its
    colour count and locale. Everything else is opt-in: users who want terminal-aware hints set
    TENDRIL_TERMINAL=blink (Blink Shell) — Blink sends no distinguishing
    env over SSH. Unknown values pass through as-is so future clients
    need no code change."""
    if env is None:
        env = os.environ
    if env.get("TERMUX_VERSION"):
        return "termux"                        # self-identified; wins
    custom = (env.get("TENDRIL_TERMINAL") or "").strip().lower()
    if re.match(r"^[a-z0-9_-]{1,24}$", custom):
        return custom
    return "generic"


def pick_palette(colorterm):
    """(lime, teal, gray, red): truecolor where the terminal advertises it
    (COLORTERM), else the nearest 256-colour approximations. mosh < 1.4
    silently drops 38;2;r;g;b sequences (Ubuntu 22.04 ships 1.3.2), which
    rendered the whole phone UI monochrome; the 256-colour entries survive
    every transport. COLORTERM proves the terminal, not the transport: a
    COLORTERM forwarded into mosh < 1.4 still loses 38;2. Desktop terminals
    need no special case: Apple Terminal sets no COLORTERM (256 colours);
    iTerm2, Ghostty, WezTerm and kitty advertise truecolor."""
    if (colorterm or "").lower() in ("truecolor", "24bit"):
        return ("\033[38;2;203;253;117m", "\033[38;2;47;179;196m",
                "\033[38;2;112;128;136m", "\033[38;2;232;92;111m")
    return ("\033[38;5;191m", "\033[38;5;73m",           # #d7ff87 ~ #CBFD75
            "\033[38;5;244m", "\033[38;5;203m")         # #808080 ~ #708088, #ff5f5f ~ #E85C6F


def color_enabled(isatty, no_color, term):
    """Colour on real ttys only: NO_COLOR disables, so does TERM=dumb."""
    return isatty and no_color is None and term != "dumb"


C_RESET = "\033[0m"
C_WHITE = "\033[97m"
_PALETTE = pick_palette(os.environ.get("COLORTERM"))
C_LIME, C_TEAL, C_GRAY, C_RED = _PALETTE
COLOR = color_enabled(sys.stdout.isatty(), os.environ.get("NO_COLOR"),
                      os.environ.get("TERM", ""))
if not COLOR:
    C_RESET = C_LIME = C_TEAL = C_GRAY = C_WHITE = C_RED = ""


# ---------------- masthead (Unicode quadrant blocks, 2x2 per cell) ----------------
_MASTHEAD = (
    # (min columns, lines, slogan (row, col, text))
    # generated by assets/masthead/build_masthead.py --embed
    (50, (  # full
        "     ▀",
        "   ▗▖▀▗▖",
        " ▄ █▌█▐█ ▄  ▀▀█▛▀▗█▀▀▀▘▜▙▄ █▌█▛▀▀█▖▀▀▀▀█▌█▌██",
        "█▘▟▀ █ ▀▙▝█   █▌ ▐█▄▄▄ █▛█▙█▌█▌  █▌▄▄▄▄▛▘█▌██",
        "▀▐▌▗▟ ▙▖▐▌▀   █▌ ▐█    █▌ ▀█▌█▌  █▌█▌▝█▙ █▌██",
        "  ▀▐▌▀▐▌▀     ▀▘ ▝▀▀▀▀ ▀▘  ▀▘▀▀▀▀▀ ▀▘  ▀▘▀▘▀▀▀▀▀▀▘",
        "   ▝▘▀▝▘",
        "     ▀",
    ), (7, 14, 'T H E   E D G E   I S   Y O U R S')),
    (44, (  # compact
        "    ▄",
        "  ▄▌▄▐▄   ▄▄▄▄ ▄▄▄▄▗▄ ▗▄▗▄▄▄▖▗▄▄▄▄▗▄▗▄",
        "▟▘█▘█▝█▝▙  ▐█ ▐█   ▗██▐█▐▌ ▐█   ▐█▐█▐█",
        "▌▛▗▛▄▜▖▜▐  ▐█ ▐█▀▀▘▐█▝▜█▐▌ ▐█▐█▜█ ▐█▐█",
        " ▀ ▌▄▐ ▀   ▝▀ ▝▀▀▀▘▝▀ ▝▀▝▀▀▀▘▝▀ ▝▀▝▀▝▀▀▀▀▘",
        "    ▄",
    ), (6, 11, 'T H E  E D G E  I S  Y O U R S')),
)
_SLOGAN = "THE EDGE IS YOURS"


def masthead(width, body):
    """Masthead + slogan lines plus the blank separator row, centred over a
    box `width` wide that sits above `body` screen lines. The menu always
    wins: the mark steps down a tier, then to a caption (+ slogan), then
    disappears if it would push the selector or prompt off screen."""
    if not COLOR:
        return []
    rows = shutil.get_terminal_size(fallback=(52, 24)).lines
    for min_cols, art, (srow, scol, slogan) in _MASTHEAD:
        height = max(len(art), srow + 1)
        if width >= min_cols and height + 1 + body + 1 <= rows:
            lines = [re.sub(r"(\S+)", lambda m: C_LIME + m.group(1) + C_RESET, ln)
                     for ln in art] + [""] * (height - len(art))
            used = len(art[srow]) if srow < len(art) else 0
            lines[srow] += " " * (scol - used) + C_GRAY + slogan + C_RESET
            pad = " " * ((width - max(max(map(len, art)), scol + len(slogan))) // 2)
            return [pad + ln if ln else ln for ln in lines] + [""]
    tracked = "   ".join(" ".join(w) for w in _SLOGAN.split())
    slogan = tracked if len(tracked) <= width else _SLOGAN
    head = [" " * ((width - 7) // 2) + f"{C_LIME}TENDRIL{C_RESET}",
            " " * ((width - len(slogan)) // 2) + f"{C_GRAY}{slogan}{C_RESET}"]
    for keep in (2, 1):
        if keep + 1 + body + 1 <= rows:
            return head[:keep] + [""]
    return []


def run(args, timeout=6):
    if not args or args[0] is None:
        # §7.4/§3: a None argv[0] means Herdr is unavailable — report it as
        # the not-found rc instead of raising TypeError out of a tick.
        return 127, "", "herdr unavailable"
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", "not found"


def find_key(obj, key):
    """Depth-first search for the first value of `key` in nested JSON."""
    if isinstance(obj, dict):
        if key in obj and isinstance(obj[key], (str, int)):
            return obj[key]
        for v in obj.values():
            r = find_key(v, key)
            if r is not None:
                return r
    elif isinstance(obj, list):
        for v in obj:
            r = find_key(v, key)
            if r is not None:
                return r
    return None


def snapshot():
    if not HERDR:
        return None                  # Herdr unavailable: callers treat as down
    rc, out, _ = run([HERDR, "api", "snapshot"], 8)
    if rc != 0:
        return None
    try:
        return json.loads(out)["result"]["snapshot"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None


def collect(snap=None):
    """Selector rows from one `herdr api snapshot` payload. snap=None fetches
    one; callers that already hold the payload (snapshot --json) pass it in
    so a single herdr call feeds both the rows and the raw document."""
    if snap is None:
        snap = snapshot()
    if snap is None:
        return None
    pane_cwd = {}
    for p in snap.get("panes", []):
        if p.get("pane_id") and p.get("cwd"):
            pane_cwd[p["pane_id"]] = p["cwd"]
    by_ws = {}
    for a in snap.get("agents", []):
        by_ws.setdefault(a.get("workspace_id"), []).append(a)
    rows = []
    for w in snap.get("workspaces", []):
        wid = w.get("workspace_id")
        ags = by_ws.get(wid, [])
        path = ""
        active_panes = [p for p in snap.get("panes", [])
                        if p.get("tab_id") == w.get("active_tab_id")]
        active_panes.sort(key=lambda p: not p.get("focused", False))
        for p in active_panes:
            path = p.get("foreground_cwd") or p.get("cwd") or ""
            if path:
                break
        if not path:
            for a in ags:
                path = a.get("foreground_cwd") or a.get("cwd") or ""
                if path:
                    break
        best = min((RANK.get(a.get("agent_status"), 4) for a in ags), default=4)
        rows.append({
            "id": wid,
            "label": w.get("label") or wid,
            "number": w.get("number", 99),
            "focused": bool(w.get("focused")),
            "agents": ags,
            "path": path,
            "rank": best,
        })
    rows.sort(key=lambda r: (r["rank"], not r["focused"], r["number"]))
    _trace("rows-done")
    return rows


def short_path(path):
    if not path:
        return ""
    home = os.path.expanduser("~")
    if path.startswith(home):
        path = "~" + path[len(home):]
    return path


def trunc(s, n):
    return s if len(s) <= n else s[: max(1, n - 1)] + "\u2026"


def box_width():
    cols = shutil.get_terminal_size(fallback=(52, 24)).columns
    return max(34, min(cols, 56))


def line(w, ch="\u2500"):
    return ch * w


def tailscale_cli():
    """PATH first, then the macOS app bundle's CLI."""
    if tendril_host:
        return tendril_host.tailscale_cli() or "tailscale"
    return "tailscale"


def tailscale_parts():
    rc, out, _ = run([tailscale_cli(), "ip", "-4"], 4)
    if rc == 0 and out.strip():
        return "ACTIVE", out.strip().splitlines()[0]
    return "DOWN", ""


def chip_parts(row, max_plain=40):
    """Return (plain, colored) chip strings of identical visible width."""
    if not row["agents"]:
        p = "\u25cb SHELL"
        return p, f"{C_GRAY}{p}{C_RESET}"
    plain = colored = ""
    shown = 0
    for a in row["agents"]:
        st = a.get("agent_status", "unknown")
        kind = SHORT.get(a.get("agent", "?"), (a.get("agent") or "?")[:2].upper())
        sym = ICON.get(st, "\u25cb")
        piece = sym + kind + " "
        if len(plain) + len(piece) + 3 > max_plain:
            break
        col = {"working": C_TEAL, "blocked": C_LIME, "done": C_LIME}.get(st, C_GRAY)
        plain += piece
        colored += f"{col}{sym}{kind}{C_RESET} "
        shown += 1
    rest = len(row["agents"]) - shown
    if rest > 0:
        plain += f"+{rest} "
        colored += f"{C_GRAY}+{rest}{C_RESET} "
    return plain.rstrip(), colored.rstrip()


_selector_painted = False        # first-paint trace fires once per process


def render(rows, note="", selected=None):
    global _selector_painted
    w = box_width()
    inner = w - 2

    def fit(s, n):
        return s if len(s) <= n else s[: max(1, n - 1)] + "\u2026"

    def pad(plain, colored):
        return colored + " " * max(0, inner - len(plain))

    def foot_lines(items):
        cur, grouped = "", []
        for it in items:
            cand = (cur + "   " + it) if cur else it
            if len(cand) > inner - 2 and cur:
                grouped.append(cur)
                cur = it
            else:
                cur = cand
        if cur:
            grouped.append(cur)
        return grouped
    feet = foot_lines(["N New", "I Info", "R Refresh", "Q Quit", "L Link"])

    compact = len(rows) > 6
    # Paths yield when needed to keep the menu and prompt on screen, or when
    # dropping them buys the brand a tier: the compact mark, else the
    # TENDRIL + slogan caption, else the one-line caption. Paths never push
    # the whole brand off screen (a keyboard-open phone with 7+ workspaces).
    term_rows = shutil.get_terminal_size(fallback=(52, 24)).lines
    est = 4 + len(feet) + 2
    with_paths = est + sum(1 + (1 if r["path"] else 0) + (0 if compact else 1)
                           for r in rows)
    without = est + sum(1 + (0 if compact else 1) for r in rows)
    if note:
        with_paths += 1
        without += 1
    # brand heights incl. the blank separator: compact mark, caption, title
    brand = next((h for h in (7 + 1, 2 + 1, 1 + 1)
                  if h + without + 1 <= term_rows), 0) if COLOR else 0
    show_paths = with_paths + 1 <= term_rows and (
        brand + with_paths + 1 <= term_rows)

    lines = []
    edge = f"{C_LIME}\u250c{line(inner)}\u2510{C_RESET}"
    sep = f"{C_LIME}\u251c{line(inner)}\u2524{C_RESET}"
    bot = f"{C_LIME}\u2514{line(inner)}\u2518{C_RESET}"
    lines.append(edge)
    suffix = " // REMOTE AGENTS"
    if len(HOST_LABEL) + len(suffix) + 1 <= inner:
        t = f" {HOST_LABEL}{suffix}"
    else:                                       # prompt-polluted label: clamp
        t = " " + fit(HOST_LABEL, inner - len(suffix) - 1) + suffix
    lines.append(f"{C_LIME}\u2502{C_RESET}" + pad(t, f"{C_WHITE}{t}{C_RESET}") + f"{C_LIME}\u2502{C_RESET}")
    status, ip = tailscale_parts()
    tl_full = f" tailnet: {status} {ip}".rstrip()
    tl_plain = fit(tl_full, inner)
    scol = C_TEAL if status == "ACTIVE" else C_RED
    if len(tl_full) <= inner:
        tl_col = f" {C_GRAY}tailnet:{C_RESET} {scol}{status}{C_RESET}" \
            + (f" {C_GRAY}{ip}{C_RESET}" if ip else "")
    else:
        tl_col = C_GRAY + tl_plain + C_RESET
    lines.append(f"{C_LIME}\u2502{C_RESET}" + pad(tl_plain, tl_col) + f"{C_LIME}\u2502{C_RESET}")
    lines.append(sep)
    for i, r in enumerate(rows):
        budget = inner - 6
        lbl_plain = fit(r["label"] + (" *" if r["focused"] else ""), budget - 9)
        is_selected = selected == i
        if is_selected:
            head_plain = f">{i + 1:>2} {lbl_plain}"
            head_col = f"{C_WHITE}>{i + 1:>2}{C_RESET} {C_WHITE}{lbl_plain}{C_RESET}"
        else:
            head_plain = f"{i + 1:>2}  {lbl_plain}"
            head_col = f"{C_WHITE}{i + 1:>2}{C_RESET}  {C_LIME}{lbl_plain}{C_RESET}"
        chip_plain, chip_col = chip_parts(r, budget - len(head_plain) - 1)
        while len(lbl_plain) + 1 + len(chip_plain) > budget and len(lbl_plain) > 4:
            lbl_plain = fit(lbl_plain, len(lbl_plain) - 2)
            if is_selected:
                head_plain = f">{i + 1:>2} {lbl_plain}"
                head_col = f"{C_WHITE}>{i + 1:>2}{C_RESET} {C_WHITE}{lbl_plain}{C_RESET}"
            else:
                head_plain = f"{i + 1:>2}  {lbl_plain}"
                head_col = f"{C_WHITE}{i + 1:>2}{C_RESET}  {C_LIME}{lbl_plain}{C_RESET}"
            chip_plain, chip_col = chip_parts(r, budget - len(head_plain) - 1)
        gap = max(1, inner - 2 - len(head_plain) - len(chip_plain))
        lines.append(f"{C_LIME}\u2502{C_RESET} "
                     + head_col + " " * gap + chip_col
                     + f" {C_LIME}\u2502{C_RESET}")
        if r["path"] and show_paths:
            p_plain = "    " + fit(short_path(r["path"]), inner - 6)
            p_col = f" {C_GRAY}{p_plain[1:]}{C_RESET}"
            lines.append(f"{C_LIME}\u2502{C_RESET}" + pad(p_plain, f" {C_GRAY}{p_plain[1:]}{C_RESET}") + f"{C_LIME}\u2502{C_RESET}")
        if not compact:
            lines.append(f"{C_LIME}\u2502{C_RESET}{' ' * inner}{C_LIME}\u2502{C_RESET}")
    lines.append(sep)
    for ln_ in feet:
        lines.append(f"{C_LIME}\u2502{C_RESET}"
                     + pad(" " + ln_, f" {C_WHITE}{ln_}{C_RESET}")
                     + f"{C_LIME}\u2502{C_RESET}")
    lines.append(bot)
    if note:
        lines.append(f"{C_GRAY}{fit(note, w)}{C_RESET}")
    if not _selector_painted:
        _selector_painted = True
        _trace("selector-first-paint")
    print("\033[H\033[2J" + "\n".join(masthead(w, len(lines)) + lines), flush=True)


def save_last(row):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(os.path.join(CACHE_DIR, "last"), "w") as f:
            f.write(row["id"] + "\n" + row["label"])
    except OSError:
        pass


def load_last(rows):
    try:
        with open(os.path.join(CACHE_DIR, "last")) as f:
            wid, label = f.read().splitlines()[:2]
    except (OSError, ValueError):
        return None
    for r in rows:
        if r["id"] == wid:
            return r
    return None


def _bridge_enabled():
    """Enable the Ctrl+Home bridge by default for host TTY attachments.

    TENDRIL_DETACH_BRIDGE=1 explicitly enables it; =0 (or false/no/off/empty)
    opts out and restores the direct `herdr session attach` path."""
    raw = os.environ.get("TENDRIL_DETACH_BRIDGE")
    if raw is not None:
        return raw.strip().lower() not in ("", "0", "false", "no", "off")
    return True


def attach(row, pane=None):
    """One-shot attach (selector, `attach <token>`). pane=None focuses
    the workspace -- the historical semantics, unchanged. With a live
    pane entry the focus is exact (workspace -> tab -> pane, verified)
    and a failed verification attaches nothing, returning False."""
    save_last(row)
    if pane is not None:
        if not _focus_pane(pane):
            return False
    else:
        run([HERDR, "workspace", "focus", row["id"]], 6)
        _trace("focus-done")
    if os.environ.get("HERDR_ENV") == "1":
        input(f"already inside Herdr — workspace '{row['label']}' focused. Enter...")
        return True
    _trace("attach-exec")
    if _bridge_enabled():
        print(f"{C_GRAY}attaching {row['label']} \u2014 detach: Ctrl+Home \u00b7 Alt+D \u00b7 Ctrl+B d - menu returns here{C_RESET}",
              flush=True)
        _attach_session()
    else:
        print(f"{C_GRAY}attaching {row['label']} \u2014 detach: Alt+D \u00b7 Ctrl+B then D fallback - menu returns here{C_RESET}",
              flush=True)
        subprocess.run([HERDR, "session", "attach", SESSION], check=False)
    return True


# ---------- Ctrl+Home detach bridge (default-on TENDRIL convenience) ----------
# Termux encodes Ctrl+Home as `ESC [ 1 ; 5 H` (termux-app KeyHandler.getCode +
# transformForModifiers: KEYMOD_CTRL -> xterm modifier 5). Herdr's key grammar
# has no Home key in any modifier combination, so `herdr session attach` runs
# behind a transparent PTY bridge that rewrites exactly those six bytes to the
# Alt+D detach (`ESC d`) Herdr already binds. Every other byte — including
# plain Home (`ESC [ H`) — is forwarded unchanged. Herdr's config is untouched;
# Alt+D and Ctrl+B d keep working. The host TTY bridge is enabled by default;
# TENDRIL_DETACH_BRIDGE=0 turns it off.
_CTRL_HOME = b"\x1b[1;5H"
_ALT_D = b"\x1bd"


def _detach_translate(data):
    """(tail, out): rewrite Ctrl+Home to the detach; hold a trailing byte
    run that could still complete Ctrl+Home; forward all else unchanged."""
    out = bytearray()
    while True:
        i = data.find(_CTRL_HOME)
        if i < 0:
            break
        out += data[:i]
        out += _ALT_D
        data = data[i + len(_CTRL_HOME):]
    hold = 0
    for k in range(min(len(data), len(_CTRL_HOME) - 1), 0, -1):
        if _CTRL_HOME.startswith(data[-k:]):
            hold = k
            break
    cut = len(data) - hold
    out += data[:cut]
    return data[cut:], bytes(out)


# ---------- touch scrolling for Termux over Mosh (v0.2.1) ----------
# A finger swipe in Termux becomes mouse-WHEEL events only while the
# terminal has mouse tracking on, and Termux implements tracking modes 1000
# and 1002 only (TerminalEmulator.isMouseTrackingActive). Herdr asks for
# 1000 + 1002 + 1003; Mosh keeps ONE mouse mode (last request wins) and
# forwards just 1003, which Termux accepts but ignores — so Termux thought
# tracking was off and turned every swipe into Up/Down ARROW keys that
# edited the agent's prompt instead of scrolling. For a Termux client (the
# phone launcher exports TENDRIL_CLIENT=termux) the bridge rewrites mode
# 1003 (any-motion) to 1002 (button-event) on the way out: Mosh forwards
# 1002, Termux sends SGR wheel events, Herdr scrolls natively (and hands
# the wheel to pane apps that asked for the mouse, e.g. Pi). Only hover
# motion is lost, which a touchscreen never produces.
_DECMODE_RE = re.compile(rb"\x1b\[\?([0-9;]*)([hl])")
_DECMODE_PARTIAL_RE = re.compile(rb"\x1b(?:\[(?:\?[0-9;]{0,24})?)?\Z")


def _termux_client():
    return os.environ.get("TENDRIL_CLIENT", "").strip().lower() == "termux"


def _mouse_compat_translate(data):
    """(tail, out): DEC private mode 1003 -> 1002 in every set/reset; hold a
    trailing, possibly incomplete `ESC [ ? digits` run for the next read;
    every other byte passes through unchanged."""
    m = _DECMODE_PARTIAL_RE.search(data)
    tail = b""
    if m:
        tail, data = data[m.start():], data[:m.start()]

    def fix(mt):
        params = [b"1002" if p == b"1003" else p for p in mt.group(1).split(b";")]
        return b"\x1b[?" + b";".join(params) + mt.group(2)

    return tail, _DECMODE_RE.sub(fix, data)


def _write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def _attach_session():
    """Run `herdr session attach` behind the Ctrl+Home bridge (tty only)."""
    import fcntl
    import pty
    import select
    import signal
    import termios
    import tty
    if not sys.stdin.isatty():    # no tty (pipes/tests): plain passthrough
        subprocess.run([HERDR, "session", "attach", SESSION], check=False)
        return
    pid, master = pty.fork()
    if pid == 0:                  # child: Herdr owns the bridge pty
        try:
            os.execvp(HERDR, [HERDR, "session", "attach", SESSION])
        finally:
            os._exit(127)
    fd = sys.stdin.fileno()
    out_fd = sys.stdout.fileno()
    old = termios.tcgetattr(fd)

    def resize(*_):
        try:
            ws = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, ws)
        except OSError:
            pass

    def _stop(*_):                # TERM/HUP: exit through finally (restore tty)
        sys.exit(1)

    old_winch = signal.signal(signal.SIGWINCH, resize)
    old_term = signal.signal(signal.SIGTERM, _stop)
    old_hup = signal.signal(signal.SIGHUP, _stop)
    resize()
    tty.setraw(fd)
    tail = b""
    out_tail = b""
    termux = _termux_client()
    reaped = False
    try:
        while True:
            r, _, _ = select.select([fd, master], [], [], 1.0)
            if not r and tail:    # a cancelled combo must not hold bytes forever
                _write_all(master, tail)
                tail = b""
            if not r and out_tail:
                _write_all(out_fd, out_tail)
                out_tail = b""
            if fd in r:
                data = os.read(fd, 4096)
                if not data:
                    break
                tail, out = _detach_translate(tail + data)
                if out:
                    _write_all(master, out)
            if master in r:
                try:
                    data = os.read(master, 4096)
                except OSError:   # EIO: child exited
                    break
                if not data:
                    break
                if termux:
                    out_tail, data = _mouse_compat_translate(out_tail + data)
                _write_all(out_fd, data)
            done, _ = os.waitpid(pid, os.WNOHANG)
            if done == pid:
                reaped = True
                break
    finally:
        if tail:                      # flush a held partial sequence
            try:
                _write_all(master, tail)
            except OSError:
                pass
        if out_tail:
            try:
                _write_all(out_fd, out_tail)
            except OSError:
                pass
        signal.signal(signal.SIGWINCH, old_winch)
        signal.signal(signal.SIGTERM, old_term)
        signal.signal(signal.SIGHUP, old_hup)
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        try:                          # drain Herdr's last output
            while True:
                r, _, _ = select.select([master], [], [], 0.2)
                if not r:
                    break
                data = os.read(master, 4096)
                if not data:
                    break
                _write_all(out_fd, data)
        except OSError:
            pass
        try:
            os.close(master)
        except OSError:
            pass
        if not reaped:
            try:
                os.waitpid(pid, 0)
            except ChildProcessError:
                pass


def ws_create(cwd, label=None, focus=True):
    args = [HERDR, "workspace", "create", "--cwd", cwd]
    if label is not None:
        args.extend(["--label", label])
    args.append("--focus" if focus else "--no-focus")
    rc, out, err = run(args, 12)
    if rc != 0:
        return None, (err or out or "create failed")
    try:
        return json.loads(out), None
    except json.JSONDecodeError:
        return {}, None


def start_agent(name, kind, pane_id):
    print(f"{C_GRAY}starting {kind} \u2014 waiting for readiness...{C_RESET}", flush=True)
    rc, out, err = run([HERDR, "agent", "start", name, "--kind", kind,
                        "--pane", pane_id, "--timeout", "30000"], 45)
    return rc == 0, (err or out)


def choose(prompt, options):
    for i, o in enumerate(options, 1):
        print(f"  {C_WHITE}{i}{C_RESET}) {o}")
    raw = input(prompt).strip()
    if raw.isdigit() and 1 <= int(raw) <= len(options):
        return options[int(raw) - 1]
    return None


def ask_dir():
    opts = list(dict.fromkeys(PROJECT_ROOTS + [os.path.expanduser("~")]))
    opts.append("custom path")
    pick = choose("dir> ", opts)
    if pick is None:
        return None
    if pick == "custom path":
        pick = input("path> ").strip()
        pick = os.path.expanduser(pick)
        if not pick.startswith("/") and not pick.startswith("~"):
            return None
    if not os.path.isdir(pick):
        print(f"{C_RED}no such directory: {pick}{C_RESET}")
        return None
    return pick


def ask_agent():
    kinds = [k for k in ("pi", "claude", "codex") if shutil.which(k)]
    opts = ["shell only"] + [f"{k} (agent)" for k in kinds]
    pick = choose("launch> ", opts)
    if pick is None:
        return None
    if pick == "shell only":
        return "shell"
    return pick.split(" ")[0]


def confirm(text):
    ans = input(f"{C_WHITE}{text}{C_RESET} {C_GRAY}[Enter=go, n=cancel]{C_RESET} ").strip()
    return ans != "n"


def _created_workspace_label(data, cwd):
    result = data.get("result", data) if isinstance(data, dict) else {}
    workspace = result.get("workspace", {}) if isinstance(result, dict) else {}
    label = workspace.get("label") if isinstance(workspace, dict) else None
    if label:
        return str(label)
    return os.path.basename(os.path.normpath(cwd)) or "workspace"


def agent_name_for_workspace(label, cwd, unique_key=None):
    """Make a valid, workspace-unique Herdr agent name from its label."""
    source = label or os.path.basename(os.path.normpath(cwd)) or "workspace"
    ascii_name = unicodedata.normalize("NFKD", source).encode("ascii", "ignore").decode()
    name = re.sub(r"[^a-zA-Z0-9_-]+", "-", ascii_name).strip("-_").lower()
    if not name:
        name = "workspace"
    if not name[0].isalpha():
        name = "workspace-" + name
    if unique_key is not None:
        suffix = hashlib.sha256(str(unique_key).encode("utf-8")).hexdigest()[:12]
        name = (name[:19].rstrip("-_") or "workspace") + "-" + suffix
    return name[:32].rstrip("-_") or "workspace"


def current_ws_dir(rows, selected=None):
    """Usable create-default cwd: the selected workspace's path, else the
    focused one. None when neither has a directory that still exists."""
    order = []
    if selected is not None and 0 <= selected < len(rows):
        order.append(rows[selected])
    for r in rows:
        if r.get("focused") and r not in order:
            order.append(r)
    for r in order:
        path = r.get("path")
        if path and os.path.isdir(path):
            return path
    return None


def new_workspace(rows=None, selected=None):
    """Open a shell immediately; Herdr derives the workspace name from cwd."""
    if rows is None:
        rows = collect() or []
    d = current_ws_dir(rows, selected)
    if not d:
        try:
            d = os.getcwd()
        except OSError:
            d = os.path.expanduser("~")
    # No --label or agent command: retain native directory-based naming and
    # launch the user's normal shell, without any wizard or confirmation.
    data, err = ws_create(d)
    if data is None:
        print(f"{C_RED}{err}{C_RESET}")
        return None
    wid = find_key(data, "workspace_id")
    for r in (collect() or []):
        if r["id"] == wid:
            attach(r)
            return wid
    print(f"{C_GRAY}shell workspace created; it will appear in the menu{C_RESET}")
    return wid


def quick_shell(rows=None, selected=None):
    if rows is None:
        rows = collect() or []
    d = current_ws_dir(rows, selected) or os.path.expanduser("~")
    name = "shell-" + time.strftime("%H%M%S")
    data, err = ws_create(d, name)
    if data is None:
        print(f"{C_RED}{err}{C_RESET}")
        return None
    wid = find_key(data, "workspace_id")
    for r in (collect() or []):
        if r["id"] == wid:
            attach(r)
            return wid
    print(f"{C_GRAY}shell workspace created{C_RESET}")
    return wid


def project_launcher():
    roots = [r for r in PROJECT_ROOTS
             if r != os.path.expanduser("~") and os.path.isdir(r)]
    rows = collect() or []
    entries = []
    for root in roots:
        try:
            names = sorted(os.listdir(root), key=lambda n: -os.path.getmtime(
                os.path.join(root, n)))
        except OSError:
            continue
        for n in names:
            p = os.path.join(root, n)
            if os.path.isdir(p) and not n.startswith("."):
                entries.append((n, p))
                if len(entries) >= 9:
                    break
        if len(entries) >= 9:
            break
    if not entries:
        print(f"{C_RED}no project directories found{C_RESET}")
        return
    cwdset = [r["path"].rstrip("/") for r in rows if r["path"]]
    for i, (n, p) in enumerate(entries, 1):
        exists = any(r["label"] == n or r["path"].rstrip("/") == p for r in rows) \
            or p in cwdset or any(c.startswith(p + "/") for c in cwdset)
        tag = f"  {C_TEAL}existing{C_RESET}" if exists else ""
        print(f"  {C_WHITE}{i}{C_RESET}) {C_LIME}{n}{C_RESET} "
              f"{C_GRAY}{short_path(p)}{C_RESET}{tag}")
    raw = input("project> ").strip()
    if not (raw.isdigit() and 1 <= int(raw) <= len(entries)):
        return
    n, p = entries[int(raw) - 1]
    for r in rows:
        if r["label"] == n or r["path"].rstrip("/") == p \
                or r["path"].rstrip("/").startswith(p + "/"):
            print(f"{C_GRAY}matching workspace exists \u2014 attaching{C_RESET}")
            attach(r)
            return r["id"]
    kind = ask_agent()
    if kind is None:
        return
    if not confirm(f"create '{n}' @ {short_path(p)} + {kind}?"):
        return
    data, err = ws_create(p, n)
    if data is None:
        print(f"{C_RED}{err}{C_RESET}")
        return
    wid = find_key(data, "workspace_id")
    pane = find_key(data, "pane_id")
    if kind != "shell":
        if not pane and wid:
            snap = snapshot()
            for pan in (snap or {}).get("panes", []):
                if pan.get("workspace_id") == wid and pan.get("pane_id"):
                    pane = pan["pane_id"]
                    break
        if not pane:
            print(f"{C_RED}could not locate new pane; start {kind} manually{C_RESET}")
            return None
        ok, msg = start_agent(agent_name_for_workspace(n, p, wid or pane),
                              kind, pane)
        if not ok:
            print(f"{C_RED}agent start: {trunc(msg.strip() or 'failed', 60)}{C_RESET}")
            return None
    for r in (collect() or []):
        if r["id"] == wid:
            attach(r)
            return wid
    return wid


@contextlib.contextmanager
def raw_terminal(fd):
    """Put a terminal into raw mode and always restore its exact settings."""
    import termios
    import tty

    original = termios.tcgetattr(fd)
    try:
        tty.setraw(fd, termios.TCSANOW)
        yield
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, original)


def _read_byte(fd, timeout=None):
    if timeout is not None:
        try:
            ready, _, _ = select.select([fd], [], [], timeout)
        except InterruptedError:
            return b""
        if not ready:
            return b""
    try:
        return os.read(fd, 1)
    except OSError:
        return b""


def read_key(fd, escape_timeout=0.2):
    """Read one key, decoding CSI/SS3 arrows without blocking on bare Escape."""
    first = _read_byte(fd)
    if not first:
        return None
    if first == bytes([27]):
        introducer = _read_byte(fd, escape_timeout)
        if not introducer:
            return "escape"
        if introducer not in (b"[", b"O"):
            return "escape"
        for _ in range(16):
            byte = _read_byte(fd, escape_timeout)
            if not byte:
                return "escape"
            if 0x40 <= byte[0] <= 0x7e:
                final = chr(byte[0])
                return {"A": "up", "B": "down", "C": "right",
                        "D": "left"}.get(final, "escape")
        return "escape"
    if first in (bytes([13]), bytes([10])):
        return "enter"
    if first in (bytes([127]), bytes([8])):
        return "backspace"
    if first == bytes([3]):
        raise KeyboardInterrupt
    if first == bytes([4]):
        return None
    try:
        return first.decode("ascii")
    except UnicodeDecodeError:
        return "unknown"


def read_menu_action(tty_mode, fd=None):
    """Return (kind, value); non-TTY users retain the original line prompt."""
    if not tty_mode:
        return "line", input("> ").strip()
    with raw_terminal(fd):
        return _read_tty_action(fd)


def _read_tty_action(fd):
    prompt = "↑/↓ · number + Enter · key> "
    sys.stdout.write(C_GRAY + prompt + C_RESET)
    sys.stdout.flush()
    text = ""
    while True:
        key = read_key(fd)
        if key is None:
            return "eof", ""
        if key in ("up", "down"):
            return "navigate", key
        if key == "enter":
            return ("line", text.strip()) if text.strip() else ("enter", "")
        if key == "backspace":
            if text:
                text = text[:-1]
                sys.stdout.write(chr(13) + C_GRAY + prompt + text + chr(27) + "[K" + C_RESET)
                sys.stdout.flush()
            continue
        if key == "?" or (isinstance(key, str) and len(key) == 1
                           and key.lower() in ("l", "n", "i", "r", "q")):
            return "line", key
        if isinstance(key, str) and len(key) == 1 and key.isprintable():
            text += key
            sys.stdout.write(key)
            sys.stdout.flush()


def selection_index(rows, preferred_id=None, previous_index=None):
    """Keep the selected workspace stable; fall back to focus, then row position."""
    if not rows:
        return None
    if preferred_id is not None:
        for index, row in enumerate(rows):
            if row.get("id") == preferred_id:
                return index
    for index, row in enumerate(rows):
        if row.get("focused"):
            return index
    if previous_index is not None:
        return max(0, min(previous_index, len(rows) - 1))
    return 0


def move_selection(rows, selected, delta):
    if not rows:
        return None
    if selected is None:
        return selection_index(rows)
    return max(0, min(selected + delta, len(rows) - 1))


def wait_for_key():
    if not sys.stdin.isatty():
        input()
        return
    fd = sys.stdin.fileno()
    with raw_terminal(fd):
        read_key(fd)


_DIGIT_WORDS = {"switch tab": "jump to tab", "switch workspace": "jump to workspace",
                "focus agent": "focus agent"}


def digit_rows(text=None):
    """What digit chords really do in this user's Herdr config (the help
    must not promise workspace jumps that a user binding overrides).
    Falls back to Herdr's documented defaults without the helper."""
    path = os.environ.get("HERDR_CONFIG_PATH") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
        "herdr", "config.toml")
    helper = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                          "herdr-bindings.py")
    try:
        if text is None:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        loader = importlib.machinery.SourceFileLoader("herdr_bindings", helper)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        pairs = mod.describe_digits(text)
    except FileNotFoundError:
        pairs = [("Ctrl+B 1..9", "switch tab")] if os.path.isfile(helper) else []
    except Exception:
        pairs = []
    if not pairs:
        return [("Ctrl+B 1..9", "jump (see Herdr config)")]
    return [(keys, _DIGIT_WORDS.get(does, does)) for keys, does in pairs
            if does != "unbound"]


def help_screen():
    """Mobile key reference. Bindings mirror ~/.config/herdr/config.toml."""
    w = max(34, min(shutil.get_terminal_size(fallback=(48, 24)).columns, 48))
    inner = w - 2

    def fit(s, n):
        return s if len(s) <= n else s[: max(1, n - 1)] + "\u2026"

    rows = [
        ("N", "new shell in cwd"),
        ("I", "host/workspace info"),
        ("?", "show this help"),
        ("R", "refresh workspaces"),
        ("Q", "quit selector"),
        ("L", "open Link app on the phone"),
        ("number + Enter", "attach workspace"),
        ("up/down + Enter", "select and attach"),
        ("Alt+D", "detach to selector"),
        ("Ctrl+B d", "detach fallback"),
        ("Ctrl+Home", "detach (host bridge)"),
    ] + digit_rows() + [
        ("Ctrl+B w", "workspace picker"),
        ("Ctrl+B n/p", "next / previous tab"),
        ("Alt+\u2190/\u2192", "previous / next tab"),
        ("Alt+\u2193", "next workspace (desktop)"),
        ("Alt+Enter", "split pane horizontal"),
        ("Alt+Shift+Enter", "split pane vertical"),
        ("Alt+Esc", "close pane"),
        ("Ctrl+B c", "new tab"),
        ("Ctrl+B shift+T", "rename tab"),
        ("Ctrl+B shift+X", "close tab"),
        ("Ctrl+B ?", "native Herdr help"),
    ]
    kcol = 18
    dbudget = inner - 4 - kcol
    if terminal_name() == "blink":           # no on-screen Home key there:
        rows = [r for r in rows if r[0] != "Ctrl+Home"]   # unproducible combo
    out = [f"{C_LIME}\u250c{line(inner)}\u2510{C_RESET}"]
    t = " HERDR // MOBILE KEYS"
    out.append(f"{C_LIME}\u2502{C_RESET}"
               + f"{C_WHITE}{fit(t, inner)}{C_RESET}"
               + " " * max(0, inner - len(t))
               + f"{C_LIME}\u2502{C_RESET}")
    out.append(f"{C_LIME}\u251c{line(inner)}\u2524{C_RESET}")
    for key, desc in rows:
        kfit = fit(key, kcol).ljust(kcol)
        dfit = fit(desc, dbudget)
        body = f" {C_LIME}{kfit}{C_RESET}{C_GRAY}{dfit}{C_RESET}"
        padn = max(0, inner - 2 - len(kfit) - len(dfit))
        out.append(f"{C_LIME}\u2502{C_RESET}" + body + " " * padn
                   + f" {C_LIME}\u2502{C_RESET}")
    out.append(f"{C_LIME}\u251c{line(inner)}\u2524{C_RESET}")
    notes = ["Menu letters: no Enter needed.",
             "Alt+arrows: desktop only.",
             "Alt+Up: reserved for Pi.",
             "Phone: Ctrl+B; ALT+digit.",
             "Alt+D or Ctrl+B then D detaches.",
             "Detach keeps workspaces and agents."]
    if terminal_name() == "blink":       # no on-screen Home key in Blink:
        notes[0:0] = ["Blink: no Home key on screen;",   # unproducible combo
                      "detach = tap ALT then D;",
                      "TENDRIL_TERMINAL=blink selects",
                      "these hints."]
    else:
        notes[1:1] = ["Ctrl+Home bridge: default on.",
                      "Mac: Fn+Ctrl+Left = Ctrl+Home.",   # stock Terminal/iTerm2
                      "No Home key? Ctrl+B then D.",      # send neither combo
                      "Disable on host with:",
                      "TENDRIL_DETACH_BRIDGE=0",
                      "(false/no/off/empty also disable)."]
    for note in notes:
        nfit = fit(note, inner - 2)
        out.append(f"{C_LIME}\u2502{C_RESET} {C_GRAY}{nfit}{C_RESET}"
                   + " " * max(0, inner - 1 - len(nfit))
                   + f"{C_LIME}\u2502{C_RESET}")
    out.append(f"{C_LIME}\u2514{line(inner)}\u2518{C_RESET}")
    # Keep the complete reference readable with the phone keyboard open.
    # Reserve three header rows, a bottom border, and one prompt row.
    page_size = max(1, shutil.get_terminal_size(fallback=(48, 24)).lines - 5)
    body = out[3:-1]
    for start in range(0, len(body), page_size):
        page = out[:3] + body[start:start + page_size] + out[-1:]
        print("\033[H\033[2J" + "\n".join(page), flush=True)
        action = "for more" if start + page_size < len(body) else "to return"
        print(f"{C_GRAY}press any key {action}...{C_RESET}", end="", flush=True)
        wait_for_key()


def info():
    host = tendril_host.short_hostname() if tendril_host else os.uname().nodename
    status, ip = tailscale_parts()
    ts = ip if status == "ACTIVE" else "down"
    if tendril_host:
        up = tendril_host.format_uptime(tendril_host.uptime_seconds(run))
        load = tendril_host.load_average()
        mem = tendril_host.memory_mb(run)
        bat = tendril_host.battery(run)
    else:
        up, load, mem, bat = "?", ("?", "?", "?"), None, ""
    disk = run(["df", "-h", "/"], 3)[1].splitlines()[-1:] or [""]
    disk = disk[0].split()
    rows = collect() or []
    nws = len(rows)
    counts = {}
    for r in rows:
        for a in r["agents"]:
            counts[a.get("agent", "?")] = counts.get(a.get("agent", "?"), 0) + 1
    agents = " ".join(f"{k}:{v}" for k, v in sorted(counts.items())) or "none"
    memtxt = f"{mem[0]}/{mem[1]}M free" if mem else "n/a"
    print(f"{C_LIME}{host}{C_RESET}  {C_GRAY}tailscale{C_RESET} {C_TEAL}{ts}{C_RESET}"
          f"  {C_GRAY}battery {bat or 'n/a'}{C_RESET}")
    print(f"{C_GRAY}up {up}{C_RESET}")
    print(f"{C_GRAY}load {load[0]} {load[1]} {load[2]}   "
          f"mem {memtxt}   "
          f"disk {disk[2] if len(disk) > 2 else '?'} used{C_RESET}")
    print(f"{C_GRAY}herdr {nws} workspaces   agents {agents}{C_RESET}")
    env_ok = os.path.isfile(os.path.expanduser("~/.config/remote-agents/notify.env"))
    push = f"{C_TEAL}ACTIVE{C_RESET}" if env_ok else f"{C_GRAY}NOT CONFIGURED{C_RESET}"
    svc = tendril_host.backend(run) if tendril_host else None
    running = bool(svc) and svc.status() == "running"
    watch = f"{C_TEAL}RUNNING{C_RESET}" if running else f"{C_GRAY}STOPPED{C_RESET}"
    print(f"{C_GRAY}Push       {push}{C_RESET}   {C_GRAY}Watcher    {watch}{C_RESET}")
    print(f"{C_GRAY}press any key to continue...{C_RESET}", end="", flush=True)
    wait_for_key()


def workspace_number(raw, count):
    if not raw or not raw.isdigit():
        return None
    try:
        number = int(raw)
    except ValueError:
        return None
    return number - 1 if 1 <= number <= count else None


def menu_loop(rows, tty_mode=False, fd=None, note="", preferred_id=None):
    """The selector loop — the one loop every entry path ends in (the bare
    selector, and `enter` after its attach detaches). note is shown once
    above the footer (the enter verb's stale notice); preferred_id
    preselects a workspace row (enter's parent workspace after a stale
    pane). Returns 0 when the user quits, LINK_OPEN_EXIT for L (the phone
    launcher opens the TENDRIL Link app)."""
    selected = selection_index(rows, preferred_id)
    while True:
        render(rows, note, selected)
        note = ""
        try:
            kind, raw = read_menu_action(tty_mode, fd)
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if kind == "eof":
            print()
            return 0
        if kind == "navigate":
            if not rows:
                note = "no workspaces to select"
            else:
                selected = move_selection(rows, selected,
                                          -1 if raw == "up" else 1)
            continue

        previous_id = rows[selected]["id"] if selected is not None else None
        previous_index = selected
        preferred_id = previous_id
        if kind == "enter":
            if selected is None:
                note = "no workspaces to attach"
            else:
                attach(rows[selected])
        elif raw == "":
            # Preserve the line-oriented no-op for piped/non-TTY input.
            continue
        elif raw.isdigit():
            index = workspace_number(raw, len(rows))
            if index is None:
                note = "no workspaces to attach" if not rows else f"no workspace {raw}"
            else:
                preferred_id = rows[index]["id"]
                attach(rows[index])
        elif raw.lower() == "q":
            if tty_mode:
                # leave a clean screen behind: the dashboard draws on the
                # main screen, so without this its last frame stayed on
                # top of the returned prompt over plain SSH (the frame read
                # as "Q did nothing"); cursor shown, attributes reset
                sys.stdout.write(C_RESET + "\033[?25h\033[H\033[2J")
                sys.stdout.flush()
            return 0
        elif raw.lower() == "l":
            # U9: the phone asked for the TENDRIL Link app. The selector
            # runs on the HOST and cannot reach Android's `am`; instead it
            # signals the phone launcher, which turns the signal into the
            # fixed local `am start -n app.tendril.link/.MainActivity`.
            # Two signals, both always sent (LINK-CONTRACT-0.2 §4):
            # - the exit status 75 (EX_TEMPFAIL) — ssh propagates it;
            # - a per-launch request file keyed by the launcher's nonce
            #   (TENDRIL_LINK_NONCE) — mosh drops exit statuses (verified
            #   mosh 1.4.0 exits 0 regardless), so the launcher consumes
            #   the request with one BatchMode ssh after the session ends.
            # NEVER sniff SSH_CONNECTION to pick one: mosh-server inherits
            # it from its ssh bootstrap, so a mosh session looks like ssh
            # (physical S21 failure, build 158 — L behaved like Q).
            _request_link_open()
            print("L opens TENDRIL Link on the phone — "
                  "if nothing opened, run: tendril link")
            return LINK_OPEN_EXIT
        elif raw.lower() == "r":
            pass
        elif raw.lower() == "n":
            preferred_id = new_workspace(rows, selected) or preferred_id
        elif raw.lower() == "i":
            info()
        elif raw == "?":
            help_screen()
        else:
            note = f"unknown: {raw}"

        refreshed = collect()
        if refreshed is not None:
            rows = refreshed
            selected = selection_index(rows, preferred_id, previous_index)


# ---------- direct addressing: attach/enter/resolve/focus/link <token> ----------
# A TENDRIL session is addressable without the selector. The canonical token
# is the herdr workspace_id ("w15"); pane ids ("w15:p1") address that exact
# pane, pure digits the workspace number, and an exact case-sensitive label
# as the last resort. The subcommands are the machine interface (phone
# shortcuts, deep links, notification taps): non-interactive, safe over SSH.
PANE_RE = re.compile(r"^[A-Za-z0-9]+:[A-Za-z0-9]+$")
MAX_TOKEN = 129                             # beyond this the token is junk
SUBCOMMANDS = ("attach", "enter", "resolve", "focus", "link")
# Selector key L: exit status the phone launcher watches for (see menu_loop).
LINK_OPEN_EXIT = 75


# The phone launcher's per-launch nonce: 16..32 lowercase hex, exported to
# the selector as TENDRIL_LINK_NONCE and echoed back by the consume verb.
LINK_NONCE_RE = re.compile(r"^[0-9a-f]{16,32}$")
# A request nobody consumed (phone lost the network mid-session) is swept
# after this long; it can never be read by another launch anyway (nonce).
LINK_REQUEST_TTL_S = 3600


def _link_request_dir():
    return os.path.join(os.path.expanduser("~"), ".local", "state",
                        "tendril", "link-open")


def _request_link_open(nonce=None):
    """Leave the phone-consumed link-open request for THIS launch: the file
    is named by the launcher's nonce, so a request can only ever be read by
    the launch that asked — no stale flag can open the app after a later
    Q, and a selector with no nonce (host desktop, old launcher) writes
    nothing. Atomic tmp+rename; failures are silent (the in-band hint
    still tells the user the way). Returns True when written."""
    if nonce is None:
        nonce = os.environ.get("TENDRIL_LINK_NONCE", "")
    if not LINK_NONCE_RE.match(nonce or ""):
        return False
    d = _link_request_dir()
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        tmp = os.path.join(d, ".%s.tmp" % nonce)
        with open(tmp, "w") as fh:
            fh.write("open\n")
        os.replace(tmp, os.path.join(d, nonce))
    except OSError:
        return False
    return True


def _sweep_link_requests(now=None):
    """Remove unconsumed requests older than LINK_REQUEST_TTL_S."""
    now = time.time() if now is None else now
    d = _link_request_dir()
    try:
        names = os.listdir(d)
    except OSError:
        return
    for name in names:
        path = os.path.join(d, name)
        try:
            if now - os.path.getmtime(path) > LINK_REQUEST_TTL_S:
                os.remove(path)
        except OSError:
            pass


def _link_open_request(nonce=None):
    """`--link-open-request <nonce>` — consume-and-report the selector's L
    request for ONE launch (phone launcher, after the interactive session
    ends): prints `open` exactly when that launch's request exists and
    removes it — consume-once — prints nothing otherwise; always exit 0.
    A missing or malformed nonce answers nothing."""
    _sweep_link_requests()
    if not LINK_NONCE_RE.match(nonce or ""):
        return 0
    flag = os.path.join(_link_request_dir(), nonce)
    try:
        with open(flag) as fh:
            content = fh.read().strip()
    except OSError:
        return 0
    try:
        os.remove(flag)
    except OSError:
        pass
    if content == "open":
        print("open")
    return 0
_RANK_NAME = {rank: name for name, rank in RANK.items()}
STALE_NOTE = "That agent session has ended — choose another."


def _pane_lookup(token):
    """Live snapshot entry for a pane-shaped token, else None (stale).
    One extra `herdr api snapshot`: collect() keeps only workspace rows,
    and exact focus needs the pane's tab_id/workspace_id."""
    if not PANE_RE.match(token):
        return None
    snap = snapshot()
    if not snap:
        _trace("pane-lookup-done")
        return None
    pane = None
    for p in snap.get("panes", []):
        if p.get("pane_id") == token:
            pane = p
            break
    _trace("pane-lookup-done")
    return pane


def _focus_pane(pane):
    """Exact focus: workspace -> tab -> pane, then VERIFY against the
    snapshot's focused_pane_id. `herdr agent focus <pane_id>` is the CLI's
    exact-pane focus (agent commands accept the pane hosting the agent);
    panes without a recognized agent rely on the preceding tab focus
    landing on the tab's own pane. False when verification cannot confirm
    the pane is focused — the caller must treat it as stale and never
    attach blind."""
    pane_id = pane.get("pane_id") or ""
    tab_id = pane.get("tab_id") or ""
    ws_id = pane.get("workspace_id") or pane_id.split(":", 1)[0]
    run([HERDR, "workspace", "focus", ws_id], 6)
    if tab_id:
        run([HERDR, "tab", "focus", tab_id], 6)
    run([HERDR, "agent", "focus", pane_id], 6)
    snap = snapshot()
    ok = bool(snap) and snap.get("focused_pane_id") == pane_id
    _trace("focus-done")
    return ok


def _selector_after(rows, note="", preferred_id=None):
    """The selector loop, in this process — the single entry every attach
    path falls back to. No re-exec, no recursion, no double selector."""
    tty_mode = sys.stdin.isatty()
    fd = sys.stdin.fileno() if tty_mode else None
    return menu_loop(rows, tty_mode, fd, note=note, preferred_id=preferred_id)


def _stale_pane_selector(rows, token):
    """A stale (vanished or unverifiable) pane must never attach — not even
    to its parent workspace's focused tab, which may be a different agent.
    Open the selector in-process with a one-line notice, the parent
    workspace preselected when it still exists."""
    parent = token.split(":", 1)[0] if PANE_RE.match(token) else token
    fresh = collect()
    if fresh is None:
        fresh = rows
    preselect = parent if any(r["id"] == parent for r in fresh) else None
    return _selector_after(fresh, note=STALE_NOTE, preferred_id=preselect)


def resolve_token(rows, token):
    """(row, None) or (None, ("unknown"|"ambiguous", matching rows)).

    Pure over `rows` — no I/O. Token order: exact workspace_id (canonical,
    case-sensitive), pane id -> parent workspace, pure digits -> workspace
    number, then an exact unique label. Empty/oversized tokens and unknown
    (possibly stale) ids come back as ("unknown", []); a label shared by
    several workspaces as ("ambiguous", hits)."""
    token = token or ""
    if not token or len(token) > MAX_TOKEN:
        return None, ("unknown", [])
    for r in rows:
        if r["id"] == token:
            return r, None
    if PANE_RE.match(token):                # "w15:p1" -> workspace "w15"
        parent = token.split(":", 1)[0]
        for r in rows:
            if r["id"] == parent:
                return r, None
    if token.isascii() and token.isdigit():
        hits = [r for r in rows if r.get("number") == int(token)]
        if len(hits) == 1:
            return hits[0], None
        if len(hits) > 1:
            return None, ("ambiguous", hits)
    hits = [r for r in rows if r.get("label") == token]
    if len(hits) == 1:
        return hits[0], None
    if len(hits) > 1:
        return None, ("ambiguous", hits)
    return None, ("unknown", [])


_LIVE_STATUS = ("working", "blocked", "done", "idle")
_SNAPSHOT_MAX_BYTES = 64 * 1024     # contract §0: the whole wire document


def _prompt_ready(status, harness):
    """§7.3: the host could dispatch a prompt into this agent — a
    launchable harness, an agent present, idle or done. The phone uses
    it to enable schedule rows (Busy · Needs input · Not supported are
    derived from status on the phone)."""
    if status not in ("idle", "done"):
        return False
    try:
        import tendril_schedule
        return harness in tendril_schedule.HARNESSES
    except Exception:
        return False


def _snapshot_agent(a, tele=None):
    """One LIVE MAP agent row: the five schema-v1 contract fields plus the
    `harness` tag and, when tendril_telemetry could derive them, the
    telemetry keys (v2 facts plus v3 phase/events/children — children carry
    only ids, types, statuses and token/cost numbers). Never cwd, terminal
    titles or agent_session; telemetry carries only tool names and sanitized
    file basenames inside `activity`, never transcript content."""
    st = a.get("agent_status")
    tab = a.get("tab_id")
    agent = a.get("agent") or "agent"
    harness = str(agent).lower()
    out = {
        "pane_id": a.get("pane_id") or "",
        "tab_id": tab if tab else None,
        "agent": agent,
        "status": st if st in _LIVE_STATUS else "unknown",
        "focused": bool(a.get("focused")),
        "harness": harness,
    }
    out["prompt_ready"] = _prompt_ready(out["status"], harness)
    if tele:
        out.update(tele)
    return out


def _optional_sections(snap=None, provider_hints=None):
    """(extra top-level sections, extra capability strings) contributed by
    sibling host modules when they are installed (contract §1/§4). Each hook
    returns (section_dict | None, capability_string) — a bare section dict is
    tolerated. Best-effort: absence or failure omits its section AND its
    capability string, and a present-but-EMPTY section registers nothing —
    the phone renders the designed degraded state. The herdr snapshot the
    assembler already fetched rides along for the schedule section's
    §7.3 latency reconcile."""
    extra, caps = {}, []

    def take(verb, result):
        # contract §1: the hook's own capability string wins; the verb name
        # is the fallback for the tolerated bare-dict form.
        if isinstance(result, tuple) and len(result) == 2:
            sec, cap = result
            if not (isinstance(cap, str) and cap):
                cap = verb
        else:
            sec, cap = result, verb
        if isinstance(sec, dict) and sec:
            extra[verb] = sec
            if cap not in caps:
                caps.append(cap)

    try:
        import tendril_capacity
        take("capacity", tendril_capacity.snapshot_section(
            budget_s=1.0, discovered=provider_hints or []))
    except Exception:
        pass
    try:
        import tendril_schedule
        take("schedule", tendril_schedule.snapshot_section(snap=snap))
    except Exception:
        pass
    try:
        import tendril_health
        take("health", tendril_health.snapshot_section())
    except Exception:
        pass
    return extra, caps


def _doc_bytes(doc):
    return len(json.dumps(doc, separators=(",", ":")).encode(
        "utf-8", "replace"))


def _enforce_doc_cap(doc):
    """Shrink the document to the 64 KB wire cap (contract §0): children are
    dropped oldest-first (they are stored newest-first), then events
    oldest-first, then the optional schedule/capacity sections, then
    per-agent telemetry. The v1 agent/workspace fields always survive."""
    if _doc_bytes(doc) <= _SNAPSHOT_MAX_BYTES:
        return
    agents = [a for ws in doc.get("workspaces", [])
              for a in ws.get("agents", [])]
    while _doc_bytes(doc) > _SNAPSHOT_MAX_BYTES:
        victims = [a for a in agents if a.get("children")]
        if not victims:
            break
        for a in victims:
            a["children"].pop()          # tail of a newest-first list
    while _doc_bytes(doc) > _SNAPSHOT_MAX_BYTES:
        victims = [a for a in agents if a.get("events")]
        if not victims:
            break
        for a in victims:
            a["events"].pop(0)           # oldest of a newest-last list
    for key in ("schedule", "capacity", "health"):
        if _doc_bytes(doc) <= _SNAPSHOT_MAX_BYTES:
            return
        doc.pop(key, None)
    for a in agents:
        if _doc_bytes(doc) <= _SNAPSHOT_MAX_BYTES:
            return
        for k in ("children", "events", "phase", "trail", "last_event",
                  "tool_started_at", "tool", "activity", "cost_usd",
                  "output_tokens", "context_tokens", "started_at",
                  "effort", "provider", "model"):
            a.pop(k, None)
    # titles are the PRIMARY identity (§11): the last thing to go
    for a in agents:
        if _doc_bytes(doc) <= _SNAPSHOT_MAX_BYTES:
            return
        for k in ("title", "title_source"):
            a.pop(k, None)


def _snapshot_doc():
    """(doc, 0) or (None, 1) — the LIVE MAP document for TENDRIL Link's
    phone map (schema v3: the v1/v2 fields, optional per-agent telemetry
    with phase/events/children derived read-only by tendril_telemetry, and
    optional capacity/schedule sections via the sibling host modules, each
    registered in `capabilities`; any failure just omits that piece). ONE
    `herdr api snapshot` call feeds both the selector rows and the raw
    document; workspaces in collect()'s order (selector order). The gate is
    _reachable_rows' semantics, but diagnostics go to STDERR and stdout
    stays empty on failure: consumers read one JSON line or nothing."""
    if not HERDR:
        print("no compatible herdr client found", file=sys.stderr)
        return None, 1
    snap = snapshot()
    rows = collect(snap)
    if snap is None or rows is None:
        print("cannot reach the Herdr server. Is it running? Try: herdr status",
              file=sys.stderr)
        return None, 1
    agents_flat = [a for r in rows for a in r["agents"]]
    tele = None
    if tendril_telemetry is not None and agents_flat:
        try:
            tele = tendril_telemetry.for_agents(agents_flat)
        except Exception:            # telemetry must never fail the map
            tele = None
    focused_pane = snap.get("focused_pane_id") or None
    workspaces = []
    idx = 0
    for r in rows:
        ags = []
        for a in r["agents"]:
            ags.append(_snapshot_agent(a, tele[idx] if tele else None))
            idx += 1
        workspaces.append({
            "id": r["id"],
            "label": r["label"],
            "number": r["number"],
            "focused": bool(r["focused"]),
            "agents": ags,
        })
    doc = {
        "version": 3,
        "host": HOST_LABEL,
        "generated_at": int(time.time()),
        "focused_workspace": next((r["id"] for r in rows if r["focused"]), None),
        "focused_pane": focused_pane,
        "workspaces": workspaces,
        # "etag": the phone may send `snapshot --if-none-match <etag>` and
        # get a tiny not-modified line for unchanged polls (D11 freshness).
        "capabilities": ["subagents", "etag"],
    }
    # Provider discovery is independent from quota metrics. The already
    # sanitized telemetry rows are enough to make an active/new provider
    # visible immediately, even when it has no adapter or usage sample yet.
    provider_hints = []
    for ws in workspaces:
        for agent in ws.get("agents", []):
            provider = agent.get("provider")
            if not provider:
                continue
            last = agent.get("last_event") or {}
            provider_hints.append({
                "provider": provider,
                "model": agent.get("model"),
                "harness": agent.get("harness"),
                "source": "active_sessions" if agent.get("status") in
                          ("working", "blocked") else "session_metadata",
                "seen_at": last.get("at") or agent.get("started_at")
                           or doc["generated_at"],
            })
    try:
        extra, caps = _optional_sections(snap, provider_hints)
        doc.update(extra)
        doc["capabilities"] += [c for c in caps
                                if c not in doc["capabilities"]]
    except Exception:                # hooks must never fail the map
        pass
    # Session titles (DESIGN-FINAL-POLISH §11): one resolved `title` +
    # `title_source` per agent, additive and best-effort — any failure just
    # leaves the fields off and the phone falls back to the harness name.
    try:
        import tendril_titles
        tendril_titles.annotate_document(doc, rows)
        if "titles" not in doc["capabilities"]:
            doc["capabilities"].append("titles")
    except Exception:
        pass
    _enforce_doc_cap(doc)
    return doc, 0


def _doc_etag(doc):
    """16-hex content tag for the LIVE MAP document: sha256 over the doc
    minus the volatile `generated_at` (and the `etag` key itself), so two
    polls of an unchanged host produce the SAME tag and a poll may send it
    back as `snapshot --if-none-match <etag>` to get a tiny not-modified
    line instead of the ~45 KB document (D11 freshness: unchanged polls
    must be cheap enough for a 2 s foreground cadence)."""
    core = {k: v for k, v in doc.items()
            if k not in ("generated_at", "etag")}
    blob = json.dumps(core, sort_keys=True, separators=(",", ":")).encode(
        "utf-8", "replace")
    return hashlib.sha256(blob).hexdigest()[:16]


def _snapshot_cmd(if_none_match=None):
    """`snapshot [--json] [--if-none-match <etag16>]` — non-interactive LIVE
    MAP document for the phone (phone/tendril snapshot dials this over plain
    SSH). --json is accepted and a no-op: the output is one compact JSON
    line either way. With --if-none-match matching the document's content
    etag, the reply is one tiny `{"not_modified":true,...}` line instead.
    Exit codes: 0 ok, 1 Herdr unreachable (stdout empty, reason on stderr),
    2 usage."""
    doc, code = _snapshot_doc()
    if doc is None:
        return code
    etag = _doc_etag(doc)
    doc["etag"] = etag
    if if_none_match is not None and if_none_match == etag:
        print(json.dumps({"version": doc["version"], "host": doc["host"],
                          "generated_at": int(time.time()),
                          "not_modified": True, "etag": etag,
                          "capabilities": doc.get("capabilities", [])},
                         separators=(",", ":")))
        return 0
    print(json.dumps(doc, separators=(",", ":")))
    return 0


# ---------- schedule: the TENDRIL scheduler verbs (contract §3/§4) ----------
SCHEDULE_TITLES = {"started": "TENDRIL · TASK STARTED",
                   "waiting": "TENDRIL · TASK WAITING",
                   "failed": "TENDRIL · TASK FAILED"}
SCHEDULE_PUSH = {"started": ("default", "white_check_mark"),
                 "waiting": ("min", "hourglass"),
                 "failed": ("high", "rotating_light")}


def _notify_module():
    """bin/herdr-notify loaded as a module (its filename has a dash), or
    None when it is not installed next to us. Best-effort: a missing or
    broken watcher must never break a schedule verb."""
    if not NOTIFY_BIN or not os.path.isfile(NOTIFY_BIN):
        return None
    try:
        loader = importlib.machinery.SourceFileLoader("tendril_notify_mod",
                                                      NOTIFY_BIN)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:
        return None


def _schedule_body(kind, task):
    """Notification body: the task title; TASK WAITING says what it is
    waiting for (contract §3: '<title> · waiting for <Provider> capacity').
    Fires only when an `at` task came due but the provider was exhausted."""
    title = str(task.get("title") or "scheduled task")[:80]
    if kind != "waiting":
        return title
    provider = str((task.get("trigger") or {}).get("provider") or "provider")
    return "%s · waiting for %s capacity" % (title, provider[:16].capitalize())


def _schedule_notifier():
    """notifier(kind, task) pushing TASK STARTED / TASK WAITING /
    TASK FAILED via herdr-notify send() with the tendril deep link as the
    click target — or None when the watcher is absent/unconfigured, so a
    tick never touches the network for pushes nobody receives."""
    mod = _notify_module()
    if mod is None:
        return None
    try:
        cfg = mod.load_env()
        if not mod.configured(cfg):
            return None
    except Exception:
        return None

    def notify(kind, task):
        title = SCHEDULE_TITLES.get(kind)
        if not title:
            return
        priority, tags = SCHEDULE_PUSH.get(kind, ("default", "bell"))
        body = _schedule_body(kind, task)
        click = None
        try:
            link = tendril_link.describe(HOST_LABEL, task["workspace"],
                                         task.get("workspace_label") or None,
                                         task.get("pane_id"))
            click = link.get("uri")
        except Exception:
            pass                            # a link must never eat a push
        try:
            mod.send(cfg, title, body, priority, tags, click=click)
        except Exception:
            pass                            # herdr-notify logs its own failures
    return notify


def _schedule_launcher():
    """launcher(task) → (ok, pane_id, safe phrase). Argv lists only, one
    `herdr` call per step (contract §3): a NEW target runs tab create →
    `agent start` in that pane → `agent prompt <pane> --wait`; an §7.3
    EXISTING target dispatches through the herdr agent-prompt argv ONLY
    into the pane chosen at add — never a new pane, never typed into a
    terminal. TARGET takes a pane id (verified live via
    `herdr agent get <pane>`). Failure phrases are exactly the
    contract's three.

    D10 (§13 release blocker): `--wait` used to wait for the turn to
    SETTLE with --timeout 15000, so any turn longer than 15 s — most
    real prompts — returned herdr's `timeout` after the prompt had been
    ACCEPTED and launched, and the task was stamped FAILED `prompt
    rejected` while the agent kept working (reproduced live 2026-10-11:
    a 25 s sleep task → FAILED at +15 s, pane finished at +40 s). The
    launch acknowledgment is now herdr's own pickup proof: `--wait` with
    the full `--until working blocked idle done` match set returns rc 0
    as soon as herdr OBSERVES the agent leave idle after the submission
    (its 5 s activity gate) or sees the turn already settled — rc 0
    proves execution started (or finished), never merely that bytes were
    typed. A longer turn stays RUNNING and the tick/snapshot reconcile
    finishes it (pane idle/done ⇒ DONE); rc ≠ 0 still means no execution
    evidence ⇒ FAILED `prompt rejected`."""
    def launch(task):
        if not HERDR:
            return False, None, "launch refused"
        target = task.get("target")
        if isinstance(target, dict) and target.get("kind") == "existing":
            pane = target.get("pane")
            if not isinstance(pane, str) or not PANE_RE.match(pane):
                return False, None, "launch refused"
            rc, out, err = run([HERDR, "agent", "prompt", pane,
                                task.get("prompt") or "", "--wait",
                                "--until", "working", "--until", "blocked",
                                "--until", "idle", "--until", "done",
                                "--timeout", "15000"], 25)
            if rc != 0:
                return False, None, "prompt rejected"
            return True, pane, None
        name = "tendril-" + str(task.get("id", "")).split("-")[-1]
        if not re.match(r"^[A-Za-z0-9._-]{1,32}$", name):
            return False, None, "launch refused"
        rc, out, err = run([HERDR, "tab", "create",
                            "--workspace", task.get("workspace") or "",
                            "--label", name, "--no-focus"], 12)
        if rc != 0:
            return False, None, "workspace missing"
        pane = None
        try:
            pane = find_key(json.loads(out), "pane_id")
        except (ValueError, TypeError):
            pane = None
        if not isinstance(pane, str) or not PANE_RE.match(pane):
            return False, None, "launch refused"
        rc, out, err = run([HERDR, "agent", "start", name, "--kind",
                            task.get("harness") or "", "--pane", pane,
                            "--timeout", "30000"], 45)
        if rc != 0:
            return False, None, "launch refused"
        # §11: a scheduled task that CREATED the session makes the task
        # title the session's native name. The pane's Pi extension consumes
        # this pending record on its first prompt (written BEFORE the
        # `agent prompt` below, so the ordering always holds); the wire
        # title comes from the schedule section either way (level 3).
        try:
            import tendril_titles
            tendril_titles.enqueue_native(pane, task.get("title"),
                                          kind="scheduled")
        except Exception:
            pass                            # naming never blocks a launch
        # same pickup acknowledgment as the §7.3 existing path (D10): rc 0
        # proves the fresh agent took the prompt; the turn's real length is
        # the tick/reconcile RUNNING→DONE business, not the launcher's.
        rc, out, err = run([HERDR, "agent", "prompt", pane,
                            task.get("prompt") or "", "--wait",
                            "--until", "working", "--until", "blocked",
                            "--until", "idle", "--until", "done",
                            "--timeout", "15000"], 25)
        if rc != 0:
            return False, None, "prompt rejected"
        return True, pane, None
    return launch


def _schedule_lookup():
    """pane → agent row for §7.3 add-time target validation, built lazily:
    a plain new-pane add never pays a herdr call. started_at comes from
    the agent's own transcript via tendril_telemetry (bounded, cached);
    a pane with no derivable started_at simply cannot pin the guard."""
    state = {}

    def lookup(pane):
        if "rows" not in state:
            snap = snapshot()
            state["rows"] = {a.get("pane_id"): a
                             for a in (snap or {}).get("agents", [])
                             if isinstance(a, dict) and a.get("pane_id")}
        row = state["rows"].get(pane)
        if not isinstance(row, dict):
            return None
        out = {"agent": row.get("agent"),
               "workspace_id": row.get("workspace_id"),
               "status": row.get("agent_status"),
               "started_at": None}
        try:
            import tendril_telemetry
            tele = tendril_telemetry.for_agents([row], budget=0.5)
            if isinstance(tele, list) and isinstance(tele[0], dict):
                out["started_at"] = tele[0].get("started_at")
        except Exception:
            pass
        return out
    return lookup


def _schedule_started_at_of(row):
    """started_at for one live agent row (§7.3 launch guard), from the
    agent's own transcript; None when it cannot be derived (the guard is
    then unverifiable and never guessed)."""
    try:
        import tendril_telemetry
        tele = tendril_telemetry.for_agents([row], budget=0.5)
        if isinstance(tele, list) and isinstance(tele[0], dict):
            return tele[0].get("started_at")
    except Exception:
        pass
    return None


def _schedule_reply(doc):
    print(json.dumps(doc, separators=(",", ":")))


def _schedule_cmd(args):
    """`schedule tick|list [--json]|show <id>|add <b64url>|cancel <id>` —
    the fixed scheduler verbs (LINK-CONTRACT-0.2 §3/§4). Every reply is
    ONE JSON line on stdout; only `show` ever includes the prompt text."""
    verb = args[0] if args else ""
    try:
        import tendril_schedule
    except Exception:
        print("no scheduler: tendril_schedule.py missing next to remote-agents",
              file=sys.stderr)
        return 1
    ts = tendril_schedule
    _, store_path, _ = ts.store_paths()
    if verb == "tick" and len(args) == 1:
        snap = snapshot()
        if snap is None:
            # RC2 fix: Herdr down (or no client resolved) used to feed
            # snap=None into the tick and crash the timer with TypeError
            # (run([None, "api", "snapshot"])) or fail due tasks with
            # "launch refused". A tick without Herdr is a no-op: ok reply,
            # zero launches — due tasks simply wait for a healthy tick.
            _schedule_reply({"ok": True, "tick": {
                "at": int(time.time()), "launched": 0,
                "transitions": 0}, "herdr": "unavailable"})
            return 0
        def capacity(pid):
            try:
                import tendril_capacity
                return tendril_capacity.provider_state(pid)
            except Exception:
                return None
        summary, err = ts.run_tick(store_path, now=time.time(),
                                   snap=snap, capacity=capacity,
                                   launcher=_schedule_launcher(),
                                   notifier=_schedule_notifier(),
                                   started_at_of=_schedule_started_at_of)
        if summary is None:
            _schedule_reply({"ok": False, "error": err})
            return 1
        _schedule_reply({"ok": True, "tick": summary["tick"]})
        # Capacity background refresh on the tick's own timer (contract
        # §2): runs AFTER the scheduling work and the reply — launches are
        # already done and the reply is out, so the ≤ 12 s bounded refresh
        # (a no-op when no adapter is enabled) can never delay a task, a
        # launch or this tick. Keeps enabled adapters inside their 30 min
        # staleness bound without a manual `capacity --refresh`. Never
        # raises; a busy lock (overlapping ticks) is a skip.
        try:
            import tendril_capacity
            tendril_capacity.background_refresh()
        except Exception:
            pass
        return 0
    if verb == "list" and (len(args) == 1
                           or (len(args) == 2 and args[1] == "--json")):
        tasks, err = ts.list_tasks(store_path)
        if err is not None:
            _schedule_reply({"ok": False, "error": err})
            return 1
        _schedule_reply({"ok": True,
                         "tasks": [ts.project(t) for t in tasks]})
        return 0
    if verb == "show" and len(args) == 2:
        if not ts.ID_RE.match(args[1]):
            _schedule_reply({"ok": False, "error": ts.E_ID})
            return 1
        task, err = ts.get_task(store_path, args[1])
        if err is not None:
            _schedule_reply({"ok": False, "error": err})
            return 1
        doc = ts.project(task)
        doc["prompt"] = task.get("prompt")     # ONLY show returns the prompt
        _schedule_reply({"ok": True, "task": doc})
        return 0
    if verb == "add" and len(args) == 2:
        now = time.time()
        task, err = ts.decode_add(args[1], now, lookup=_schedule_lookup())
        if err is None:
            task, err = ts.add_task(store_path, task, now)
        if err is not None:
            _schedule_reply({"ok": False, "error": err})
            return 1
        _schedule_reply({"ok": True, "task": ts.project(task)})
        return 0
    if verb == "cancel" and len(args) == 2:
        if not ts.ID_RE.match(args[1]):
            _schedule_reply({"ok": False, "error": ts.E_ID})
            return 1
        task, err = ts.cancel_task(store_path, args[1], time.time())
        if err is not None:
            _schedule_reply({"ok": False, "error": err})
            return 1
        _schedule_reply({"ok": True, "task": ts.project(task)})
        return 0
    print("usage: remote-agents schedule tick|list [--json]|show <id>"
          "|add <b64url>|cancel <id>", file=sys.stderr)
    return 2


# ---------- health/herdr: Herdr health & recovery (contract §6) ----------
HEALTH_PUSH = {"offline": ("high", "rotating_light"),
               "restored": ("default", "white_check_mark")}


# ---------- titles: the session naming verbs (DESIGN-FINAL-POLISH §11) ------

def _rename_session_cmd(args):
    """`rename-session <pane_id> <title>` / `rename-session <pane_id> --clear`
    — the manual level-1 label (§11), phone-invocable. Validation matches the
    phone launcher: a pane id, then a title sanitized on the host (control
    chars stripped, collapsed, capped at 48) or --clear. The pane must exist
    AND host a session right now: an override is never written blind, so a
    reused pane can never carry a stale label. One JSON line on stdout."""
    try:
        import tendril_titles
    except Exception:
        print("no titles module: tendril_titles.py missing next to "
              "remote-agents", file=sys.stderr)
        return 1
    if len(args) != 2:
        print("usage: remote-agents rename-session <pane_id> <title>"
              " | rename-session <pane_id> --clear", file=sys.stderr)
        return 2
    pane = args[0]
    title = None if args[1] == "--clear" else args[1]
    if not PANE_RE.match(pane):
        print(json.dumps({"ok": False, "error": "bad pane id"},
                         separators=(",", ":")))
        return 2
    snap = snapshot()
    if snap is None:
        print(json.dumps({"ok": False, "error": "Herdr is not answering"},
                         separators=(",", ":")))
        return 1
    agent = next((a for a in snap.get("agents", [])
                  if isinstance(a, dict) and a.get("pane_id") == pane), None)
    ok, phrase = tendril_titles.rename_session(pane, title, agent=agent)
    if not ok:
        print(json.dumps({"ok": False, "error": phrase},
                         separators=(",", ":")))
        return 1
    reply = {"ok": True, "pane_id": pane}
    if phrase is not None:
        reply["title"] = phrase             # --clear echoes no title
    print(json.dumps(reply, separators=(",", ":")))
    return 0


def _titles_cmd(args):
    """`titles backfill [--dry-run]` — the one-shot §11 migration: derive
    titles for root sessions that have none and persist them in the host
    cache ONLY (existing transcripts are never appended to). Idempotent."""
    try:
        import tendril_titles
    except Exception:
        print("no titles module: tendril_titles.py missing next to "
              "remote-agents", file=sys.stderr)
        return 1
    return tendril_titles.main(args)


def _health_notifier():
    """notifier(kind, title, body) pushing HERDR OFFLINE / HERDR RESTORED
    via herdr-notify send() — same lazy wiring as _schedule_notifier; None
    (a no-op) when the watcher is absent or ntfy is unconfigured. Click
    target stays None on purpose: the notification opens the app, never a
    pane (contract §6.2)."""
    mod = _notify_module()
    if mod is None:
        return None
    try:
        cfg = mod.load_env()
        if not mod.configured(cfg):
            return None
    except Exception:
        return None

    def notify(kind, title, body):
        priority, tags = HEALTH_PUSH.get(kind, ("default", "bell"))
        try:
            mod.send(cfg, title, body, priority, tags, click=None)
        except Exception:
            pass                            # herdr-notify logs its own failures
    return notify


def _health_cmd(args):
    """`health --json` — ONE bounded (≤ 3 s) JSON line describing Herdr's
    state, the tendril install, and the three services; `health tick` —
    one guardian observation (the systemd timer runs it every 30 s; it
    NEVER restarts Herdr). Read-only besides the guardian state file."""
    verb = args[0] if args else ""
    try:
        import tendril_health
    except Exception:
        print("no health module: tendril_health.py missing next to"
              " remote-agents", file=sys.stderr)
        return 1
    if verb == "--json" and len(args) == 1:
        doc = tendril_health.health_doc(host=HOST_LABEL, herdr=HERDR,
                                        run=run,
                                        binary=HERDR_PROVENANCE,
                                        client_version=HERDR_CLIENT_VERSION,
                                        stale_record=HERDR_STALE)
        print(json.dumps(doc, separators=(",", ":")))
        return 0
    if verb == "tick" and len(args) == 1:
        summary = tendril_health.run_tick(host=HOST_LABEL, herdr=HERDR,
                                          run=run,
                                          notifier=_health_notifier())
        # v0.2.1: finish a phone enrollment nobody is waiting for in a
        # terminal (the QR stays valid 10 min). Silent; never fails a tick.
        if tendril_enroll is not None:
            enroll = tendril_enroll.tick()
            if enroll.get("state") == "enrolled":
                summary["enrolled"] = enroll.get("label")
        print(json.dumps({"ok": True, "tick": summary},
                         separators=(",", ":")))
        return 0
    print("usage: remote-agents health --json|tick", file=sys.stderr)
    return 2


def _herdr_cmd(args):
    """`herdr restart|stop|start` — the fixed recovery verbs (contract
    §6.1): argv-only start through Herdr's supported headless lifecycle,
    VERIFIED before an ok; guard + rate limit per the contract. Reply is
    ONE JSON line; exit 0 only on ok."""
    verb = args[0] if args else ""
    if verb not in ("restart", "stop", "start") or len(args) != 1:
        print("usage: remote-agents herdr restart|stop|start",
              file=sys.stderr)
        return 2
    try:
        import tendril_health
    except Exception:
        print("no health module: tendril_health.py missing next to"
              " remote-agents", file=sys.stderr)
        return 1
    doc = tendril_health.herdr_verb(verb, host=HOST_LABEL, herdr=HERDR,
                                    run=run)
    print(json.dumps(doc, separators=(",", ":")))
    return 0 if doc.get("ok") else 1


def _capacity_cmd(rest):
    """`capacity [--json] [--refresh]` — ONE compact JSON line: the contract
    §1 capacity section (provider ids, states, windows, tokens by day;
    never transcript content, never credentials). `capacity status` prints
    the human table instead; `capacity enable|disable <adapter>` opts in or
    out of a network usage adapter (claude_oauth|codex_wham|zai_quota;
    stored in ~/.config/tendril/capacity.json); enabling also triggers one
    immediate bounded refresh and prints one honest line when the first
    sample did not land (offline-safe: the enable always succeeds first).
    Without --refresh the verb
    serves the cached/locally-derived section through snapshot_section's
    1 s budget (instant when the cache is fresh) and never touches the
    network; --refresh rescans now and also allows the enabled network
    adapters. Exit 0 ok, 2 usage, 1 module missing."""
    flags = [a for a in rest if a.startswith("--")]
    pos = [a for a in rest if not a.startswith("--")]
    if [f for f in flags if f not in ("--json", "--refresh")] \
            or (pos and pos[0] not in ("status", "enable", "disable")) \
            or (pos and pos[0] in ("enable", "disable") and len(pos) != 2) \
            or (pos and pos[0] == "status" and len(pos) != 1):
        print("usage: remote-agents capacity [--json] [--refresh]\n"
              "       remote-agents capacity status\n"
              "       remote-agents capacity enable|disable "
              "<claude_oauth|codex_wham|zai_quota>", file=sys.stderr)
        return 2
    try:
        import tendril_capacity as cap
    except ImportError:
        print("tendril_capacity.py is missing next to remote-agents; "
              "re-run ./install", file=sys.stderr)
        return 1
    refresh = "--refresh" in flags
    if not pos or pos[0] == "status":
        try:
            if refresh:
                sec = cap.collect(refresh=True,
                                  budget_s=cap.REFRESH_BUDGET_S)
            else:
                sec = cap.snapshot_section(budget_s=1.0)[0]
        except Exception:
            sec = None
        if not isinstance(sec, dict) or not sec:
            sec = {"generated_at": int(time.time()), "providers": []}
        if not pos:
            print(json.dumps(sec, separators=(",", ":")))
            return 0
        try:
            print(cap.status_text(sec))
        except Exception:
            print("capacity unavailable on this host")
        return 0
    if not cap.set_enabled(pos[1], pos[0] == "enable"):
        print("unknown adapter '%s'; valid: %s"
              % (pos[1], " ".join(cap.NET_IDS)), file=sys.stderr)
        return 2
    print("%s %s" % (pos[1], "enabled" if pos[0] == "enable"
                     else "disabled"))
    if pos[0] == "enable":
        # One immediate bounded refresh so the phone stops showing "not
        # reporting" the moment an adapter is enabled — best effort: the
        # enable above already succeeded, and a failed fetch (offline, bad
        # credentials, a concurrent tick refreshing) only means the first
        # sample arrives with the next tick. One honest line, no secrets,
        # no raw errors.
        try:
            cap.background_refresh()
        except Exception:
            pass
        if not cap.adapter_reported(pos[1]):
            print("enabled; first sample will arrive within 5 min")
    return 0


def _reachable_rows():
    """(rows, 0) or (None, 1) — the shared 'can we talk to Herdr?' gate."""
    if not HERDR:
        print(f"{C_RED}no compatible herdr client found{C_RESET}")
        for cand, ok, detail in HERDR_VERDICTS:
            print(f"  [{'ok' if ok else 'REJECT'}] {cand}: {detail}")
        return None, 1
    rows = collect()
    if rows is None:
        print(f"{C_RED}cannot reach the Herdr server.{C_RESET} "
              f"{C_GRAY}Is it running? Try: herdr status{C_RESET}")
        return None, 1
    return rows, 0


def _close_rows(rows, token):
    """Up to 5 near-miss rows (matched on id or label) for unknown tokens."""
    names = {}
    for r in rows:
        names.setdefault(r["id"], r)
        names.setdefault(r["label"], r)
    near = difflib.get_close_matches(token, list(names), n=5, cutoff=0.5)
    if not near:
        low = token.lower()
        near = [n for n in names if low in n.lower()][:5]
    return [names[n] for n in near]


def _resolve_session(rows, token):
    """(row, 0) or (None, exit-code), with a diagnostic on stderr."""
    row, failure = resolve_token(rows, token)
    if row is not None:
        return row, 0
    kind, hits = failure
    if kind == "ambiguous":
        print(f"{C_RED}'{token}' matches several sessions:{C_RESET}", file=sys.stderr)
        for r in hits[:5]:
            print(f"  {r['id']}  {r['label']}", file=sys.stderr)
        return None, 3
    print(f"{C_RED}no session matches '{token}' on {HOST_LABEL} "
          f"(stale id? the workspace may be gone){C_RESET}", file=sys.stderr)
    for r in _close_rows(rows, token):
        print(f"{C_GRAY}  closest: {r['id']}  {r['label']}{C_RESET}", file=sys.stderr)
    return None, 2


def _session_link(row, pane=None):
    """tendril_link.describe() for a row -- narrowed to the exact pane
    when one is given -- or None with a diagnostic."""
    if tendril_link is None:
        print(f"{C_RED}tendril_link missing next to remote-agents - re-run install{C_RESET}",
              file=sys.stderr)
        return None
    try:
        return tendril_link.describe(HOST_LABEL, row["id"], row["label"],
                                     pane)
    except tendril_link.LinkError as exc:
        print(f"{C_RED}link error: {exc}{C_RESET}", file=sys.stderr)
        return None


def _herdr_running():
    '"running" when `herdr status` says so, "unknown" otherwise (best effort).'
    rc, out, err = run([HERDR, "status"], 6)
    if rc == 0 and re.search(r"status:\s*running", (out or "") + (err or "")):
        return "running"
    return "unknown"


def session_json(row, pane=None):
    """One-line canonical JSON for resolve/focus: everything a notification
    or deep-link consumer needs. link/payload_b64 come from tendril_link.
    With a live pane entry (pane-id tokens), pane_id/tab_id name the exact
    pane and agent is THAT pane's agent, not the workspace's first."""
    link = _session_link(row, pane.get("pane_id") if pane else None)
    if link is None:
        return None
    doc = {
        "host": HOST_LABEL,
        "workspace_id": row["id"],
        "label": row["label"],
        "number": row["number"],
        "cwd": row["path"] or "",
        "agent": (row["agents"][0].get("agent") or "") if row["agents"] else "",
        "agent_status": _RANK_NAME.get(row.get("rank", 4), "unknown"),
        "agents": [{"agent": a.get("agent") or "",
                    "agent_status": a.get("agent_status") or "unknown",
                    "pane_id": a.get("pane_id") or ""} for a in row["agents"]],
        "focused": bool(row.get("focused")),
        "link": link["uri"],
        "payload_b64": link["payload_b64"],
        "herdr_status": _herdr_running(),
    }
    if pane is not None:
        doc["pane_id"] = pane.get("pane_id") or ""
        doc["tab_id"] = pane.get("tab_id") or ""
        doc["agent"] = pane.get("agent") or ""
    return json.dumps(doc, separators=(",", ":"))


def _stale_pane_not_found(rows, token):
    """The existing not-found path for a stale pane id: diagnostic + closest
    live ids on stderr, non-zero exit (TEST LINK reports SESSION NOT FOUND)."""
    print(f"{C_RED}no session matches '{token}' on {HOST_LABEL} "
          f"(stale id? the agent session may have ended){C_RESET}", file=sys.stderr)
    for r in _close_rows(rows, token):
        print(f"{C_GRAY}  closest: {r['id']}  {r['label']}{C_RESET}", file=sys.stderr)
    return 2


def _enter_session(rows, token):
    """enter <token> -- the notification entry lifecycle: resolve, exact
    focus (verified), the same Ctrl+Home-bridged attach the selector uses,
    then -- when the user detaches -- the normal selector loop in this same
    process. A stale pane attaches nothing: the selector opens with a
    one-line notice, the parent workspace preselected when it still exists."""
    if PANE_RE.match(token):
        pane = _pane_lookup(token)
        row = None
        if pane is not None:
            parent = pane.get("workspace_id") or token.split(":", 1)[0]
            row, _ = resolve_token(rows, parent)
        if pane is None or row is None:
            return _stale_pane_selector(rows, token)
        if not attach(row, pane=pane):      # focus not verifiable: stale
            return _stale_pane_selector(rows, token)
    else:
        row, code = _resolve_session(rows, token)
        if row is None:
            return code
        attach(row)                         # workspace semantics, unchanged
    fresh = collect()
    if fresh is None:
        fresh = rows
    return _selector_after(fresh, preferred_id=row["id"])


def _run_subcommand(cmd, token):
    """attach/enter/resolve/focus/link: never interactive (enter falls into
    the selector only after its attach detaches), safe over plain SSH.
    Exit codes: 0 ok, 1 Herdr unreachable, 2 unknown/stale token, 3 ambiguous.
    Pane ids are exact: the pane must exist (else the not-found path) and
    focus verifies against the snapshot before anything attaches."""
    rows, code = _reachable_rows()
    if rows is None:
        return code
    if cmd == "enter":
        return _enter_session(rows, token)
    pane = None
    if cmd in ("attach", "resolve", "focus") and PANE_RE.match(token):
        pane = _pane_lookup(token)
        if pane is None:
            return _stale_pane_not_found(rows, token)
    row, code = _resolve_session(rows, token)
    if row is None:
        return code
    if cmd == "attach":
        print(f"{C_GRAY}found session '{row['label']}' ({row['id']}){C_RESET}", flush=True)
        attach(row, pane=pane)
        return 0
    if cmd == "link":
        link = _session_link(row)
        if link is None:
            return 2
        print(link["uri"])
        return 0
    doc = session_json(row, pane=pane)      # resolve and focus print the same body
    if doc is None:
        return 2
    if cmd == "focus":                      # headless hook: focus only, no session attach
        if pane is not None:
            if not _focus_pane(pane):
                print(f"{C_RED}could not verify focus for '{token}' "
                      f"-- treat it as stale{C_RESET}", file=sys.stderr)
                return 2
        else:
            run([HERDR, "workspace", "focus", row["id"]], 6)
    print(doc)
    return 0


SERVICE_VERBS = ("status", "start", "stop", "restart", "logs")


def _service(args):
    """`tendril service <verb>`: the notification watcher, on whichever
    service manager this host has (launchd LaunchAgent / systemd user unit)."""
    if len(args) != 1 or args[0] not in SERVICE_VERBS:
        print("usage: remote-agents service " + "|".join(SERVICE_VERBS),
              file=sys.stderr)
        return 2
    if tendril_host is None:
        print("tendril_host.py is missing next to remote-agents; re-run ./install",
              file=sys.stderr)
        return 1
    return tendril_host.main(["service", args[0]])


def _pair_ssh_target():
    """Where the phone dials: config SSH_TARGET -> the Tailscale MagicDNS
    FQDN when answerable -> config SSH_ALIAS -> the host identity itself
    (binding contract; display-only in the Link app, dialled by the block
    `--pair` prints)."""
    target = (CONFIG.get("SSH_TARGET") or "").strip()
    if target:
        return target
    if tendril_host is not None:
        try:
            fqdn = tendril_host.tailscale_identity()[1]
        except Exception:                       # never let pairing crash on it
            fqdn = ""
        if fqdn:
            return fqdn
    return (CONFIG.get("SSH_ALIAS") or "").strip() \
        or (tendril_link.host_identity(CONFIG)
            if tendril_link is not None and hasattr(tendril_link, "host_identity")
            else HOST_LABEL)


def _pair_source_dir():
    """The checkout the launchers are copied from: install.json provenance
    first, then the checkout this command runs from (realpath), but only
    when it actually contains phone/tendril. None when nothing is provable."""
    try:
        with open(os.path.expanduser(
                "~/.config/remote-agents/install.json"), encoding="utf-8") as f:
            src = (json.load(f) or {}).get("source_dir")
        if src and os.path.isfile(os.path.join(src, "phone", "tendril")):
            return src
    except (OSError, ValueError):
        pass
    repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    if os.path.isfile(os.path.join(repo, "phone", "tendril")):
        return repo
    return None


def _notify_config():
    """(url, topic, token) from notify.env; NTFY_SUBSCRIBE_TOKEN (a
    read-only ntfy token — recommended) preferred over the legacy
    NTFY_TOKEN. Missing file or keys: empty strings, never an error. The
    values are only ever encoded into the pairing payload — never
    printed."""
    url = topic = subscribe = legacy = ""
    try:
        with open(NOTIFY_ENV, encoding="utf-8") as f:
            for ln in f:
                ln = ln.strip()
                if ln.startswith("NTFY_URL="):
                    url = ln.split("=", 1)[1].strip().strip('"').strip("'")
                elif ln.startswith("NTFY_TOPIC="):
                    topic = ln.split("=", 1)[1].strip().strip('"').strip("'")
                elif ln.startswith("NTFY_SUBSCRIBE_TOKEN="):
                    subscribe = ln.split("=", 1)[1].strip().strip('"').strip("'")
                elif ln.startswith("NTFY_TOKEN="):
                    legacy = ln.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return url, topic, (subscribe or legacy)


def _pair_reach(target):
    """Display transport for REACH: over Tailscale (MagicDNS target, or
    Tailscale answering at all) the phone dials mosh when it is on PATH,
    else plain ssh; anything else is just SSH. Purely informational —
    never blocks pairing."""
    tailscale = target.endswith(".ts.net")
    if not tailscale and tendril_host is not None:
        try:
            tailscale = bool(tendril_host.tailscale_identity()[1])
        except Exception:                       # garnish: never a crash
            tailscale = False
    if not tailscale:
        return "SSH"
    return "Tailscale + " + ("Mosh" if shutil.which("mosh") else "SSH")


def _pair_bootstrap_command(reach):
    """The ONE new-phone bootstrap command (binding contract, "New-phone
    bootstrap"): Termux tools, a key if needed, the key copied to the
    host once (ssh-copy-id), then the host's auditable phone setup
    script."""
    return ("pkg install -y openssh mosh && "
            "{ [ -f ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -N '' "
            "-f ~/.ssh/id_ed25519 -C termux; } && "
            f"ssh-copy-id {reach} && "
            f"ssh {reach} remote-agents --phone-script setup "
            "> \"$PREFIX/tmp/tendril-setup.sh\" && sh \"$PREFIX/tmp/tendril-setup.sh\"")


def _pair_qr(code, indent=2):
    """Print the code as an ANSI QR when qrencode is on PATH and the block
    fits the terminal (minus the indent); one plain hint line when it is
    too narrow, nothing at all without qrencode. Garnish — never a
    failure. Returns True when anything was printed."""
    lines = None
    if tendril_qr is not None:
        try:
            lines = tendril_qr.render(code)
        except Exception:
            lines = None
    if lines is None:
        qrencode = shutil.which("qrencode")
        if not qrencode:
            return False
        try:
            qr = subprocess.run([qrencode, "-t", "ansiutf8", "-m", "1", code],
                                capture_output=True, text=True, timeout=15)
        except (OSError, subprocess.TimeoutExpired):
            return False
        if qr.returncode != 0 or not qr.stdout:
            return False
        lines = qr.stdout.rstrip("\n").splitlines()
    width = max((len(ln) for ln in lines), default=0)
    if width + indent > shutil.get_terminal_size(fallback=(80, 24)).columns:
        print(" " * indent
              + "(widen the terminal to see the QR)")
        return True
    for ln in lines:
        print(" " * indent + ln)
    return True


PHONE_SETUP_COMMAND = ("curl -fsSL https://raw.githubusercontent.com/"
                       "Ozymandes/TENDRIL/main/phone/setup.sh | sh")
PHONE_INSTALL_COMMAND = "tendril install"


def _pair_print(mode, code, host, target, user, notify_ready, enroll=False):
    """`tendril --pair` output (v0.2.1). Default: the identity summary, the
    QR and — under it — the SAME pairing code as text for Link's "Paste
    code instead" (one session, one TTL, one set of trust data). --manual:
    the code without the QR (no camera). --legacy: the old password-based
    SSH bootstrap, for hosts without a notification server only."""
    reach = f"{user}@{target}"
    print(f"{C_LIME}TENDRIL // PAIR YOUR PHONE{C_RESET}")
    print("")
    if mode == "legacy":
        print(f"{C_GRAY}  Compatibility setup (no notification server on this host).{C_RESET}")
        print(f"{C_GRAY}  1.{C_RESET} Install Termux from F-Droid (not the Play Store build).")
        print(f"{C_GRAY}  2.{C_RESET} Paste this one command into Termux:")
        print("")
        print(f"     {_pair_bootstrap_command(reach)}")
        print("")
        print(f"{C_GRAY}  3.{C_RESET} It asks for your host password once (for ssh-copy-id), then sets up the phone.")
        print("")
        print(f"{C_GRAY}  Already set up?{C_RESET}  in Termux:  tendril --upgrade")
        return 0
    rows = [
        ("HOST", host),
        ("REACH", _pair_reach(target)),
        ("NOTIFY", "ready" if notify_ready else "not configured — run  tendril install"),
    ]
    for label, value in rows:
        print(f"{C_GRAY}  {label:<9}{C_RESET}{value}")
    print("")
    if mode != "manual" and _pair_qr(code):
        print("")
    if mode == "manual":
        print(f"  In {C_LIME}TENDRIL Link{C_RESET}: Pair → {C_LIME}Paste code instead{C_RESET}.")
    else:
        print(f"  Scan with {C_LIME}TENDRIL Link{C_RESET}.")
    if enroll:
        print(f"{C_GRAY}  One phone, valid 10 minutes.{C_RESET}")
    print("")
    # The text twin of the QR: the same code, on a line of its own so a
    # terminal copy yields exactly the code. It carries the one-time
    # enrollment secret: shown like the QR, on your own screen only.
    print(f"{C_GRAY}  Manual code (Paste code instead):{C_RESET}")
    print(code)
    print("")
    print(f"{C_GRAY}  Phone not set up yet? In Termux:{C_RESET}")
    print(f"    {PHONE_INSTALL_COMMAND}")
    print(f"{C_GRAY}  (first time on a new phone: {PHONE_SETUP_COMMAND}){C_RESET}")
    return 0


def _pair_wait(session, interval=2.0):
    """Wait for the phone to enroll (v3): poll the one-time topic until the
    key is installed or the QR expires. Ctrl+C stops waiting only — the
    guardian timer finishes a late enrollment in the background."""
    tty = sys.stdout.isatty()
    unreachable = 0
    print("")
    try:
        while True:
            res = tendril_enroll.process_once(session)
            state = res.get("state")
            if state == "enrolled":
                if tty:
                    sys.stdout.write("\r\033[K")
                fp = res.get("fingerprint") or ""
                print(f"  {C_LIME}\u2713{C_RESET} Phone enrolled \u00b7 {res.get('label')} "
                      f"{C_GRAY}{fp}{C_RESET}")
                print("")
                print(f"  {C_LIME}Host ready.{C_RESET} TENDRIL Link finishes the link on the phone.")
                return 0
            if state in ("expired", "none"):
                if tty:
                    sys.stdout.write("\r\033[K")
                print("  The pairing QR expired. Run  tendril --pair  for a new one.")
                return 1
            unreachable = unreachable + 1 if state == "unreachable" else 0
            left = max(0, int(session["expires"] - time.time()))
            word = ("notification server unreachable \u2014 retrying"
                    if unreachable >= 3 else "waiting for your phone")
            if tty:
                sys.stdout.write(f"\r\033[K  {C_GRAY}{word} \u00b7 "
                                 f"{left // 60}:{left % 60:02d} left \u00b7 Ctrl+C to stop{C_RESET}")
                sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        if tty:
            sys.stdout.write("\r\033[K")
        until = time.strftime("%H:%M", time.localtime(session["expires"]))
        print(f"  Stopped waiting. The QR stays valid until {until}; "
              "the host finishes the pairing in the background.")
        return 0


MANAGED_SRC = os.path.join(os.path.expanduser("~"), ".local", "share",
                           "tendril", "src")


def _install_cmd(rest):
    """`tendril install` — THE host install/repair command (v0.2.1): the
    same product flow as the first bootstrap (setup.sh): platform, Herdr,
    runtime, scheduler, guardian, notifications (zero-config private
    topic), capacity, health — ending on the pairing QR when no phone is
    linked yet. Idempotent. A developer checkout recorded in install.json
    is used as it is (never fetched or switched); only the managed
    checkout (~/.local/share/tendril/src) fast-forwards."""
    flags = {"--no-pair"}
    if any(a not in flags for a in rest):
        print("usage: tendril install [--no-pair]", file=sys.stderr)
        return 2
    src = _pair_source_dir()
    setup = os.path.join(src, "setup.sh") if src else None
    if not setup or not os.path.isfile(setup):
        print("tendril install: cannot find the TENDRIL source (setup.sh). "
              "Run the first bootstrap again:", file=sys.stderr)
        print("  curl -fsSL https://raw.githubusercontent.com/Ozymandes/"
              "TENDRIL/main/setup.sh | sh", file=sys.stderr)
        return 1
    env = dict(os.environ, TENDRIL_SRC=src)
    if os.path.realpath(src) != os.path.realpath(MANAGED_SRC):
        env["TENDRIL_SRC_PINNED"] = "1"
    if "--no-pair" in rest:
        env["TENDRIL_NO_PAIR"] = "1"
    sh = shutil.which("sh") or "/bin/sh"
    os.execve(sh, [sh, setup], env)


def _pair(args):
    """`tendril --pair`: pair a phone with TENDRIL Link (v0.2.1).

    Default (notifications configured): a v3 code — host, ssh target,
    user, the ntfy config AND a one-shot enrollment session + the
    host-key fingerprint — shown as a QR, then a live wait until the phone
    has enrolled its SSH key. --code prints only the code (scripts),
    --show-code also prints it under the QR, --no-wait returns at once
    (the guardian finishes), --manual is the password-based bootstrap for
    hosts without notifications. Flags-only like --upgrade: a bare word is
    a session-token position. Invalid values: one clear error, no code."""
    rest = [a for a in args if a != "--pair"]
    # --show-code: accepted for compatibility (the code is always shown now)
    flags = {"--code", "--manual", "--legacy", "--show-code", "--no-wait"}
    code_only = "--code" in rest
    manual = "--manual" in rest
    legacy = "--legacy" in rest
    show_code = "--show-code" in rest
    no_wait = "--no-wait" in rest
    rest = [a for a in rest if a not in flags]
    if rest or args.count("--pair") != 1 \
            or (code_only + manual + legacy + show_code) > 1:
        print("usage: tendril --pair [--code | --manual | --legacy] [--no-wait]",
              file=sys.stderr)
        return 2
    if tendril_link is None or not hasattr(tendril_link, "pairing_code_v3"):
        print("tendril_link.py is missing or stale next to remote-agents; "
              "re-run ./install", file=sys.stderr)
        return 1
    host = tendril_link.host_identity(CONFIG)
    target = _pair_ssh_target()
    try:
        user = getpass.getuser() or ""
    except Exception:
        user = ""
    if legacy:
        return _pair_print("legacy", "", host, target, user, False)
    url, topic, token = _notify_config()
    session = None
    code = None
    if url and topic and tendril_enroll is not None:
        session = tendril_enroll.start(url)
        try:
            code = tendril_link.pairing_code_v3(
                host, target, user, url, topic, token=token or None,
                enroll_topic=session["topic"], enroll_secret=session["secret"],
                hostkey_fp=tendril_enroll.host_key_fingerprint())
        except tendril_link.LinkError:
            tendril_enroll.clear()
            session = None
    notify_ready = code is not None
    if code is None:            # no usable ntfy: a v2 code, enrollment by hand
        try:
            code = tendril_link.pairing_code_v2(host, target, user)
        except tendril_link.LinkError as exc:
            print(f"cannot pair: {exc}", file=sys.stderr)
            return 1
    if code_only:
        print(code)
        return 0
    _pair_print("manual" if manual else "pretty", code, host, target, user,
                notify_ready, enroll=session is not None)
    if session is None:
        print("")
        print(f"{C_GRAY}  This code cannot enroll the phone's SSH key (no notification"
              f" server).{C_RESET}")
        print(f"{C_GRAY}  Run  tendril install  to set notifications up, or use"
              f"  tendril --pair --legacy  (password-based).{C_RESET}")
        return 0
    # wait only in front of a person: scripts and pipes get the code and
    # return (the guardian timer finishes the enrollment in the background)
    if no_wait or not (sys.stdin.isatty() and sys.stdout.isatty()):
        return 0
    return _pair_wait(session)


