                              one phone launch: prints `open` once, then clears
  tendril --link-stage <path> stage a built TENDRIL Link APK (tendril-link.apk
                              + tendril-link.json) so phones can pick it up
  tendril --link-fetch [<tag>] stage the OFFICIAL release of TENDRIL Link from
                              GitHub (pinned release signer, sha256, size) so
                              phones discover and install updates from the app
  tendril --version           the installed version and commit
  tendril --help              this help

Upgrade and pair are flags-only on purpose: a bare word is a session-token
position and a workspace may legitimately be labeled "upgrade" or "pair".
Also:
  --detect                    herdr client detection detail
"""


def _upgrade(args):
    """`tendril --upgrade`: self-update from the recorded source checkout.
    Deliberately flags-only — no bare `upgrade` word: a single word is a
    session-token position and a workspace may legitimately be labeled
    "upgrade"; --upgrade cannot collide."""
    verbose = "--verbose" in args
    extra = [a for a in args if a not in ("--upgrade", "--verbose")]
    if extra or args.count("--upgrade") != 1:
        print("usage: tendril --upgrade [--verbose]", file=sys.stderr)
        return 2
    if tendril_upgrade is None:
        print("tendril_upgrade.py is missing next to remote-agents; re-run ./install",
              file=sys.stderr)
        return 1
    try:
        return tendril_upgrade.upgrade_main(verbose=verbose)
    except tendril_upgrade.Refused as exc:
        # mirror tendril_upgrade.main: a refusal is guidance, never a traceback
        print("tendril --upgrade: %s" % exc, file=sys.stderr)
        return 1


PHONE_FLAGS = ("--phone-manifest", "--phone-asset", "--phone-script",
               "--link-stage", "--link-fetch")
PHONE_USAGE = ("usage: tendril --phone-manifest\n"
               "       tendril --phone-asset "
               "<tendril|termux-url-opener|agent|link-apk>\n"
               "       tendril --phone-script <setup|upgrade>\n"
               "       tendril --link-stage <path>")


def _phone(args):
    """The phone channel (binding contract §2): flags-only like --pair and
    --upgrade — a bare word is a session-token position. Exactly one phone
    flag per call; tendril_phone.py validates the arguments strictly."""
    if sum(1 for f in PHONE_FLAGS if f in args) != 1:
        print(PHONE_USAGE, file=sys.stderr)
        return 2
    if tendril_phone is None:
        print("tendril_phone.py is missing next to remote-agents; "
              "re-run ./install", file=sys.stderr)
        return 1
    return tendril_phone.main(args)


def main():
    if "--detect" in sys.argv:
        for cand, ok, detail in HERDR_VERDICTS:
            tag = "SELECTED" if cand == HERDR else ("REJECT" if not ok else "skip  ")
            print(f"[{tag}] {cand}\n        {detail}")
        print("chosen:", HERDR or "NONE")
        return 0
    args = sys.argv[1:]
    if "--version" in args:
        if tendril_upgrade is not None:
            print(tendril_upgrade.version_line())
        else:
            print("tendril (unknown - tendril_upgrade.py missing; re-run ./install)")
        return 0
    if "--help" in args or "-h" in args:
        print(HELP, end="")
        return 0
    if "--upgrade" in args:
        return _upgrade(args)
    if "--link-open-request" in args:
        i = args.index("--link-open-request")
        return _link_open_request(args[i + 1] if i + 1 < len(args) else None)
    if "--pair" in args:
        return _pair(args)
    if any(a in args for a in PHONE_FLAGS):
        return _phone(args)
    if args[:1] == ["snapshot"]:
        rest = args[1:]
        inm = None
        if "--if-none-match" in rest:
            i = rest.index("--if-none-match")
            val = rest[i + 1] if i + 1 < len(rest) else None
            if val is None or not re.match(r"^[0-9a-f]{16}$", val):
                print("usage: remote-agents snapshot [--json] "
                      "[--if-none-match <etag>]", file=sys.stderr)
                return 2
            inm = val
            rest = rest[:i] + rest[i + 2:]
        rest = [a for a in rest if a != "--json"]
        if rest:
            print("usage: remote-agents snapshot [--json] "
                  "[--if-none-match <etag>]", file=sys.stderr)
            return 2
        return _snapshot_cmd(if_none_match=inm)
    if args[:1] == ["install"]:
        return _install_cmd(args[1:])
    if args[:1] == ["capacity"]:
        return _capacity_cmd(args[1:])
    if args[:1] == ["schedule"]:
        return _schedule_cmd(args[1:])
    if args[:1] == ["rename-session"]:
        return _rename_session_cmd(args[1:])
    if args[:1] == ["titles"]:
        return _titles_cmd(args[1:])
    if args[:1] == ["health"]:
        return _health_cmd(args[1:])
    if args[:1] == ["herdr"]:
        return _herdr_cmd(args[1:])
    if args[:1] == ["service"]:
        return _service(args[1:])
    if len(args) == 2 and args[0] in SUBCOMMANDS:
        return _run_subcommand(args[0], args[1])
    if args:
        print("usage: remote-agents [attach|enter|resolve|focus|link] <session-token>",
              file=sys.stderr)
        print("       <session-token>: workspace id (w15), pane id (w15:p1),",
              file=sys.stderr)
        print("       workspace number or exact label; no args opens the selector",
              file=sys.stderr)
        print("       enter: exact focus + attach, then the selector (notification taps)",
              file=sys.stderr)
        print("       remote-agents service status|start|stop|restart|logs",
              file=sys.stderr)
        print("       remote-agents snapshot [--json] - LIVE MAP JSON for the Link app",
              file=sys.stderr)
        print("       remote-agents capacity [--json] [--refresh] | capacity status",
              file=sys.stderr)
        print("       remote-agents health --json|tick | herdr restart|stop|start",
              file=sys.stderr)
        print("       remote-agents rename-session <pane_id> <title|--clear> "
              "| titles backfill [--dry-run]", file=sys.stderr)
        print("       remote-agents capacity enable|disable "
              "<claude_oauth|codex_wham|zai_quota>", file=sys.stderr)
        print("       remote-agents install [--no-pair] | --pair [--code | --manual | --legacy] "
              "| --upgrade [--verbose]",
              file=sys.stderr)
        print("       remote-agents --phone-manifest | --phone-asset <name> "
              "| --phone-script <setup|upgrade> | --link-stage <path>",
              file=sys.stderr)
        print("       remote-agents --version | --help",
              file=sys.stderr)
        return 2
    rows, code = _reachable_rows()
    if rows is None:
        return code
    tty_mode = sys.stdin.isatty()
    fd = sys.stdin.fileno() if tty_mode else None
    return menu_loop(rows, tty_mode, fd)


if __name__ == "__main__":
    sys.exit(main())
