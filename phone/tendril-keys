#!/usr/bin/env python3
"""tendril-keys — add the TENDRIL detach button to the Termux extra-keys row.

    PHONE BUTTON ⌂  →  Termux macro "ALT d"  →  Alt+D  →  Herdr detach
                                                        ↳ back to TENDRIL

Runs on the PHONE (Termux). Edits ~/.termux/termux.properties:
  - backs the file up (termux.properties.bak.<epoch>) before writing
  - touches only the extra-keys value; every other property is preserved
    byte-for-byte
  - never removes or rebinds an existing button (a plain HOME button, for
    example, keeps working)
  - layouts it cannot parse safely are left untouched; the exact manual
    snippet is printed instead
  - reloads settings via termux-reload-settings when available

Usage:  tendril-keys          (idempotent; safe to re-run)
"""
import ast
import json
import os
import re
import shutil
import subprocess
import sys
import time

PROPS = os.path.expanduser("~/.termux/termux.properties")
MACRO = "ALT d"                      # what Herdr already binds to detach
BUTTON = {"macro": MACRO, "display": "\u2302"}   # ⌂

# Termux's built-in two-row layout (wiki: Touch Keyboard), plus the button.
DEFAULT_LAYOUT = [
    ["ESC", "/", "-", "HOME", "UP", "END", "PGUP", BUTTON],
    ["TAB", "CTRL", "ALT", "LEFT", "DOWN", "RIGHT", "PGDN", "BKSP"],
]


def installed(layout):
    """True when a button sending our macro is already present."""
    for row in layout:
        for key in row:
            if isinstance(key, dict) and \
                    key.get("macro", "").split() == MACRO.split():
                return True
    return False


def parse_layout(value):
    """Strict JSON first, then Python-literal (single-quoted) layouts.

    Returns (layout, None) on success or (None, reason) when the layout is
    too exotic to merge safely."""
    for load in (json.loads, ast.literal_eval):
        try:
            layout = load(value)
        except (ValueError, SyntaxError):
            continue
        if (isinstance(layout, list) and layout
                and all(isinstance(r, list) for r in layout)):
            return layout, None
        return None, "unexpected extra-keys shape (expected rows of keys)"
    return None, "unrecognized extra-keys syntax"


def split_logical_block(lines):
    """Index range of the extra-keys property (incl. backslash continuations),
    or None when the property is absent."""
    start = next((i for i, ln in enumerate(lines)
                  if re.match(r"\s*extra-keys\s*=", ln)), None)
    if start is None:
        return None
    end = start
    while end + 1 < len(lines) and lines[end].rstrip("\r\n").endswith("\\"):
        end += 1
    return start, end


def main():
    text = open(PROPS).read() if os.path.isfile(PROPS) else ""
    lines = text.splitlines(keepends=True)
    block = split_logical_block(lines)

    if block is None:
        layout = DEFAULT_LAYOUT
        if text and not text.endswith("\n"):
            text += "\n"
        lines = [text + "extra-keys = %s\n"
                 % json.dumps(layout, ensure_ascii=False)]
        action = "created termux.properties with Termux's default rows + \u2302"
    else:
        start, end = block
        raw = "".join(lines[start:end + 1]).split("=", 1)[1]
        raw = re.sub(r"\\\r?\n", " ", raw).strip()
        layout, why = parse_layout(raw)
        if layout is None:
            print(f"could not merge safely ({why}) - nothing was changed.\n"
                  "Add the button by hand in ~/.termux/termux.properties:\n"
                  '  extra-keys = [[ ... , {"macro": "ALT d", "display": "\u2302"} ]]'
                  "\nthen run: termux-reload-settings")
            return 1
        if installed(layout):
            print("\u2302 detach button already present - nothing to do")
            return 0
        layout[0].append(BUTTON)
        action = "added \u2302 to the first extra-keys row"
        lines[start:end + 1] = ["extra-keys = %s\n"
                                % json.dumps(layout, ensure_ascii=False)]

    if os.path.isfile(PROPS):
        bak = "%s.bak.%d" % (PROPS, int(time.time()))
        shutil.copy2(PROPS, bak)
        print("backup: %s" % bak)
    os.makedirs(os.path.dirname(PROPS), exist_ok=True)
    with open(PROPS, "w") as f:
        f.write("".join(lines))
    print(f"{action} -> press \u2302 to detach Herdr back to TENDRIL "
          f"(macro {MACRO})")
    if shutil.which("termux-reload-settings"):
        subprocess.run(["termux-reload-settings"], check=False)
        print("termux-reload-settings: applied")
    else:
        print("run: termux-reload-settings")
    return 0


if __name__ == "__main__":
    sys.exit(main())
