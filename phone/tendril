#!/data/data/com.termux/files/usr/bin/sh
# tendril — TENDRIL client launcher: connect to the host (Mosh preferred, SSH fallback).
# Termux runs this file as-is; `./install --client` installs it on macOS and
# Linux desktops with a #!/bin/sh shebang. Plain POSIX sh, nothing else.
# The phone/agent compatibility wrapper delegates to this launcher.
#
# One-time setup (see docs/ANDROID.md, docs/MACOS.md):
#   1. pkg install openssh mosh
#   2. ssh-keygen -t ed25519   (dedicated Termux key; never share private keys)
#   3. create ~/.ssh/config with your Host alias
#   4. ssh-copy-id <alias>
#   5. either pass the alias every time:  tendril <alias>
#      or set it once in your profile:  export TENDRIL_ALIAS=<alias>  (AGENT_ALIAS works)
#      or once in ~/.config/tendril/alias (one line; written by ./install --client)
#
# Usage:
#   tendril              connect using $TENDRIL_ALIAS (or $AGENT_ALIAS)
#   tendril <alias>      connect using <alias>
#   tendril ssh <alias>  force plain SSH (skip Mosh)
#   tendril attach <id>          direct-attach session <id> on the default alias
#   tendril <alias> attach <id>  direct-attach session <id> via an explicit alias
#   tendril enter <id>           notification entry: exact focus + attach,
#                                then the selector (same lifecycle as a tap)
#   tendril [<alias>] resolve|focus|link <id>
#                                print JSON / focus headless / print the deep
#                                link, over plain SSH (no TTY, no Mosh)
#   tendril snapshot              the LIVE MAP snapshot: ONE line of JSON
#   tendril <alias> snapshot      (remote-agents snapshot) over plain SSH —
#                                 no TTY, no Mosh; read by the TENDRIL Link app
#   tendril [<alias>] schedule show|cancel <id>
#   tendril [<alias>] schedule add <payload>
#                                 the host scheduler over plain SSH (no TTY,
#                                 no Mosh): id is t-YYYYMMDD-8hex, payload is
#                                 1..16384 base64url chars (A-Z a-z 0-9 _ -)
#   tendril [<alias>] capacity   host capacity report (JSON) over plain SSH
#   tendril [<alias>] link-manifest
#                                the staged Link build's manifest over plain
#                                SSH (read-only; the Link app's update check)
#   tendril [<alias>] health     host health report (JSON) over plain SSH:
#                                Herdr state + tendril/services — the Link
#                                app's failure classifier (contract §6.3)
#   tendril [<alias>] herdr restart
#                                the one safe, VERIFIED revive (contract
#                                §6.1); fixed strings only — stop/start are
#                                host-side verbs and are refused here
#   tendril link                 open the TENDRIL Link app on THIS device
#                                (Termux: am start; LOCAL ONLY — no ssh, no
#                                alias, no args, never a URI from input)
#   tendril --upgrade     refresh the launchers + TENDRIL Link from the host
#                         (typed in Termux: opens the Android installer;
#                         from the Link app - no terminal - it only parks the
#                         verified APK and the app opens the installer)
#   tendril --version     print the launcher build id (tendril-phone <sha12>)
#
# <id> is anything `remote-agents attach`/`enter` resolves on the host: the canonical
# workspace id (w15), a pane id (w15:p1), the workspace number or an exact
# label. Only A-Z a-z 0-9 . _ : - are accepted (max 128 chars), so the id can
# be embedded single-quoted in the mosh/ssh remote command injection-proof.
# The fixed verbs (snapshot, schedule, capacity) validate their arguments
# against their own contract regexes before anything is quoted or dialed.

# The selector's L key ends the remote session with this status: the phone
# launcher launched ssh and turns it into a local
# `am start -n app.tendril.link/.MainActivity`. 75 = EX_TEMPFAIL; ssh
# propagates it, mosh does not — over mosh the request rides a host-side
# file named by this launch's nonce instead (see link_nonce below).
LINK_OPEN_STATUS=75

# Hex in `case` patterns is spelled out ([0123456789abcdef], never a-f):
# bash 3.2 (macOS /bin/sh) matches bracket RANGES by locale collation, so
# in a UTF-8 locale [0-9a-f] also admits A-E.

# ---------- RC2 perf: launch trace + SSH connection reuse ----------------
# Both switches are zero-cost when off: one env test and one stat, then
# the trace helper returns before touching anything.
#
# TRACE: TENDRIL_TRACE=1 or the existence of ~/.config/tendril/trace
# appends one line per stage to ~/.cache/tendril/launch.log:
#     <epoch_ms> <stage> [rc]
# (start, args-validated, preflight-start/-end, transport-chosen-*,
# mosh-exec, ssh-exec, fallback). Verb names only — never a hostname,
# argument or prompt text. The HOST writes the same file name on its own
# side (remote-agents), so both wall-clock logs interleave into one
# timeline (docs/LATENCY.md). 0600, rotated at 64 KB (one .old
# generation). %s%3N is the Termux/GNU ms clock; shells whose date lacks
# %N fall back to plain seconds *1000.
#
# CONNECTION REUSE: every launcher ssh — background verbs AND the
# interactive path, including mosh's bootstrap — multiplexes over one
# control socket per destination (ControlPath ~/, %C is the per-host
# hash; ssh expands the ~ itself, so the option string stays one token
# for `mosh --ssh`). While the Link app polls (snapshot/health, BatchMode
# + ControlPersist=120) a warm master stays up and the next interactive
# open skips the TCP+SSH handshake entirely — measured on OpenSSH 10:
# reuse answers in single-digit ms vs a 160-260 ms handshake, and a
# STALE socket (host rebooted, port changed) is not fatal: with
# ControlMaster=auto the client falls back to a direct connection.
# Interactive sessions REUSE a master but never linger: no ControlPersist,
# so nothing keeps running after the selector closes. ControlPersist
# stays BatchMode-only on purpose — background polling is exactly the
# 'handoff is imminent' signal, and it owns the warm socket.
_t_trace=""
if [ "${TENDRIL_TRACE:-}" = "1" ] || [ -e "$HOME/.config/tendril/trace" ]; then
    _t_trace=1
fi

_t_log() {
    # _t_log <stage> [rc] — one line, best effort, never fatal.
    [ -n "${_t_trace:-}" ] || return 0
    _t_d="$HOME/.cache/tendril"
    _t_f="$_t_d/launch.log"
    if [ ! -d "$_t_d" ]; then
        (umask 077 && mkdir -p "$_t_d") || return 0
    fi
    if [ ! -f "$_t_f" ]; then
        (umask 077 && : > "$_t_f") || return 0
        chmod 0600 "$_t_f" 2>/dev/null
    elif [ "$(wc -c <"$_t_f" 2>/dev/null || echo 0)" -ge 65536 ]; then
        mv -f "$_t_f" "$_t_f.old" 2>/dev/null
    fi
    _t_ms=$(date +%s%3N 2>/dev/null)
    case "${_t_ms:-}" in
        "" | *[!0-9]*) _t_ms="$(date +%s 2>/dev/null)000" ;;
    esac
    printf '%s %s%s\n' "${_t_ms:-0}" "$1" "${2:+ $2}" >> "$_t_f" 2>/dev/null
}
_t_log start

# $HOME/.ssh must exist for the control socket (0700 if WE create it; an
# existing directory is never touched, and the user's ~/.ssh/config is
# never read or edited by any of this).
CM_OPTS=""
if [ -d "$HOME/.ssh" ] || { (umask 077 && mkdir -p "$HOME/.ssh") 2>/dev/null; }; then
    CM_OPTS="-o ControlMaster=auto -o ControlPath=~/.ssh/tendril-cm-%C"
fi
# BatchMode verbs (snapshot/schedule/capacity/health/herdr/upgrade/probe):
# reuse masters AND leave one warm for 120 s.
BATCH_CM_OPTS="$CM_OPTS -o ControlPersist=120 -o ConnectionAttempts=1"
# Interactive/plain verbs: reuse a warm master, create none that lingers.
# ConnectionAttempts=1 + ConnectTimeout=6 keep failure detection bounded
# on the transport itself (the old preflight's job, moved onto the one
# handshake we actually make) without stacking a second handshake.
SESSION_CM_OPTS="$CM_OPTS -o ConnectionAttempts=1 -o ConnectTimeout=6"

# open_link_app - launch TENDRIL Link on THIS device. Fixed component from
# the contract; no input ever reaches the intent (LINK-CONTRACT-0.2 §4).
open_link_app() {
    _am=""
    if command -v am >/dev/null 2>&1; then
        _am="am"
    elif command -v termux-am >/dev/null 2>&1; then
        _am="termux-am"
    fi
    if [ -z "$_am" ]; then
        echo "[tendril] 'am' not found - open TENDRIL Link from the home screen (or: pkg install termux-tools)."
        return 1
    fi
    "$_am" start -n app.tendril.link/.MainActivity
}

# link_nonce - 16 lowercase hex from /dev/urandom (empty when unavailable).
# Names THIS launch's link-open request on the host: the selector writes
# it on L, the post-mosh consume reads + removes exactly that one, so no
# request can ever outlive its own session or open the app after a Q.
link_nonce() {
    _ln=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
    case "$_ln" in
        *[!0123456789abcdef]* | "") return 0 ;;
    esac
    [ "${#_ln}" -eq 16 ] && printf '%s' "$_ln"
    return 0
}

# enroll_phone <user@host> <ntfy-url> <topic> <secret> <fp|-> - first-time
# pairing (v0.2.1), run by TENDRIL Link after it scans the host's QR. Never
# typed by hand. Pins the host key from the QR, writes the alias, publishes
# this phone's PUBLIC key with a proof of the one-time secret, then waits
# until the host has installed it. Last line: `ENROLL ok` or `ENROLL <why>`.
enroll_fail() { echo "ENROLL $1"; [ -n "${2:-}" ] && echo "[tendril] $2" >&2; exit "$3"; }
enroll_phone() {
    _e_target=$1 _e_url=$2 _e_topic=$3 _e_secret=$4 _e_fp=$5
    LC_ALL=C; export LC_ALL
    printf '%s' "$_e_target" | grep -qE '^[A-Za-z0-9._-]{1,64}@[A-Za-z0-9._-]{1,253}$' \
        || enroll_fail usage "bad ssh target" 2
    printf '%s' "$_e_url" | grep -qE '^https?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?$' \
        || enroll_fail usage "bad notification server url" 2
    printf '%s' "$_e_topic" | grep -qE '^tendril-enroll-[A-Za-z0-9_-]{16,48}$' \
        || enroll_fail usage "bad enrollment topic" 2
    printf '%s' "$_e_secret" | grep -qE '^[A-Za-z0-9_-]{24,64}$' \
        || enroll_fail usage "bad enrollment secret" 2
    [ "$_e_fp" = "-" ] || printf '%s' "$_e_fp" | grep -qE '^SHA256:[A-Za-z0-9+/]{43}$' \
        || enroll_fail usage "bad host key fingerprint" 2
    command -v ssh >/dev/null 2>&1 && command -v ssh-keygen >/dev/null 2>&1 \
        || enroll_fail openssh "openssh is missing - run the TENDRIL phone setup again" 3
    _e_host=${_e_target#*@}
    (umask 077 && mkdir -p "$HOME/.ssh") || enroll_fail ssh-dir "cannot create ~/.ssh" 3
    if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
        ssh-keygen -q -t ed25519 -N '' -C termux -f "$HOME/.ssh/id_ed25519" </dev/null \
            || enroll_fail keygen "could not create an SSH key" 3
    fi
    _e_known="-o StrictHostKeyChecking=yes"
    if [ "$_e_fp" = "-" ]; then
        _e_known="-o StrictHostKeyChecking=accept-new"   # host has no ed25519 key
    else
        _e_line=$(ssh-keyscan -t ed25519 -T 6 "$_e_host" 2>/dev/null | grep -v '^#' | head -n 1)
        [ -n "$_e_line" ] || enroll_fail unreachable \
            "cannot reach $_e_host - is Tailscale connected on this phone?" 4
        _e_got=$(printf '%s\n' "$_e_line" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
        [ "$_e_got" = "$_e_fp" ] || enroll_fail hostkey \
            "$_e_host presented a different host key than the pairing QR - refusing" 5
        # the QR is the authority: drop any stale entry, pin the verified key
        ssh-keygen -R "$_e_host" >/dev/null 2>&1
        printf '%s\n' "$_e_line" >> "$HOME/.ssh/known_hosts"
        chmod 600 "$HOME/.ssh/known_hosts" 2>/dev/null
    fi
    mkdir -p "$HOME/.config/tendril" || enroll_fail alias "cannot create ~/.config/tendril" 3
    printf '%s\n' "$_e_target" > "$HOME/.config/tendril/alias.new.$$" \
        && mv -f "$HOME/.config/tendril/alias.new.$$" "$HOME/.config/tendril/alias" \
        || enroll_fail alias "cannot write ~/.config/tendril/alias" 3
    # shellcheck disable=SC2086  # _e_known is a fixed option pair
    if ssh -o BatchMode=yes -o ConnectTimeout=6 $_e_known "$_e_target" true 2>/dev/null; then
        echo "ENROLL ok"; return 0            # already enrolled: nothing to publish
    fi
    _e_pub=$(cat "$HOME/.ssh/id_ed25519.pub" 2>/dev/null)
    _e_type=$(printf '%s' "$_e_pub" | awk '{print $1}')
    _e_b64=$(printf '%s' "$_e_pub" | awk '{print $2}')
    [ "$_e_type" = "ssh-ed25519" ] && [ -n "$_e_b64" ] \
        || enroll_fail keygen "the phone key id_ed25519.pub is not an ed25519 key" 3
    _e_label=$(getprop ro.product.model 2>/dev/null | tr -c 'A-Za-z0-9._-' '-' | cut -c1-32)
    _e_label=${_e_label%-}
    [ -n "$_e_label" ] || _e_label=termux
    # portable hasher: Termux has sha256sum, macOS ships only shasum
    if command -v sha256sum >/dev/null 2>&1; then
        _e_hash="sha256sum"
    elif command -v shasum >/dev/null 2>&1; then
        _e_hash="shasum -a 256"
    else
        enroll_fail hash "no sha256 tool found - install coreutils (or shasum)" 3
    fi
    _e_proof=$(printf '%s\n%s %s' "$_e_secret" "$_e_type" "$_e_b64" | $_e_hash | cut -d ' ' -f1)
    curl -fsS --max-time 15 -o /dev/null \
        -d "tendril-enroll-1 $_e_type $_e_b64 $_e_label $_e_proof" "$_e_url/$_e_topic" \
        || enroll_fail notify "could not reach the notification server $_e_url" 6
    _e_n=0
    while [ "$_e_n" -lt 45 ]; do          # ~90 s: the --pair waiter (2 s) or the guardian (30 s)
        sleep 2
        # shellcheck disable=SC2086
        if ssh -o BatchMode=yes -o ConnectTimeout=6 $_e_known "$_e_target" true 2>/dev/null; then
            echo "ENROLL ok"; return 0
        fi
        _e_n=$((_e_n + 1))
    done
    enroll_fail waiting "the host did not accept this phone - is the pairing QR still on screen? (tendril --pair)" 7
}

# install_phone - `tendril install` in Termux (v0.2.1): THE phone install /
# repair / update command. A phone that knows its host takes the installer
# from THAT host's own staged snapshot (`ssh <alias> remote-agents
# --phone-script setup` - the same auditable script --upgrade runs): the
# launchers, deep links, alias, the verified release-signed TENDRIL Link
# APK and Android's installer, always in step with the release the host
# actually runs, published or not. Only a phone with no host yet falls
# back to the public bootstrap: ONE NAMED FILE on GitHub raw - a raw
# DIRECTORY URL (ending in /phone) is always a 404 and is never
# constructed here (tests/test_phone_install.py pins that forever).
# Idempotent: re-running refreshes what moved and skips what is current.
install_phone() {
    case "${PREFIX:-}" in
        */com.termux/*) ;;
        *)
            echo "[tendril] 'tendril install' here sets up an Android phone and runs in Termux."
            echo "  On a TENDRIL host:  tendril install   (the host command)"
            echo "  On a Mac client:    ./install --client   (from the TENDRIL checkout)"
            exit 2 ;;
    esac
    _i_tmp="${TMPDIR:-$PREFIX/tmp}/tendril-setup.$$.sh"
    _i_alias=${TENDRIL_ALIAS:-${AGENT_ALIAS:-$CONF_ALIAS}}
    if [ -n "$_i_alias" ]; then
        case $_i_alias in
            -*) echo "[tendril] '$_i_alias' is not an SSH alias (leading '-')"; exit 2 ;;
        esac
        if ! command -v ssh >/dev/null 2>&1; then
            echo "[tendril] ssh is missing - run: pkg install -y openssh mosh, then tendril install again."
            exit 1
        fi
        # HOST FIRST: the paired host is the authority on what this phone
        # should run. Its installer is fetched fully, then run - never a
        # partial stream piped into sh - and GitHub is never consulted
        # behind the host's back.
        if ssh -o BatchMode=yes -o ConnectTimeout=8 "$_i_alias" \
            "remote-agents --phone-script setup" > "$_i_tmp" \
           && [ -s "$_i_tmp" ] && sh -n "$_i_tmp"; then
            sh "$_i_tmp"
            _i_rc=$?
            rm -f "$_i_tmp"
            # Interactive only: Android suppresses activity starts from a
            # background (headless RUN_COMMAND) context anyway.
            if [ "$_i_rc" -eq 0 ] && [ -t 0 ]; then
                open_link_app
            fi
            exit "$_i_rc"
        fi
        rm -f "$_i_tmp"
        echo "[tendril] could not fetch the installer from $_i_alias - is the host up and Tailscale connected?"
        echo "  (a paired phone installs from its host; GitHub is used only before the first pairing)"
        exit 1
    fi
    _i_url="${TENDRIL_RAW:-https://raw.githubusercontent.com/Ozymandes/TENDRIL/${TENDRIL_REF:-main}/phone}/setup.sh"
    if ! curl -fsSL --max-time 60 -o "$_i_tmp" "$_i_url" || ! sh -n "$_i_tmp"; then
        rm -f "$_i_tmp"
        echo "[tendril] could not download the phone installer from $_i_url - is the phone online?"
        exit 1
    fi
    sh "$_i_tmp"
    _i_rc=$?
    rm -f "$_i_tmp"
    exit "$_i_rc"
}

# finish_interactive <rc> - end an interactive session: the selector's Link
# key (LINK_OPEN_STATUS) opens the app here on the phone; every other
# status passes through untouched.
finish_interactive() {
    if [ "$1" -eq "$LINK_OPEN_STATUS" ]; then
        _t_log link-open
        open_link_app
        _t_log link-open-done "$?"
        leave_interactive 0
    fi
    leave_interactive "$1"
}

# launched_as_session_root - true when THIS launcher is the root process
# of its Termux session: TENDRIL Link's session entry (RUN_COMMAND, a new
# foreground session) and the share/URL opener start `tendril enter <id>`
# with no shell underneath, so the parent is the Termux app itself. A
# `tendril` typed at a prompt has a shell as its parent and is untouched.
launched_as_session_root() {
    if [ -z "${TERMUX_VERSION:-}" ]; then
        case "${PREFIX:-}" in */com.termux/*) ;; *) return 1 ;; esac
    fi
    _lr_parent=${TENDRIL_FAKE_PARENT_COMM:-$(cat "/proc/$PPID/comm" 2>/dev/null)}
    case "$_lr_parent" in
        com.termux*) return 0 ;;
    esac
    return 1
}

# leave_interactive <status> - the end of an interactive session (the
# dashboard quit with Q, or L, or the session ended). v0.2.4: a session
# root used to exit into Termux's "[Process completed (code 0) - press
# Enter]" with no shell behind it - Q never reached `~ $`. It now hands
# the session to the user's login shell, so Q lands where a typed
# `tendril` lands. Interactive TTY only; TENDRIL_SHELL_HANDOFF=0 opts out.
leave_interactive() {
    if [ -t 0 ] && [ "${TENDRIL_SHELL_HANDOFF:-1}" != 0 ] && launched_as_session_root; then
        _t_log shell-handoff
        if [ -x "${PREFIX:-}/bin/login" ]; then
            exec "$PREFIX/bin/login"
        fi
        exec "${SHELL:-sh}" -l
    fi
    exit "$1"
}

CONF_ALIAS=""
[ -r "$HOME/.config/tendril/alias" ] && IFS= read -r CONF_ALIAS < "$HOME/.config/tendril/alias"
DEFAULT_ALIAS="${TENDRIL_ALIAS:-${AGENT_ALIAS:-$CONF_ALIAS}}"

# no_alias_help - the shared fail-fast guidance when no SSH alias resolves.
no_alias_help() {
    echo "[tendril] no host alias: TENDRIL_ALIAS is empty and ~/.config/tendril/alias is missing."
    HOSTS=$(awk 'tolower($1)=="host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) printf "%s ", $i }' \
        "$HOME/.ssh/config" 2>/dev/null)
    [ -n "$HOSTS" ] && echo "  hosts in ~/.ssh/config: $HOSTS"
    echo "  connect once:   tendril <alias>"
    echo "  set a default:  echo <alias> > ~/.config/tendril/alias"
    echo "                  (or: echo 'export TENDRIL_ALIAS=<alias>' >> ~/.bashrc)"
    echo "usage: tendril [<alias>] [attach|enter|resolve|focus|link <session-id>|snapshot] | tendril ssh <alias>"
    echo "       tendril [<alias>] [schedule show|cancel <id> | schedule add <payload> | capacity | health | herdr restart | rename <pane> <title|--clear>] | tendril link"
    echo "first time on a phone: tendril install, then scan the host's pairing QR in TENDRIL Link"
}

# --version / --upgrade are flags, never aliases: they are handled before
# $1 becomes an alias, so `tendril --upgrade` can never dial a host whose
# alias is literally "--upgrade".
case "${1:-}" in
    --version)
        if command -v sha256sum >/dev/null 2>&1; then
            printf 'tendril-phone %s\n' \
                "$(sha256sum "$0" 2>/dev/null | cut -d ' ' -f1 | cut -c1-12)"
        elif command -v shasum >/dev/null 2>&1; then
            printf 'tendril-phone %s\n' \
                "$(shasum -a 256 "$0" 2>/dev/null | cut -d ' ' -f1 | cut -c1-12)"
        else
            echo "tendril-phone unknown"
        fi
        # The id above is this LAUNCHER FILE's content revision - the
        # launcher only changes when its script changes, so it stays put
        # across host releases that do not touch it (it is not the host
        # version; `ssh <alias> tendril --version` reads that). What the
        # last upgrade recorded about the LINK APP is known locally:
        _v_meta="$HOME/.config/tendril/link-apk.json"
        if [ -r "$_v_meta" ]; then
            _v_name=$(sed -n 's/.*"versionName": "\([^"]*\)".*/\1/p' "$_v_meta" | head -n 1)
            _v_code=$(sed -n 's/.*"versionCode": "\([0-9]*\)".*/\1/p' "$_v_meta" | head -n 1)
            case "${_v_name:+set}${_v_code:+set}" in
                setset) printf 'link app %s (build %s) - as of the last upgrade\n' \
                            "$_v_name" "$_v_code" ;;
            esac
        fi
        exit 0 ;;
    install)
        [ "$#" -eq 1 ] || { echo "usage: tendril install"; exit 2; }
        install_phone ;;
    enroll)
        [ "$#" -eq 6 ] || { echo "usage: tendril enroll <user@host> <ntfy-url> <topic> <secret> <fp|->"; exit 2; }
        enroll_phone "$2" "$3" "$4" "$5" "$6"
        exit $? ;;
    link)
        # LINK-CONTRACT-0.2 §4: NO args = LOCAL ONLY - fixed component,
        # never a URI built from input, no ssh, no alias. `tendril link
        # <id>` keeps its existing host meaning (the plain-ssh deep-link
        # verb) and is parsed as a normal verb below. Strict: two or more
        # arguments are refused, never reinterpreted as anything else.
        if [ "$#" -eq 1 ]; then
            open_link_app
            exit $?
        fi
        if [ "$#" -gt 2 ]; then
            echo "usage: tendril link [<session-id>]"
            echo "  no argument:  open the TENDRIL Link app on THIS device"
            echo "  <session-id>: print the deep link from the host (A-Z a-z 0-9 . _ : - only, max 128)"
            exit 2
        fi ;;
    --upgrade)
        ALIAS="${TENDRIL_ALIAS:-${AGENT_ALIAS:-$CONF_ALIAS}}"
        if [ -z "$ALIAS" ]; then
            no_alias_help
            exit 1
        fi
        case $ALIAS in
            -*) echo "[tendril] '$ALIAS' is not an SSH alias (leading '-')"; exit 2 ;;
        esac
        _td="$PREFIX/tmp"
        [ -d "$_td" ] || _td="${TMPDIR:-/tmp}"
        UP_TMP=$(mktemp "$_td/tendril-upgrade.XXXXXX" 2>/dev/null) || UP_TMP=""
        if [ -z "$UP_TMP" ]; then
            echo "[tendril] no writable temp dir ($_td) - upgrade aborted."
            exit 1
        fi
        trap 'rm -f "$UP_TMP"' EXIT HUP INT TERM
        # download fully, THEN run: never pipe a partial stream into sh
        # (BatchMode + connection reuse: same warm master as the polling)
        if ssh -o BatchMode=yes $BATCH_CM_OPTS "$ALIAS" \
            "remote-agents --phone-script upgrade" > "$UP_TMP" \
           && [ -s "$UP_TMP" ]; then
            sh "$UP_TMP"
            rc=$?
        else
            echo "[tendril] could not fetch the upgrade script from '$ALIAS' - nothing was changed."
            rc=1
        fi
        exit $rc ;;
esac

ALIAS="${1:-$DEFAULT_ALIAS}"
MODE=""
ATTACH_ID=""
SNAP_ETAG=""
FORCE_SSH=""
if [ "$1" = "ssh" ]; then
    ALIAS="${2:-$DEFAULT_ALIAS}"
    FORCE_SSH=1
else
    case "${1:-}" in
        attach | resolve | focus | link | enter)
            MODE="$1"; ALIAS="$DEFAULT_ALIAS"; ATTACH_ID="${2:-}" ;;
        snapshot)
            { [ "$#" -eq 1 ] || [ "$#" -eq 2 ]; } || { echo "usage: tendril [<alias>] snapshot [etag]"; exit 2; }
            MODE="snapshot"; ALIAS="$DEFAULT_ALIAS"; SNAP_ETAG="${2:-}" ;;
        link-manifest)
            [ "$#" -eq 1 ] || { echo "usage: tendril [<alias>] link-manifest"; exit 2; }
            MODE="link-manifest"; ALIAS="$DEFAULT_ALIAS" ;;
        capacity)
            [ "$#" -eq 1 ] || { echo "usage: tendril [<alias>] capacity"; exit 2; }
            MODE="capacity"; ALIAS="$DEFAULT_ALIAS" ;;
        health)
            [ "$#" -eq 1 ] || { echo "usage: tendril [<alias>] health"; exit 2; }
            MODE="health"; ALIAS="$DEFAULT_ALIAS" ;;
        herdr)
            # contract §6.1: the phone may ask for the verified RESTART
            # only — stop/start are host-user verbs and are refused here.
            if [ "$#" -eq 2 ] && [ "$2" = "restart" ]; then
                MODE="herdr"; ALIAS="$DEFAULT_ALIAS"
            else
                echo "usage: tendril [<alias>] herdr restart"; exit 2
            fi ;;
        schedule)
            { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; } || { echo "usage: tendril [<alias>] schedule show|add|cancel <arg>"; exit 2; }
            MODE="schedule"; ALIAS="$DEFAULT_ALIAS"; SCHED_SUB="${2:-}"; SCHED_ARG="${3:-}" ;;
        rename)
            { [ "$#" -eq 3 ] || [ "$#" -eq 4 ]; } || { echo "usage: tendril [<alias>] rename <pane> <title|--clear>"; exit 2; }
            MODE="rename"; ALIAS="$DEFAULT_ALIAS"; RENAME_PANE="${2:-}"; RENAME_TITLE="${3:-}" ;;
        *)
            case "${2:-}" in
                attach | resolve | focus | link | enter)
                    MODE="$2"; ALIAS="$1"; ATTACH_ID="${3:-}" ;;
                snapshot)
                    { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; } || { echo "usage: tendril [<alias>] snapshot [etag]"; exit 2; }
                    MODE="snapshot"; ALIAS="$1"; SNAP_ETAG="${3:-}" ;;
                link-manifest)
                    [ "$#" -eq 2 ] || { echo "usage: tendril [<alias>] link-manifest"; exit 2; }
                    MODE="link-manifest"; ALIAS="$1" ;;
                capacity)
                    [ "$#" -eq 2 ] || { echo "usage: tendril [<alias>] capacity"; exit 2; }
                    MODE="capacity"; ALIAS="$1" ;;
                health)
                    [ "$#" -eq 2 ] || { echo "usage: tendril [<alias>] health"; exit 2; }
                    MODE="health"; ALIAS="$1" ;;
                herdr)
                    if [ "$#" -eq 3 ] && [ "$3" = "restart" ]; then
                        MODE="herdr"; ALIAS="$1"
                    else
                        echo "usage: tendril [<alias>] herdr restart"; exit 2
                    fi ;;
                schedule)
                    { [ "$#" -eq 3 ] || [ "$#" -eq 4 ]; } || { echo "usage: tendril [<alias>] schedule show|add|cancel <arg>"; exit 2; }
                    MODE="schedule"; ALIAS="$1"; SCHED_SUB="${3:-}"; SCHED_ARG="${4:-}" ;;
                rename)
                    { [ "$#" -eq 4 ] || [ "$#" -eq 5 ]; } || { echo "usage: tendril [<alias>] rename <pane> <title|--clear>"; exit 2; }
                    MODE="rename"; ALIAS="$1"; RENAME_PANE="${3:-}"; RENAME_TITLE="${4:-}" ;;
            esac ;;
    esac
fi
REMOTE_BIN="${REMOTE_AGENTS_BIN:-remote-agents}"   # resolved on the HOST (login shell)
REMOTE_CMD="$REMOTE_BIN"

if [ "$MODE" = "snapshot" ]; then
    # snapshot takes NO session id: a fixed one-word remote command. The
    # optional second argument is the previous document's content etag
    # (D11 freshness): the host answers a tiny not-modified line when the
    # document is unchanged. Regex-validated here, single-quoted there.
    case "$SNAP_ETAG" in
        "") REMOTE_CMD="$REMOTE_BIN snapshot" ;;
        [0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef])
            REMOTE_CMD="$REMOTE_BIN snapshot --if-none-match '$SNAP_ETAG'" ;;
        *) echo "usage: tendril [<alias>] snapshot [etag]   (etag: 16 lowercase hex)"; exit 2 ;;
    esac
elif [ "$MODE" = "link-manifest" ]; then
    # the staged Link build's manifest (v0.2.x update check): read-only,
    # fixed one-word remote command, sh-parsable — the Link app compares
    # the staged versionCode against its own. Nothing is installed.
    REMOTE_CMD="$REMOTE_BIN --phone-manifest"
elif [ "$MODE" = "capacity" ]; then
    # capacity is read-only and takes NO arguments: a fixed remote command.
    REMOTE_CMD="$REMOTE_BIN capacity --json"
elif [ "$MODE" = "health" ]; then
    # health is read-only and takes NO arguments: a fixed remote command
    # (contract §6.1; bounded probes server-side, ≤ 3 s).
    REMOTE_CMD="$REMOTE_BIN health --json"
elif [ "$MODE" = "herdr" ]; then
    # only the verified restart is reachable from the phone (§6.1):
    # fixed strings, no argument of any kind is forwarded.
    REMOTE_CMD="$REMOTE_BIN herdr restart"
elif [ "$MODE" = "schedule" ]; then
    # LINK-CONTRACT-0.2 §4: the sub and its argument are validated against
    # the contract regexes HERE, then single-quoted into the remote command.
    case "$SCHED_SUB" in
        show | cancel)
            case "$SCHED_ARG" in
                t-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef][0123456789abcdef]) ;;
                *)
                    echo "usage: tendril [<alias>] schedule $SCHED_SUB <id>   (id: t-YYYYMMDD-8 lowercase hex)"
                    exit 2 ;;
            esac
            REMOTE_CMD="$REMOTE_BIN schedule $SCHED_SUB '$SCHED_ARG'" ;;
        add)
            case "$SCHED_ARG" in
                "" | *[!A-Za-z0-9_-]*)
                    echo "usage: tendril [<alias>] schedule add <payload>   (1..16384 base64url chars: A-Z a-z 0-9 _ -)"
                    exit 2 ;;
            esac
            if [ "${#SCHED_ARG}" -gt 16384 ]; then
                echo "usage: tendril [<alias>] schedule add <payload>   (1..16384 base64url chars: A-Z a-z 0-9 _ -)"
                exit 2
            fi
            # LINK-CONTRACT-0.2 §7.3: a payload that carries a `target`
            # must match the exact allowed forms BEFORE anything is
            # dialed (pane ids are w<alnum>:p<alnum> — real hosts use
            # base-36-ish suffixes like w9:pB). Decode is best-effort:
            # no base64 on the phone → the host validates alone.
            # base64url drops its '=' padding; older coreutils (Ubuntu's
            # 9.4) refuse unpadded input, so restore it before decoding
            case $((${#SCHED_ARG} % 4)) in
                2) SCHED_B64="$SCHED_ARG==" ;;
                3) SCHED_B64="$SCHED_ARG=" ;;
                *) SCHED_B64="$SCHED_ARG" ;;
            esac
            DECODED=$(printf '%s' "$SCHED_B64" | tr '_-' '/+' \
                | base64 -d 2>/dev/null) || DECODED=""
            if [ -n "$DECODED" ] \
                    && printf '%s' "$DECODED" | grep -q '"target"'; then
                TOBJ=$(printf '%s' "$DECODED" \
                    | grep -oE '"target"[[:space:]]*:[[:space:]]*\{[^}]*\}' \
                    | head -n 1)
                case "$TOBJ" in
                    "" ) BAD_TARGET=1 ;;
                    * ) 
                        printf '%s' "$TOBJ" | grep -qE \
'"target"[[:space:]]*:[[:space:]]*\{[[:space:]]*"kind"[[:space:]]*:[[:space:]]*"new"[[:space:]]*\}|"target"[[:space:]]*:[[:space:]]*\{[[:space:]]*"kind"[[:space:]]*:[[:space:]]*"existing"[[:space:]]*,[[:space:]]*"pane"[[:space:]]*:[[:space:]]*"w[0-9A-Za-z]+:p[0-9A-Za-z]+"[[:space:]]*,[[:space:]]*"harness"[[:space:]]*:[[:space:]]*"[a-z][a-z0-9]*"([[:space:]]*,[[:space:]]*"agent_started_at"[[:space:]]*:[[:space:]]*[0-9]{1,13})?[[:space:]]*\}' \
                            || BAD_TARGET=1 ;;
                esac
                if [ "${BAD_TARGET:-0}" = "1" ]; then
                    echo "usage: tendril [<alias>] schedule add <payload>   (target: new | existing{pane w*:p*, harness, agent_started_at?})"
                    exit 2
                fi
            fi
            REMOTE_CMD="$REMOTE_BIN schedule add '$SCHED_ARG'" ;;
        *)
            echo "usage: tendril [<alias>] schedule show|add|cancel <arg>"
            exit 2 ;;
    esac
elif [ "$MODE" = "rename" ]; then
    # DESIGN-FINAL-POLISH §11: the session's manual label. The pane and the
    # title are validated HERE against the same rules the host enforces
    # (pane w<alnum>:p<alnum>; title 1..48 chars from a printable whitelist
    # — no quote, no control chars), then single-quoted into the remote
    # command. The host re-sanitizes; a stale/unknown pane is refused there.
    # same pane grammar the schedule add-target check uses (contract §7.3):
    # w<alnum>+ : p<alnum>+ — never a bare workspace, never another prefix
    printf '%s' "$RENAME_PANE" | grep -qE '^w[0-9A-Za-z]+:p[0-9A-Za-z]+$' \
        || { echo "usage: tendril [<alias>] rename <pane> <title|--clear>   (pane: w16:pA)"; exit 2; }
    if [ "$RENAME_TITLE" = "--clear" ]; then
        RENAME_ARG="--clear"
    else
        # a single quote would break the host-side quoting; anything a
        # printable-title whitelist rejects is refused here (1..48 chars;
        # the host re-sanitizes: control chars stripped, collapsed, trimmed)
        case "$RENAME_TITLE" in
            "" | *\'*)
                echo "usage: tendril [<alias>] rename <pane> <title|--clear>   (title: 1..48 printable chars, no quotes)"
                exit 2 ;;
        esac
        printf '%s' "$RENAME_TITLE" \
            | grep -qE '^[A-Za-z0-9 .,:!?&+/_#@%-]{1,48}$' \
            || { echo "usage: tendril [<alias>] rename <pane> <title|--clear>   (title: 1..48 printable chars, no quotes)"; exit 2; }
        RENAME_ARG="$RENAME_TITLE"
    fi
    REMOTE_CMD="$REMOTE_BIN rename-session '$RENAME_PANE' '$RENAME_ARG'"
elif [ -n "$MODE" ]; then
    BAD=""
    case "$ATTACH_ID" in
        "" | *[!A-Za-z0-9._:-]*) BAD=1 ;;
    esac
    [ "${#ATTACH_ID}" -le 128 ] || BAD=1
    if [ "$BAD" = "1" ]; then
        echo "usage: tendril [<alias>] $MODE <session-id>"
        echo "  <session-id>: workspace id (w15), pane id (w15:p1), workspace number"
        echo "  or exact label; characters A-Z a-z 0-9 . _ : - only, max 128"
        exit 2
    fi
    REMOTE_CMD="$REMOTE_BIN $MODE '$ATTACH_ID'"
fi

case "$ALIAS" in
    -*) echo "[tendril] '$ALIAS' is not an SSH alias (leading '-')"; exit 2 ;;
esac
if [ -z "$ALIAS" ]; then
    no_alias_help
    exit 1
fi
_t_log args-validated

# resolve/focus/link print a result and exit: one plain SSH round trip.
# snapshot/schedule/capacity are the same shape, but strictly non-interactive:
# BatchMode (never a password prompt mid-probe), a short connect timeout,
# no TTY, no Mosh — the Link app's probe must end in a result, not a
# hanging session. Connection reuse keeps every poll's handshake off the
# critical path (see the RC2 perf block at the top).
case "$MODE" in
    resolve | focus | link)
        _t_log transport-chosen-ssh
        _t_log ssh-exec
        exec ssh $SESSION_CM_OPTS "$ALIAS" "$REMOTE_CMD" ;;
    snapshot | schedule | capacity | health | herdr | rename | link-manifest)
        _t_log transport-chosen-ssh
        _t_log ssh-exec
        exec ssh -o BatchMode=yes -o ConnectTimeout=6 $BATCH_CM_OPTS \
            "$ALIAS" "$REMOTE_CMD" ;;
esac

# ---------- interactive: healthy fast path first -------------------------
# ONE transport invocation before the first byte (RC2 perf): the old
# synchronous `ssh … true` preflight is GONE from the healthy path — it
# was a full second serial handshake (measured 160-260 ms warm, and
# ConnectTimeout=5 turned one dead resolved address into a ~5 s stall).
# The key-auth probe now runs ONLY after a transport failure, and its
# guidance + degraded `exec ssh -t` behavior is preserved: when key auth
# is not set up (detected via the FAILED attempt, never a pre-check) the
# user still gets the first-time hints and a password-capable session
# whose rc propagates (the selector's L key ends the session here; the
# host selector's one-line hint still explains L).
_PROBED=0
key_probe() {
    _t_log preflight-start
    # NOTE: no `if ssh …` here — an `if` with no else branch reports 0
    # when its condition fails, which would swallow the probe's rc.
    ssh -o ConnectTimeout=5 -o BatchMode=yes $BATCH_CM_OPTS \
        "$ALIAS" true 2>/dev/null
    _rc_p=$?
    _t_log preflight-end "$_rc_p"
    return "$_rc_p"
}
key_auth_guidance() {
    echo "[tendril] key-auth check failed for '$ALIAS'."
    echo "  - is Tailscale connected on this device?"
    echo "  - first time? run: ssh $ALIAS   (accept host key, password once)"
    echo "  - then: ssh-copy-id $ALIAS"
    echo "[tendril] attempting interactive SSH anyway..."
}

if [ -z "$FORCE_SSH" ] && command -v mosh >/dev/null 2>&1; then
    # mosh-client does NOT propagate the remote exit status (verified on
    # mosh 1.4.0: `mosh <host> -- sh -c 'exit 42'` still exits 0), so the
    # selector's L key (LINK_OPEN_STATUS) cannot reach finish_interactive
    # over mosh — the host selector prints its own one-line hint in-band
    # instead. A non-zero status HERE is mosh's own failure (client or
    # connection refused), which runs the diagnostic probe once and then
    # falls back to ssh below. The bootstrap reuses a warm master via
    # --ssh (same ControlPath as every other launcher ssh).
    _t_log transport-chosen-mosh
    _t_log mosh-exec
    NONCE=$(link_nonce)
    MOSH_CMD="exec $REMOTE_CMD"
    [ -n "$NONCE" ] && MOSH_CMD="export TENDRIL_LINK_NONCE=$NONCE; $MOSH_CMD"
    # Touch scrolling: Termux only tracks mouse modes 1000/1002 and Mosh
    # forwards just Herdr's 1003, so swipes became arrow keys. Tell the
    # host bridge this client is Termux; it then asks for 1002 instead.
    if [ -n "${TERMUX_VERSION:-}" ] || case "${PREFIX:-}" in */com.termux/*) true ;; *) false ;; esac; then
        MOSH_CMD="export TENDRIL_CLIENT=termux; $MOSH_CMD"
    fi
    if mosh --ssh="ssh $SESSION_CM_OPTS" "$ALIAS" \
        -- sh -lc "$MOSH_CMD"; then
        # mosh drops the selector's exit status, so an L request cannot ride
        # it: the host selector leaves a request named by THIS launch's
        # nonce — consume it with one quick BatchMode ssh and open the app
        # when it was there. No nonce, no request, no consume.
        _t_log mosh-done
        if [ -n "$NONCE" ]; then
            _t_log link-consume
            # v0.2.4: this runs AFTER the dashboard quit, before the prompt
            # returns - it must never hold the user. It used to ride the
            # shared control master (ControlPersist): after a network
            # change the master's TCP is dead while mosh roamed on, a
            # multiplexed request waits on it (ConnectTimeout does not
            # apply), and without -n it swallowed the keys typed meanwhile
            # - Q "did nothing". Now: its own fresh connection, no stdin,
            # 3 s to connect and a hard 4 s ceiling where `timeout` exists.
            _lc_timeout=""
            command -v timeout >/dev/null 2>&1 && _lc_timeout="timeout 4"
            # shellcheck disable=SC2086  # _lc_timeout: empty or two words
            if $_lc_timeout ssh -n -o BatchMode=yes -o ConnectTimeout=3 \
                -o ConnectionAttempts=1 -o ControlMaster=no -o ControlPath=none \
                "$ALIAS" "$REMOTE_BIN --link-open-request $NONCE" 2>/dev/null \
                | grep -q '^open$'; then
                _t_log link-open
                open_link_app
                _t_log link-open-done "$?"
            else
                _t_log link-none
            fi
        fi
        leave_interactive 0
    fi
    _t_log fallback
    _PROBED=1
    if ! key_probe; then
        key_auth_guidance
        exec ssh -t $SESSION_CM_OPTS "$ALIAS" "$REMOTE_CMD"
    fi
    echo "[tendril] mosh failed - falling back to ssh"
fi
_t_log transport-chosen-ssh
_t_log ssh-exec
ssh -t $SESSION_CM_OPTS "$ALIAS" "$REMOTE_CMD"
_rc=$?
if [ "$_rc" -eq 0 ]; then
    finish_interactive 0
fi
# ssh's OWN failure (255: refused, unreachable, auth): one diagnostic
# probe, and the degraded path when key auth is missing. A remote
# command status (anything else, incl. the L key's 75) passes through
# untouched. At most ONE probe per launch.
if [ "$_rc" -eq 255 ] && [ "$_PROBED" -eq 0 ]; then
    if ! key_probe; then
        key_auth_guidance
        exec ssh -t $SESSION_CM_OPTS "$ALIAS" "$REMOTE_CMD"
    fi
fi
finish_interactive "$_rc"

