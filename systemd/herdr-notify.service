[Unit]
Description=Herdr agent state to ntfy push watcher (user-level)
After=network-online.target

[Service]
EnvironmentFile=-%h/.config/remote-agents/service.env
ExecStart=/usr/bin/python3 %h/.local/bin/herdr-notify
Restart=on-failure
RestartSec=5
# The poll loop pings every cycle (POLL_SECONDS=8); a hung process stops
# pinging and systemd SIGABRTs + restarts it within this window.
WatchdogSec=60
# Hardening (§7.4): the watcher reads only ~/.config/remote-agents
# (config + notify.env), talks to the herdr socket under ~/.config/herdr,
# pings the watchdog via $NOTIFY_SOCKET (abstract namespace — not /tmp)
# and posts to ntfy over the network. It never writes shared /tmp state,
# so PrivateTmp is safe and it never needs setuid helpers.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
