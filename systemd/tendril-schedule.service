[Unit]
Description=TENDRIL scheduler tick (contract §3, user-level oneshot)
After=network-online.target

[Service]
EnvironmentFile=-%h/.config/remote-agents/service.env
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/bin/remote-agents schedule tick
# Hardening: NoNewPrivileges — the tick never needs setuid helpers.
# PrivateTmp is safe: herdr's socket lives in ~/.config/herdr and the
# watcher's sd_notify socket is under $XDG_RUNTIME_DIR, neither of which
# private-tmp virtualizes (only /tmp and /var/tmp). ProtectSystem is
# deliberately NOT set — the tick writes ~/.cache/tendril and
# ~/.local/state/tendril.
NoNewPrivileges=true
PrivateTmp=true
